.vscode/**
.vscode-test/**
src/**
.gitignore
.eslintrc.json
tsconfig.json
**/*.map
**/*.ts
# Don't blanket-exclude node_modules — vsce reads `npm ls --omit=dev`
# and packs the production tree on its own. Listing transitive deps
# here is brittle (see PR #75): every upstream change to
# `vscode-languageclient` risks breaking activation again.
