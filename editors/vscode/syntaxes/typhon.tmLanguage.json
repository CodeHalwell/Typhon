{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Typhon",
  "scopeName": "source.typhon",
  "fileTypes": ["ty", "dty"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorators" },
    { "include": "#statement" }
  ],
  "repository": {
    "statement": {
      "patterns": [
        { "include": "#pub-star-reexport" },
        { "include": "#import" },
        { "include": "#class-declaration" },
        { "include": "#newtype-declaration" },
        { "include": "#function-declaration" },
        { "include": "#impl-declaration" },
        { "include": "#interface-declaration" },
        { "include": "#extend-declaration" },
        { "include": "#binding-declaration" },
        { "include": "#type-alias" },
        { "include": "#field-declaration" },
        { "include": "#expression" }
      ]
    },

    "pub-star-reexport": {
      "comment": "`pub *` wildcard re-export marker. Only meaningful at module level inside an `__init__.ty`; the build orchestrator aggregates every direct-sibling module's `pub` names at this marker. Outside `__init__.ty` the marker is a no-op and `tyc::pub_star_outside_init` fires. Recognised at the start of a logical line (after any indent) followed by end-of-line or comment.",
      "match": "^[ \\t]*(pub)[ \\t]+(\\*)(?=[ \\t]*(?:#.*)?$)",
      "captures": {
        "1": { "name": "storage.modifier.pub.typhon" },
        "2": { "name": "keyword.operator.wildcard.typhon" }
      }
    },
    "expression": {
      "comment": "Top-level expression context. Tries type-annotation first so `:` after a word is treated as `name: Type` before `expression-inner` falls back to a plain colon. Inside subscripts (`xs[1:4]`), dict literals (`{k: v}`), and lambda bodies (`lambda x: x+1`) we deliberately switch to `expression-inner`, which omits type-annotation so the colon keeps its real meaning.",
      "patterns": [
        { "include": "#type-annotation" },
        { "include": "#expression-inner" }
      ]
    },

    "expression-inner": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#fstrings" },
        { "include": "#numbers" },
        { "include": "#lambda" },
        { "include": "#keyword-argument" },
        { "include": "#typhon-keywords" },
        { "include": "#checked-cast" },
        { "include": "#python-keywords" },
        { "include": "#control-keywords" },
        { "include": "#operator-keywords" },
        { "include": "#constants" },
        { "include": "#result-types" },
        { "include": "#builtin-types" },
        { "include": "#builtin-functions" },
        { "include": "#try-operator" },
        { "include": "#pipe-operator" },
        { "include": "#operators" },
        { "include": "#subscript" },
        { "include": "#dict-or-set-literal" },
        { "include": "#parens" },
        { "include": "#function-call" },
        { "include": "#identifiers" },
        { "include": "#punctuation" }
      ]
    },

    "parens": {
      "comment": "Balanced `( ... )` in expression contexts: function-call argument lists, parenthesised expressions, tuples. Must run before `#punctuation` so that nested parens inside a parameter list default (e.g. `s: T = Depends(x)`) consume their own `)` rather than letting it terminate the outer parameter-list.",
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.typhon" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.typhon" }
      },
      "patterns": [
        { "include": "#expression-inner" }
      ]
    },

    "subscript": {
      "comment": "`[ ... ]` after a value: subscript, slice, or list literal. Colons inside are slice separators, never type annotations, so we handle `:` explicitly before recursing.",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.section.brackets.begin.typhon" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.end.typhon" }
      },
      "patterns": [
        {
          "name": "keyword.operator.slice.typhon",
          "match": ":"
        },
        { "include": "#expression-inner" }
      ]
    },

    "dict-or-set-literal": {
      "comment": "`{ ... }`: dict, set, dict-comprehension, or set-comprehension. The `:` between a dict key and value is a separator, not a type annotation, so we capture it before falling through to expression-inner.",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.typhon" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.typhon" }
      },
      "patterns": [
        {
          "name": "punctuation.separator.dict.typhon",
          "match": ":"
        },
        { "include": "#expression-inner" }
      ]
    },

    "lambda": {
      "comment": "Lambda head: `lambda params: body`. The trailing `:` is a body separator, NOT a type annotation, so the lambda begin/end consumes the head and ends right at the `:` — the body afterwards is parsed by the surrounding expression context. Param names are only matched when they appear in a real parameter position: immediately after `lambda` or after `,`, and followed by `,`/`=`/`:`. Anything else in the head (default-value expressions like `lambda x=foo(a): ...` or constants like `lambda x=True: ...`) falls through to `#expression-inner` so it gets normal expression scoping rather than being mis-tagged as a parameter.",
      "begin": "\\b(lambda)\\b",
      "beginCaptures": {
        "1": { "name": "storage.type.function.lambda.typhon" }
      },
      "end": "(:)|$|(?=[)\\]}])",
      "endCaptures": {
        "1": { "name": "punctuation.separator.lambda.typhon" }
      },
      "patterns": [
        {
          "match": "(?<=\\blambda|,)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*[,=:])",
          "captures": {
            "1": { "name": "variable.parameter.lambda.typhon" }
          }
        },
        { "include": "#expression-inner" }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.typhon",
          "match": "(#).*$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.typhon" }
          }
        }
      ]
    },

    "decorators": {
      "patterns": [
        {
          "comment": "Typhon-specific decorators (@pure / @memo / @gatherable) get a distinct scope so themes can colour them like the language keywords they really are, rather than as generic library decorators. Pattern matches the standalone keyword name; @pure(memo=True) and @memo(max=128) keep the parenthesised arguments highlighted by the trailing expression include.",
          "name": "meta.decorator.builtin.typhon",
          "begin": "^\\s*(@)\\s*(pure|memo|gatherable)\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.decorator.typhon" },
            "2": { "name": "storage.modifier.decorator.builtin.typhon" }
          },
          "end": "$",
          "patterns": [
            { "include": "#expression" }
          ]
        },
        {
          "name": "meta.decorator.typhon",
          "begin": "^\\s*(@)\\s*([\\p{L}_][\\p{L}\\p{N}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_]*)*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.decorator.typhon" },
            "2": { "name": "entity.name.function.decorator.typhon" }
          },
          "end": "$",
          "patterns": [
            { "include": "#expression" }
          ]
        }
      ]
    },

    "import": {
      "comment": "Whole `import X`, `import X as Y`, `from X.Y import a, b as c, *`, and the `lazy` variants live here. Module paths and imported names take `entity.name.namespace` so themes colour them distinctly instead of bleeding into the plain identifier scope. A separate multi-line form is tried first so that `from X import (\\n  a,\\n  b,\\n)` keeps the import meta-scope and namespace highlighting across continuation lines.",
      "patterns": [
        {
          "name": "meta.import.typhon",
          "begin": "\\b(?:(lazy)\\s+)?(from)\\s+([\\p{L}_][\\p{L}\\p{N}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_]*)*)\\s+(import)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.other.lazy.typhon" },
            "2": { "name": "keyword.control.import.typhon" },
            "3": { "name": "entity.name.namespace.typhon" },
            "4": { "name": "keyword.control.import.typhon" },
            "5": { "name": "punctuation.section.parens.begin.typhon" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "punctuation.section.parens.end.typhon" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "keyword.control.import.typhon",
              "match": "\\b(as)\\b"
            },
            {
              "name": "entity.name.namespace.typhon",
              "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.typhon",
              "match": ","
            }
          ]
        },
        {
          "name": "meta.import.typhon",
          "begin": "\\b(?:(lazy)\\s+)?(from|import)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.other.lazy.typhon" },
            "2": { "name": "keyword.control.import.typhon" }
          },
          "end": "$|(?=#)",
          "patterns": [
            {
              "name": "keyword.control.import.typhon",
              "match": "\\b(import|as|from)\\b"
            },
            {
              "name": "keyword.operator.wildcard.typhon",
              "match": "\\*"
            },
            {
              "name": "entity.name.namespace.typhon",
              "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_]*)*\\b"
            },
            { "include": "#punctuation" }
          ]
        }
      ]
    },

    "class-declaration": {
      "comment": "Matches every supported class form: bare `class Foo`, `pub class Foo`, `plain class Bag`, `class! MyModel` (raw / framework-base marker), `model ApiUser`, `enum Color` (v0.11.0 — sugars over `enum.Enum`), with optional `[T, U]` generics after the name and an optional trailing `frozen` modifier (`class P frozen:` -> dataclass(frozen=True)). Capture group 5 picks up the name; capture group 6 catches the `frozen` keyword. `!` and `frozen` are accepted by the regex but don't combine with `enum` in real source — the compiler rejects those forms.",
      "begin": "\\b(?:(pub)\\s+)?(?:(plain)\\s+)?(class|model|enum)(!)?\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?:\\s+(frozen))?",
      "beginCaptures": {
        "1": { "name": "storage.modifier.pub.typhon" },
        "2": { "name": "storage.modifier.plain.typhon" },
        "3": { "name": "storage.type.class.typhon" },
        "4": { "name": "keyword.operator.raw-class.typhon" },
        "5": { "name": "entity.name.type.class.typhon" },
        "6": { "name": "storage.modifier.frozen.typhon" }
      },
      "end": "(:)|$",
      "endCaptures": {
        "1": { "name": "punctuation.section.class.begin.typhon" }
      },
      "patterns": [
        { "include": "#generic-parameters" },
        { "include": "#expression" }
      ]
    },

    "newtype-declaration": {
      "comment": "`newtype Name = Base` introduces a nominal alias over a primitive. The RHS is a type, so it's parsed in type-expression so `|` reads as a type union and brackets read as typeparameters rather than slice/subscript.",
      "begin": "\\b(newtype)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(=)",
      "beginCaptures": {
        "1": { "name": "storage.type.newtype.typhon" },
        "2": { "name": "entity.name.type.newtype.typhon" },
        "3": { "name": "keyword.operator.assignment.typhon" }
      },
      "end": "$|(?=#)",
      "patterns": [
        { "include": "#type-expression" }
      ]
    },

    "interface-declaration": {
      "begin": "\\b(interface)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.interface.typhon" },
        "2": { "name": "entity.name.type.interface.typhon" }
      },
      "end": "(:)|$",
      "endCaptures": {
        "1": { "name": "punctuation.section.interface.begin.typhon" }
      },
      "patterns": [
        { "include": "#generic-parameters" },
        { "include": "#expression" }
      ]
    },

    "impl-declaration": {
      "comment": "`impl Foo:` or `impl[T] Box[T]:`. The optional `[T, ...]` immediately after `impl` is the impl's own generic parameter list; the `[T]` on the target type is part of the type reference and is handled by the type-expression include.",
      "begin": "\\b(impl)(?:\\s*(\\[)([^\\]]*)(\\]))?\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.impl.typhon" },
        "2": { "name": "punctuation.definition.typeparameters.begin.typhon" },
        "3": { "name": "entity.name.type.parameter.typhon" },
        "4": { "name": "punctuation.definition.typeparameters.end.typhon" },
        "5": { "name": "entity.name.type.class.typhon" }
      },
      "end": "(:)|$",
      "endCaptures": {
        "1": { "name": "punctuation.section.impl.begin.typhon" }
      },
      "patterns": [
        { "include": "#type-expression" }
      ]
    },

    "extend-declaration": {
      "begin": "\\b(extend)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.extend.typhon" },
        "2": { "name": "entity.name.type.class.typhon" }
      },
      "end": "(:)|$",
      "endCaptures": {
        "1": { "name": "punctuation.section.extend.begin.typhon" }
      },
      "patterns": [
        { "include": "#type-expression" }
      ]
    },

    "function-declaration": {
      "comment": "Matches every supported function-definition head: bare `def f`, `async def f`, `pub def f`, `pub async def f`. Capture group 1 is the optional `pub` visibility modifier; group 2 is the optional `async` marker; group 3 is `def`; group 4 is the function name. The `pub` slot does not nest with other modifiers — `def`, unlike `let`, only takes a `pub` prefix today.",
      "begin": "\\b(?:(pub)\\s+)?(?:(async)\\s+)?(def)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.pub.typhon" },
        "2": { "name": "storage.type.function.async.typhon" },
        "3": { "name": "storage.type.function.typhon" },
        "4": { "name": "entity.name.function.typhon" }
      },
      "end": "(:)|$",
      "endCaptures": {
        "1": { "name": "punctuation.section.function.begin.typhon" }
      },
      "patterns": [
        { "include": "#generic-parameters" },
        { "include": "#parameter-list" },
        { "include": "#return-arrow" }
      ]
    },

    "generic-parameters": {
      "comment": "PEP-695 / Typhon generic parameter list: `def foo[T, U](...)`, `class Box[T]:`, `impl[T] Box[T]:`, `type Map[K, V] = dict[K, V]`. Also handles type-var bounds: `def largest[T: int](xs)` — the `:` after a type parameter is a bound separator, and the bound itself is parsed as a type-expression.",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.begin.typhon" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.typeparameters.end.typhon" }
      },
      "patterns": [
        {
          "name": "entity.name.type.parameter.typhon",
          "match": "\\b[A-Z]\\w*\\b"
        },
        {
          "name": "punctuation.separator.bound.typhon",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.typhon",
          "match": ","
        },
        { "include": "#type-expression" }
      ]
    },

    "parameter-list": {
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.parameters.begin.typhon" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.typhon" }
      },
      "patterns": [
        {
          "match": "\\b(self|cls)\\b",
          "name": "variable.language.special.self.typhon"
        },
        {
          "match": "([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=[:=,)])",
          "captures": {
            "1": { "name": "variable.parameter.typhon" }
          }
        },
        { "include": "#expression" }
      ]
    },

    "return-arrow": {
      "comment": "`-> ReturnType` after a function signature. The body is a type, not a general expression, so we feed it through type-expression — that way `Box[U]` gets `typeparameters` scopes rather than the `subscript` scopes used in value expressions.",
      "begin": "->",
      "beginCaptures": {
        "0": { "name": "keyword.operator.return-type.typhon" }
      },
      "end": "(?=:|$)",
      "patterns": [
        { "include": "#nullable-suffix" },
        { "include": "#type-expression" }
      ]
    },

    "binding-declaration": {
      "comment": "Supports the v0.3.0 surface: `pub let X`, `freeze let X`, `pub freeze let X`, `comptime let X`, `lazy let X`, and any pair-wise combo. The leading-modifier slot accepts up to three modifiers so users don't see grammar fall-through on stacked keywords like `pub comptime let`. The name uses `\\p{L}` so Unicode identifiers like `let π` and `let греет` are recognised.\n\nUses begin/end (rather than a plain `match`) so the rule owns the optional `: Type` annotation that follows the name. After `let name`, the `:` is unambiguously a type-annotation separator (no statement-colon collision possible here), so the colon scopes as `punctuation.separator.annotation` and the type runs through `type-expression`. Without this, lowercase non-builtin types like `let now: datetime = ...` fell back to a generic `punctuation.separator.colon` + `variable.other` because the standalone `type-annotation` rule rejects bare lowercase identifiers (to avoid mis-coloring `if cond:` and `case Foo(x):`).",
      "begin": "\\b(?:(pub|freeze|comptime|lazy)\\s+)?(?:(pub|freeze|comptime|lazy)\\s+)?(?:(pub|freeze|comptime|lazy)\\s+)?(let|mut|val|var)\\s+(?:(mut)\\s+)?([\\p{L}_][\\p{L}\\p{N}_]*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.typhon" },
        "2": { "name": "storage.modifier.typhon" },
        "3": { "name": "storage.modifier.typhon" },
        "4": { "name": "storage.type.binding.typhon" },
        "5": { "name": "storage.modifier.mut.typhon" },
        "6": { "name": "variable.other.declaration.typhon" }
      },
      "end": "(?==|$)",
      "patterns": [
        {
          "begin": "(:)",
          "beginCaptures": {
            "1": { "name": "punctuation.separator.annotation.typhon" }
          },
          "end": "(?==|$)",
          "patterns": [
            { "include": "#type-expression" }
          ]
        }
      ]
    },

    "type-alias": {
      "comment": "`type Name = RHS` and `type Name[T, U] = RHS`. RHS is parsed as a type-expression so `|` is a union, `[...]` is typeparameters, and dotted names get their accessor scope.",
      "begin": "\\b(type)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?:\\s*(\\[)([^\\]]*)(\\]))?\\s*(=)",
      "beginCaptures": {
        "1": { "name": "storage.type.alias.typhon" },
        "2": { "name": "entity.name.type.alias.typhon" },
        "3": { "name": "punctuation.definition.typeparameters.begin.typhon" },
        "4": { "name": "entity.name.type.parameter.typhon" },
        "5": { "name": "punctuation.definition.typeparameters.end.typhon" },
        "6": { "name": "keyword.operator.assignment.typhon" }
      },
      "end": "$|(?=#)",
      "patterns": [
        { "include": "#type-expression" }
      ]
    },

    "typhon-keywords": {
      "patterns": [
        {
          "name": "storage.type.binding.typhon",
          "match": "\\b(let|mut|val|var)\\b"
        },
        {
          "name": "storage.modifier.typhon",
          "match": "\\b(comptime|lazy|unsafe|pure|memo|pub|freeze|frozen|plain)\\b"
        },
        {
          "name": "storage.type.newtype.typhon",
          "match": "\\b(newtype)\\b"
        },
        {
          "name": "keyword.control.typhon.typhon",
          "match": "\\b(impl|interface|model|enum|extend|gather|go|guard|with|rescue)\\b"
        }
      ]
    },

    "python-keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.typhon",
          "match": "\\b(return|yield|raise|break|continue|pass|await|async)\\b"
        },
        {
          "name": "keyword.control.conditional.typhon",
          "match": "\\b(if|elif|else|match|case)\\b"
        },
        {
          "name": "keyword.control.loop.typhon",
          "match": "\\b(for|while)\\b"
        },
        {
          "name": "keyword.control.exception.typhon",
          "match": "\\b(try|except|finally)\\b"
        },
        {
          "name": "keyword.control.context.typhon",
          "match": "\\b(with|as)\\b"
        },
        {
          "name": "storage.modifier.typhon",
          "match": "\\b(global|nonlocal|del)\\b"
        },
        {
          "name": "storage.type.function.typhon",
          "match": "\\b(def)\\b"
        },
        {
          "name": "storage.type.class.typhon",
          "match": "\\b(class)\\b"
        }
      ]
    },

    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.typhon",
          "match": "\\b(import|from)\\b"
        }
      ]
    },

    "operator-keywords": {
      "name": "keyword.operator.logical.typhon",
      "match": "\\b(and|or|not|in|is)\\b"
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.typhon",
          "match": "\\b(True|False|None|Ellipsis|NotImplemented|__name__|__file__|__doc__)\\b"
        }
      ]
    },

    "result-types": {
      "patterns": [
        {
          "name": "entity.name.type.result.typhon",
          "match": "\\b(Result|Ok|Err|Option|Some)\\b"
        }
      ]
    },

    "builtin-types": {
      "name": "support.type.typhon",
      "match": "\\b(int|float|str|bool|bytes|list|dict|set|tuple|frozenset|complex|object|type|Any|None|Never|Self|Callable|Iterable|Iterator|Generator|AsyncIterable|AsyncIterator|Sequence|Mapping|MutableMapping|Optional|Union|Literal|Final|ClassVar|Protocol)\\b"
    },

    "builtin-functions": {
      "name": "support.function.builtin.typhon",
      "match": "\\b(print|len|range|abs|min|max|sum|sorted|reversed|enumerate|zip|map|filter|any|all|isinstance|issubclass|hasattr|getattr|setattr|delattr|repr|hash|id|iter|next|open|input|format|chr|ord|hex|oct|bin|round|pow|divmod|env)\\b(?=\\s*\\()"
    },

    "nullable-suffix": {
      "comment": "`T?` in type position. Lookbehind allows word, `]`, `)`, and closing quotes so string forward-references stay nullable (`field: \"Model\"? = None`).",
      "name": "keyword.operator.nullable.typhon",
      "match": "(?<=[\\w\\]\\)\"\\'])\\?"
    },

    "try-operator": {
      "comment": "`expr?` in value position — Result/Option short-circuit. Restricted to expression-shaped contexts so it doesn't double up with `nullable-suffix` inside type-expression.",
      "name": "keyword.operator.try.typhon",
      "match": "(?<=[\\w\\)\\]])\\?(?=\\s*(?:[,;:)\\]\\.]|$|\\s))"
    },

    "pipe-operator": {
      "name": "keyword.operator.pipe.typhon",
      "match": "\\|>"
    },

    "checked-cast": {
      "comment": "`EXPR as! TYPE` — the checked boundary cast (v0.14.0). Matched before the bare `as` context keyword so the whole `as!` reads as one operator.",
      "name": "keyword.operator.checked-cast.typhon",
      "match": "\\bas!"
    },

    "operators": {
      "comment": "Operators ordered by specificity. Multi-char ops are tried before their single-char prefixes so `>>` becomes a shift, not two `>` comparisons; `**` becomes power, not two `*`; `//` becomes floor-div, not two `/`. Augmented assignments come first because they end in `=` and would otherwise be split by `=`.",
      "patterns": [
        {
          "name": "keyword.operator.assignment.augmented.typhon",
          "match": "\\+=|-=|\\*\\*=|\\*=|//=|/=|%=|&=|\\|=|\\^=|>>=|<<=|@="
        },
        {
          "name": "keyword.operator.comparison.typhon",
          "match": "==|!=|<=|>=|<>"
        },
        {
          "name": "keyword.operator.bitwise.typhon",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.typhon",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.assignment.walrus.typhon",
          "match": ":="
        },
        {
          "name": "keyword.operator.assignment.typhon",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.typhon",
          "match": "\\*\\*|//|\\+|-|\\*|/|%|@"
        },
        {
          "name": "keyword.operator.bitwise.typhon",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arrow.typhon",
          "match": "->"
        }
      ]
    },

    "type-annotation": {
      "comment": "Type annotation `: Type`. The lookahead is deliberately narrow: an uppercase identifier, a builtin type name, a dotted lowercase name (`pd.DataFrame`), or a type-shaping punctuation (`[`, `(`, quote, digit, `*`). Plain lowercase identifiers are rejected so that single-line statements like `if cond: return x` and `case Foo(x): bar()` don't get their statement colon mis-scoped as a type annotation, which used to swallow the rest of the line into a type-expression. The trade-off is that ad-hoc lowercase type aliases (`x: my_alias`) lose annotation styling — but those are rare; uppercase-style and builtin types cover essentially all real Typhon code.",
      "begin": "(?<=[\\w\\)\\]])\\s*(:)(?!=)\\s*(?=(?:\\p{Lu}|(?:int|str|float|bool|list|dict|set|tuple|bytes|frozenset|complex|object|type|None|Any|Self|Never|Optional|Union|Literal|Final|ClassVar|Protocol|Callable|Iterable|Iterator|Generator|AsyncIterable|AsyncIterator|Sequence|Mapping|MutableMapping)\\b|[\\p{L}_][\\p{L}\\p{N}_]*\\.|[\\[\\(\"\\'\\d\\*]))",
      "beginCaptures": {
        "1": { "name": "punctuation.separator.annotation.typhon" }
      },
      "end": "(?=[,)\\]=]|$)",
      "patterns": [
        { "include": "#type-expression" }
      ]
    },

    "field-declaration": {
      "comment": "Class/model body fields: an indented identifier directly followed by `: Type`. Typhon requires `let`/`mut` for plain bindings, so this only fires inside class/model bodies where bare `name: Type` appears. Captured separately so themes can colour field names distinctly from generic locals.",
      "match": "^(\\s+)([\\p{Ll}_][\\p{L}\\p{N}_]*)(?=\\s*:\\s*[\\p{L}_\\[\\(\"\\'\\d])",
      "captures": {
        "2": { "name": "variable.other.property.declaration.typhon" }
      }
    },

    "type-expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#constants" },
        { "include": "#result-types" },
        { "include": "#builtin-types" },
        { "include": "#nullable-suffix" },
        {
          "name": "keyword.operator.type.union.typhon",
          "match": "\\|"
        },
        {
          "name": "punctuation.accessor.typhon",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.typhon",
          "match": ","
        },
        {
          "name": "entity.name.type.typhon",
          "match": "\\b[A-Z]\\w*\\b"
        },
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.begin.typhon" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.typhon" }
          },
          "patterns": [
            { "include": "#type-expression" }
          ]
        },
        {
          "begin": "\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.section.parens.begin.typhon" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.section.parens.end.typhon" }
          },
          "patterns": [
            { "include": "#type-expression" }
          ]
        },
        {
          "comment": "Lowercase identifiers in type position — module-qualified stdlib types (`datetime`, `time`, `asyncio`) and user-defined type aliases (`my_alias`). In a type-expression context we know the name is naming a type, so paint it as one instead of falling through to `#identifiers` and getting a plain `variable.other` colour. Builtins (`int`, `str`, `Callable`, …) and uppercase names (`Foo`, `Result`) are caught by earlier patterns and don't reach here.",
          "name": "entity.name.type.typhon",
          "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*\\b"
        }
      ]
    },

    "function-call": {
      "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.typhon" }
      }
    },

    "keyword-argument": {
      "comment": "A keyword/named argument or simple assignment target — an identifier immediately followed by a single `=` (not `==`, and not an augmented `+=`/`-=`/… which carry an operator char before the `=`). Matched in expression context BEFORE `#typhon-keywords` so a kwarg whose name collides with a Typhon soft keyword (`model=`, `enum=`, `with=`, `type=`, `match=`) is scoped as a parameter, not a keyword. Themes that don't style `variable.parameter` fall back to plain text — still better than mis-tagging it as a keyword.",
      "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?==(?!=))",
      "captures": {
        "1": { "name": "variable.parameter.typhon" }
      }
    },

    "identifiers": {
      "comment": "Bare identifiers in expressions. Order: `self`/`cls` first; then ALL_CAPS constants; then PascalCase/uppercase-leading types; then lowercase variables. The lowercase fallback uses `\\p{L}` so Unicode identifiers (`греет`, `π`, `数`) get the regular variable scope instead of falling through to no-scope.",
      "patterns": [
        {
          "name": "variable.language.self.typhon",
          "match": "\\b(self|cls)\\b"
        },
        {
          "name": "variable.other.constant.typhon",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        },
        {
          "name": "entity.name.type.typhon",
          "match": "\\b[A-Z]\\w*\\b"
        },
        {
          "name": "variable.other.typhon",
          "match": "[\\p{L}_][\\p{L}\\p{N}_]*"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.typhon", "match": "," },
        { "name": "punctuation.separator.colon.typhon", "match": ":" },
        { "name": "punctuation.terminator.statement.typhon", "match": ";" },
        { "name": "punctuation.accessor.typhon", "match": "\\." },
        { "name": "punctuation.section.parens.begin.typhon", "match": "\\(" },
        { "name": "punctuation.section.parens.end.typhon", "match": "\\)" },
        { "name": "punctuation.section.brackets.begin.typhon", "match": "\\[" },
        { "name": "punctuation.section.brackets.end.typhon", "match": "\\]" },
        { "name": "punctuation.section.braces.begin.typhon", "match": "\\{" },
        { "name": "punctuation.section.braces.end.typhon", "match": "\\}" }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.complex.typhon",
          "match": "\\b\\d+(?:\\.\\d*)?(?:[eE][+-]?\\d+)?[jJ]\\b"
        },
        {
          "name": "constant.numeric.float.typhon",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+\\b|\\b\\d[\\d_]*\\.(?!\\.)|(?<![\\w.])\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hex.typhon",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.integer.octal.typhon",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.typhon",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.integer.typhon",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },

    "strings": {
      "comment": "Raw strings (`r\"...\"`, `rb\"...\"`, `br\"...\"`) are split out and do NOT include `#string-escapes` — `\\n` inside `r\"\\n\"` is a literal backslash + n, so highlighting it as an escape would be a lie. Regular strings (`\"...\"`, `b\"...\"`, `u\"...\"`) keep escape highlighting.",
      "patterns": [
        {
          "name": "string.quoted.triple.double.raw.typhon",
          "begin": "(?:[bB][rR]|[rR][bB]?)\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.triple.single.raw.typhon",
          "begin": "(?:[bB][rR]|[rR][bB]?)'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.raw.typhon",
          "begin": "(?:[bB][rR]|[rR][bB]?)\"",
          "end": "\"|(?<!\\\\)$"
        },
        {
          "name": "string.quoted.single.raw.typhon",
          "begin": "(?:[bB][rR]|[rR][bB]?)'",
          "end": "'|(?<!\\\\)$"
        },
        {
          "name": "string.quoted.triple.double.typhon",
          "begin": "(?:[bBuU])?\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.triple.single.typhon",
          "begin": "(?:[bBuU])?'''",
          "end": "'''",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.double.typhon",
          "begin": "(?:[bBuU])?\"",
          "end": "\"|(?<!\\\\)$",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.single.typhon",
          "begin": "(?:[bBuU])?'",
          "end": "'|(?<!\\\\)$",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        }
      ]
    },

    "fstrings": {
      "comment": "F-strings, split into raw (`rf\"...\"` / `fr\"...\"`) and regular (`f\"...\"`). Only the regular form includes `#string-escapes`; in raw f-strings `\\n` is literal backslash + n. Both forms include `#fstring-interpolation` for `{expr}` and self-doc `{x=}`.",
      "patterns": [
        {
          "name": "string.quoted.triple.double.fstring.raw.typhon",
          "begin": "(?:[fF][rR]|[rR][fF])\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#fstring-interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple.single.fstring.raw.typhon",
          "begin": "(?:[fF][rR]|[rR][fF])'''",
          "end": "'''",
          "patterns": [
            { "include": "#fstring-interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.fstring.raw.typhon",
          "begin": "(?:[fF][rR]|[rR][fF])\"",
          "end": "\"|(?<!\\\\)$",
          "patterns": [
            { "include": "#fstring-interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.fstring.raw.typhon",
          "begin": "(?:[fF][rR]|[rR][fF])'",
          "end": "'|(?<!\\\\)$",
          "patterns": [
            { "include": "#fstring-interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple.double.fstring.typhon",
          "begin": "[fF]\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#fstring-interpolation" },
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.triple.single.fstring.typhon",
          "begin": "[fF]'''",
          "end": "'''",
          "patterns": [
            { "include": "#fstring-interpolation" },
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.double.fstring.typhon",
          "begin": "[fF]\"",
          "end": "\"|(?<!\\\\)$",
          "patterns": [
            { "include": "#fstring-interpolation" },
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.single.fstring.typhon",
          "begin": "[fF]'",
          "end": "'|(?<!\\\\)$",
          "patterns": [
            { "include": "#fstring-interpolation" },
            { "include": "#string-escapes" }
          ]
        }
      ]
    },

    "fstring-interpolation": {
      "begin": "\\{(?!\\{)",
      "beginCaptures": {
        "0": { "name": "punctuation.section.embedded.begin.typhon" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.typhon" }
      },
      "contentName": "meta.embedded.fstring.typhon",
      "patterns": [
        {
          "name": "storage.type.format.typhon",
          "match": "![rsa]|:[^}]*"
        },
        { "include": "#expression" }
      ]
    },

    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.typhon",
          "match": "\\\\(?:[\\\\'\"abfnrtv0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|N\\{[^}]+\\}|[0-7]{1,3})"
        }
      ]
    }
  }
}
