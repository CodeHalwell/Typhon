/tyc/target/
*.pyc
__pycache__/
.claude/worktrees/

# tyc / uv build artefacts
examples/*/build/
examples/*/pyproject.toml
examples/*/uv.lock
examples/*/.venv/
examples/apps/*/build/
examples/apps/*/pyproject.toml
examples/apps/*/uv.lock
examples/apps/*/.venv/

# stress/ build artefacts (created by stress harnesses, regenerated on demand)
stress/round-*/build/

# Generated stress-test project dirs (contain a heavy .venv)
stress/**/third-party/proj/
stress/round-2026-06-21/proj/

# AI-agent scratch notes live only in lowercase .jules/ — the capitalised
# twin breaks checkout on case-insensitive filesystems (macOS, Windows).
.Jules/
