# `[strictness] auto-parallel = true` rewrites pure-call comprehensions into a
# typhon_runtime.parallel.map_pure thread-pool map. All three shapes alpha.5
# widened to are exercised: the bare map, a pure `if` filter, and a nested pure
# call with a loop-invariant extra argument. Order must be preserved.
@pure
def square(x: int) -> int:
    return x * x


@pure
def offset(x: int, by: int) -> int:
    return x + by


@pure
def keep(x: int) -> bool:
    return x % 2 == 0


def main() -> None:
    let xs: list[int] = [1, 2, 3, 4, 5, 6, 7, 8]
    let ys: list[int] = [square(x) for x in xs]
    print(ys)
    let evens: list[int] = [square(x) for x in xs if keep(x)]
    print(evens)
    let bump: int = 10
    let nested: list[int] = [offset(square(x), bump) for x in xs]
    print(nested)


if __name__ == "__main__":
    main()
