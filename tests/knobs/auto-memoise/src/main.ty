# `[strictness] auto-memoise = true` caches every function the analyser proves
# safe to cache — pure, not recursive, hashable cache-key parameters and an
# immutable result (W3-04) — with a bounded `functools.lru_cache`. The output
# matches the uncached control build, so the rewrite is transparent.
@pure
def score(n: int) -> int:
    return n * n + 3 * n + 1


def main() -> None:
    mut total: int = 0
    for i in range(50):
        total += score(i % 5)
    print(total)
    print(score(0), score(1), score(2))


if __name__ == "__main__":
    main()
