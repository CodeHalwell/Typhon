class Temp:
    celsius: float

impl Temp:
    @classmethod
    def from_fahrenheit(cls, f: float) -> "Temp":
        return Temp(celsius=(f - 32.0) * 5.0 / 9.0)

    @staticmethod
    def absolute_zero() -> float:
        return -273.15

def main() -> None:
    let t: Temp = Temp.from_fahrenheit(100.0)
    print(t.celsius)
    print(Temp.absolute_zero())

main()
