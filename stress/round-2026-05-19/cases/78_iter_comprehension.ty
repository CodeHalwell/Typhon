def main() -> None:
    let pairs: list[tuple[int, int]] = [(i, j) for i in range(3) for j in range(3) if i + j > 2]
    print(pairs)
    let triples: list[tuple[int, int, int]] = [(i, j, k) for i in range(2) for j in range(2) for k in range(2)]
    print(len(triples))
    let set_comp: set[int] = {x % 3 for x in range(10)}
    print(sorted(set_comp))

main()
