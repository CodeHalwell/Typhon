import time

@memo
def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def main() -> None:
    let t0: float = time.perf_counter()
    let v: int = fib(100)
    let t1: float = time.perf_counter()
    print(v)
    # The duration itself is not comparable between `tyc run` and CPython.
    print(f"measured={t1 >= t0}")

if __name__ == "__main__":
    main()
