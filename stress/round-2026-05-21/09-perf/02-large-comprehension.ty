import time

def main() -> None:
    let t0: float = time.perf_counter()
    let xs: list[int] = [i * i for i in range(1_000_000) if i % 3 == 0]
    let total: int = sum(xs)
    let t1: float = time.perf_counter()
    print(total)
    print(f"elapsed {(t1 - t0) * 1000:.1f} ms")

if __name__ == "__main__":
    main()
