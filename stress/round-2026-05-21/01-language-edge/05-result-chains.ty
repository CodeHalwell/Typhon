def parse_int(s: str) -> Result[int, str]:
    if not s.isdigit():
        return Err(f"not a number: {s}")
    return Ok(int(s))

def positive(n: int) -> Result[int, str]:
    if n <= 0:
        return Err(f"not positive: {n}")
    return Ok(n)

def under_100(n: int) -> Result[int, str]:
    if n >= 100:
        return Err(f"too large: {n}")
    return Ok(n)

def pipeline(raw: str) -> Result[int, str]:
    let n: int = parse_int(raw)?
    let p: int = positive(n)?
    let s: int = under_100(p)?
    return Ok(s * 2)

def with_chain(raw: str) -> Result[int, str]:
    with n = parse_int(raw)?, p = positive(n)?, s = under_100(p)?:
        return Ok(s * 2)
    else err:
        return Err(f"chain failed: {err}")

def main() -> None:
    for s in ["10", "abc", "-5", "200", "42"]:
        print(s, "=>", pipeline(s))
        print(s, "=>", with_chain(s))

if __name__ == "__main__":
    main()
