extend str:
    def shout(self) -> str:
        return self.upper() + "!"

    def repeat_n(self, n: int) -> str:
        return self * n

extend list:
    def total_int(self) -> int:
        mut s: int = 0
        for x in self:
            s = s + int(x)
        return s

def main() -> None:
    let s: str = "hello"
    print(s.shout())
    print(s.repeat_n(3))

    let xs: list[int] = [1, 2, 3, 4]
    print(xs.total_int())

if __name__ == "__main__":
    main()
