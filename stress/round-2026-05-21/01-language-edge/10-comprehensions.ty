def main() -> None:
    let squares: list[int] = [n * n for n in range(10)]
    print(squares)

    let evens: list[int] = [n for n in range(20) if n % 2 == 0]
    print(evens)

    let pairs: list[tuple[int, int]] = [(i, j) for i in range(3) for j in range(3) if i != j]
    print(pairs)

    let mp: dict[str, int] = {f"k{i}": i * i for i in range(5)}
    print(mp)

    let ss: set[int] = {n % 5 for n in range(20)}
    print(sorted(ss))

    let total: int = sum(x for x in range(100) if x % 3 == 0)
    print(total)

if __name__ == "__main__":
    main()
