@memo
def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

@pure
def add(a: int, b: int) -> int:
    return a + b

@pure(memo=True)
def hash_pair(a: int, b: int) -> int:
    return (a * 7919) ^ (b * 104729)

def main() -> None:
    print(fib(30))
    print(add(2, 3))
    print(hash_pair(1, 2))
    print(hash_pair(1, 2))

if __name__ == "__main__":
    main()
