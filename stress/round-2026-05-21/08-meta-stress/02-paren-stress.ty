def main() -> None:
    let s: str = ("a" + "b").upper()
    print(s)

    let b: bool = (True or False) and False
    print(b)

    let t: tuple[int, int] = (1, 2)
    let v: int = (t[0] + t[1]) * 10
    print(v)

    let xs: list[int] = [(1 + 2) * 3, (4 - 5) * 6]
    print(xs)

    let n: int = -(3 + 4)
    print(n)

    let m: int = ~(0 | 1)
    print(m)

    let p: int = (1 << 4) + (1 << 2)
    print(p)

    let q: str = ((("nested" + " ") + "parens") + "!").upper()
    print(q)

if __name__ == "__main__":
    main()
