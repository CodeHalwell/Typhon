import asyncio
import time

class RateLimiter:
    capacity: int
    tokens: float
    rate_per_sec: float
    last: float

impl RateLimiter:
    def acquire(self) -> float:
        let now: float = time.monotonic()
        let elapsed: float = now - self.last
        let refill: float = elapsed * self.rate_per_sec
        self.tokens = min(float(self.capacity), self.tokens + refill)
        self.last = now
        if self.tokens >= 1.0:
            self.tokens = self.tokens - 1.0
            return 0.0
        let needed: float = 1.0 - self.tokens
        return needed / self.rate_per_sec

async def call(rl: RateLimiter, id: int) -> str:
    let wait: float = rl.acquire()
    if wait > 0.0:
        await asyncio.sleep(wait)
    return f"call-{id} at {time.monotonic():.3f}"

async def main() -> None:
    let rl: RateLimiter = RateLimiter(capacity=2, tokens=2.0, rate_per_sec=5.0, last=time.monotonic())
    let results: list[str] = []
    mut coros: list[object] = []
    for i in range(6):
        coros.append(call(rl, i))
    unsafe:
        let gathered: list[str] = await asyncio.gather(*coros)
    for r in gathered:
        print(r)

if __name__ == "__main__":
    asyncio.run(main())
