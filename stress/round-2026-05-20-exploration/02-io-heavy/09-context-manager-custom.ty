import time

class Timer:
    name: str
    start: float
    elapsed: float

impl Timer:
    def __enter__(self) -> Timer:
        self.start = time.monotonic()
        return self
    def __exit__(self, et: object, ev: object, tb: object) -> None:
        self.elapsed = time.monotonic() - self.start
        # Report that the measurement happened, not the wall-clock number.
        # `tyc run` and `tyc build` + CPython legitimately take different
        # amounts of time, so printing the duration makes this unit's stdout
        # incomparable between the two surfaces — and at `.3f` seconds the
        # value is coarse enough that each side often repeats itself, which
        # slips past the differential harness's self-nondeterminism filter
        # and reports a spurious divergence.
        print(f"{self.name}: measured={self.elapsed >= 0.0}")

def main() -> None:
    with Timer(name="loop", start=0.0, elapsed=0.0) as t:
        mut acc: int = 0
        for i in range(100000):
            acc = acc + i
        print(f"acc={acc}")

if __name__ == "__main__":
    main()
