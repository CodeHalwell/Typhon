import sqlite3
import tempfile
import os

class Person:
    id: int
    name: str
    age: int

def setup(conn: sqlite3.Connection) -> None:
    conn.execute("CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT, age INT)")
    conn.executemany("INSERT INTO people (name, age) VALUES (?, ?)", [
        ("alice", 30), ("bob", 25), ("carol", 40),
    ])
    conn.commit()

def find_older_than(conn: sqlite3.Connection, age: int) -> list[Person]:
    let cur: sqlite3.Cursor = conn.execute("SELECT id, name, age FROM people WHERE age > ?", (age,))
    mut out: list[Person] = []
    for row in cur.fetchall():
        unsafe:
            let p: Person = Person(id=row[0], name=row[1], age=row[2])
        out.append(p)
    return out

def main() -> None:
    let tmp: str = tempfile.mktemp(suffix=".db")
    let conn: sqlite3.Connection = sqlite3.connect(tmp)
    setup(conn)
    let people: list[Person] = find_older_than(conn, 28)
    print(f"found {len(people)}:")
    for p in people:
        print(f"  {p.name} ({p.age})")
    conn.close()
    os.remove(tmp)

if __name__ == "__main__":
    main()
