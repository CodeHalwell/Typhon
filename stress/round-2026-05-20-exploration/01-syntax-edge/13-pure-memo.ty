@pure
def normalise(s: str) -> str:
    return s.strip().lower()

@memo
def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

@pure(memo=True)
def square(n: int) -> int:
    return n * n

def main() -> None:
    print(normalise("  HELLO  "))
    print(fib(20))
    print(square(7))

if __name__ == "__main__":
    main()
