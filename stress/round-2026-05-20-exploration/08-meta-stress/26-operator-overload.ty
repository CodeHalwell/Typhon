class V:
    n: int

impl V:
    def __add__(self, other: V) -> V:
        return V(n=self.n + other.n)
    def __mul__(self, scalar: int) -> V:
        return V(n=self.n * scalar)
    def __eq__(self, other: V) -> bool:
        return self.n == other.n

def main() -> None:
    let a: V = V(n=3)
    let b: V = V(n=5)
    # Test each operator
    let s: V = a + b
    print(f"s.n={s.n}")
    let m: V = a * 4
    print(f"m.n={m.n}")
    let e: bool = a == b
    print(f"e={e}")

if __name__ == "__main__":
    main()
