# Probe: impl block + async method + match with all-arms-returning.
import asyncio


type Status = Open | Closed


class Open:
    since: float
class Closed:
    label: str


class Foo:
    cooldown: float


impl Foo:
    async def check(self, s: Status, now: float) -> str:
        match s:
            case Open(since):
                if now - since >= self.cooldown:
                    return "ready"
                return "still-cooling"
            case Closed(label):
                return f"closed: {label}"


async def main_async() -> None:
    let f: Foo = Foo(cooldown=0.5)
    print(await f.check(Open(since=0.0), 1.0))
    print(await f.check(Open(since=0.0), 0.1))
    print(await f.check(Closed(label="ok"), 0.0))


def main() -> None:
    asyncio.run(main_async())


if __name__ == "__main__":
    main()
