# ML test: linear regression with gradient descent.
import numpy as np


class LinearRegression:
    lr: float
    epochs: int
    weights: np.ndarray
    bias: float
    history: list[float]


impl LinearRegression:
    def fit(self, X: np.ndarray, y: np.ndarray) -> None:
        let n_samples: int = X.shape[0]
        let n_features: int = X.shape[1]
        self.weights = np.zeros(n_features)
        self.bias = 0.0
        self.history = []
        for _ in range(self.epochs):
            let y_pred: np.ndarray = X @ self.weights + self.bias
            let err: np.ndarray = y_pred - y
            let dw: np.ndarray = (1.0 / n_samples) * (X.T @ err)
            let db: float = float((1.0 / n_samples) * err.sum())
            self.weights = self.weights - self.lr * dw
            self.bias = self.bias - self.lr * db
            let loss: float = float((err * err).mean())
            self.history.append(loss)

    def predict(self, X: np.ndarray) -> np.ndarray:
        return X @ self.weights + self.bias


def main() -> None:
    let rng = np.random.default_rng(0)
    let n: int = 100
    let X: np.ndarray = rng.uniform(-1, 1, (n, 2))
    # True relationship: y = 3 * x0 - 2 * x1 + 0.5
    let y: np.ndarray = 3.0 * X[:, 0] - 2.0 * X[:, 1] + 0.5 + 0.01 * rng.normal(size=n)
    let model: LinearRegression = LinearRegression(lr=0.05, epochs=500, weights=np.array([]), bias=0.0, history=[])
    model.fit(X, y)
    print(f"learned weights = {np.round(model.weights, 3)}")
    print(f"learned bias    = {round(model.bias, 3)}")
    print(f"first loss = {model.history[0]:.4f}, last loss = {model.history[-1]:.6f}")


if __name__ == "__main__":
    main()
