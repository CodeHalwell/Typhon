# Meta-stress: numeric edge cases that often trip emitters.

def t1() -> int:
    # 2 ** 10 ** 2 — right-assoc → 2 ** 100
    return 2 ** 10 ** 2


def t2() -> int:
    # (2 ** 10) ** 2 — left-assoc explicit → 1024 ** 2 = 1048576
    return (2 ** 10) ** 2


def t3() -> int:
    # -2 ** 2 — Python parses as -(2 ** 2) = -4
    return -2 ** 2


def t4() -> int:
    # (-2) ** 2 = 4
    return (-2) ** 2


def t5() -> int:
    return -(-2)


def t6() -> int:
    # divmod-style negative-int floor div
    return -7 // 2


def t7() -> float:
    return -3.0 ** 2.0


def main() -> None:
    print(f"t1: {t1()}    expect 2**100")  # 1267650600228229401496703205376
    print(f"t2: {t2()}    expect 1048576")
    print(f"t3: {t3()}    expect -4")
    print(f"t4: {t4()}    expect 4")
    print(f"t5: {t5()}    expect 2")
    print(f"t6: {t6()}    expect -4")
    print(f"t7: {t7()}    expect -9.0")


if __name__ == "__main__":
    main()
