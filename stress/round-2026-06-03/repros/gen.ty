from typing import Iterator
def count_up(n: int) -> Iterator[int]:
    mut i: int = 0
    while i < n:
        yield i
        i = i + 1
def main() -> None:
    for x in count_up(4):
        print(x)
    let squares: list[int] = [x*x for x in count_up(5)]
    print(squares)
if __name__ == "__main__":
    main()
