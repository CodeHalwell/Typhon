from enum import Enum

class Color(Enum):
    RED = 1
    GREEN = 2
    BLUE = 3

def main() -> None:
    print(Color.RED)
    print(Color.RED.value)
    print(Color.RED == Color.RED)
    print(Color.RED == Color.BLUE)
    for c in Color:
        print(c.name, c.value)
if __name__ == "__main__":
    main()
