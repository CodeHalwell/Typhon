from abc import ABC, abstractmethod

class Shape(ABC):
    @abstractmethod
    def area(self) -> float:
        ...

class Circle(Shape):
    radius: float

impl Circle:
    def area(self) -> float:
        return 3.14159 * self.radius * self.radius

class Square(Shape):
    side: float

impl Square:
    def area(self) -> float:
        return self.side * self.side

def main() -> None:
    let shapes: list[Shape] = [Circle(radius=2.0), Square(side=3.0)]
    for s in shapes:
        print(round(s.area(), 2))

if __name__ == "__main__":
    main()
