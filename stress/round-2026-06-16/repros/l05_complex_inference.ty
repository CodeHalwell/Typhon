from typing import Callable

def compose[A, B, C](f: Callable[[B], C], g: Callable[[A], B]) -> Callable[[A], C]:
    def composed(x: A) -> C:
        return f(g(x))
    return composed

def pipe[T](value: T, *fns: Callable[[T], T]) -> T:
    mut result: T = value
    for fn in fns:
        result = fn(result)
    return result

def main() -> None:
    let add_one: Callable[[int], int] = lambda x: x + 1
    let double: Callable[[int], int] = lambda x: x * 2
    let combined: Callable[[int], int] = compose(double, add_one)
    print(combined(5))
    print(pipe(3, add_one, double, add_one))

if __name__ == "__main__":
    main()
