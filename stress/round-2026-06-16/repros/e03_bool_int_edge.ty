def main() -> None:
    print(True + True + False)
    print(sum([True, False, True, True]))
    print(int(True), int(False))
    print(2 ** 10, 10 // 3, 10 % 3, -7 // 2, -7 % 2)
    print(0.1 + 0.2)
    print(1 / 3)
    print(7 / 2)
    print(abs(-5), abs(-5.5))
    print(max(3, 7, 1), min([4, 2, 9]))
    print(bin(10), hex(255), oct(8))
    print(ord("A"), chr(66))
    print(round(2.5), round(3.5), round(2.675, 2))

if __name__ == "__main__":
    main()
