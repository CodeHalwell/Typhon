def main() -> None:
    let graph: dict[frozenset[int], int] = {
        frozenset([1, 2]): 10,
        frozenset([2, 3]): 20,
        frozenset([1, 3]): 30,
    }
    print(graph[frozenset([2, 1])])
    let edges: set[frozenset[int]] = {frozenset([1, 2]), frozenset([2, 1]), frozenset([3, 4])}
    print(len(edges))
    for edge in sorted(edges, key=lambda e: sorted(e)):
        print(sorted(edge))

if __name__ == "__main__":
    main()
