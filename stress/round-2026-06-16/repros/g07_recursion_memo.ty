@memo
def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def ackermann(m: int, n: int) -> int:
    if m == 0:
        return n + 1
    if n == 0:
        return ackermann(m - 1, 1)
    return ackermann(m - 1, ackermann(m, n - 1))

def main() -> None:
    print(fib(30))
    print([fib(i) for i in range(10)])
    print(ackermann(2, 3))

if __name__ == "__main__":
    main()
