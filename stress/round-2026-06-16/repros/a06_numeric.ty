import math
from fractions import Fraction
from decimal import Decimal

def main() -> None:
    print(math.gcd(48, 36))
    print(math.factorial(6))
    print(round(math.pi, 4))
    let f: Fraction = Fraction(1, 3) + Fraction(1, 6)
    print(f)
    let d: Decimal = Decimal("0.1") + Decimal("0.2")
    print(d)
    print(2 ** 64)
    print(divmod(17, 5))

if __name__ == "__main__":
    main()
