class Point frozen:
    x: int
    y: int

def main() -> None:
    let p1: Point = Point(x=1, y=2)
    let p2: Point = Point(x=1, y=2)
    let p3: Point = Point(x=3, y=4)
    print(p1 == p2)
    print(p1 == p3)
    let points: set[Point] = {p1, p2, p3}
    print(len(points))
    let d: dict[Point, str] = {p1: "a", p3: "b"}
    print(d[Point(x=1, y=2)])
    print(p1)

if __name__ == "__main__":
    main()
