class TreeNode:
    value: int
    children: list[TreeNode]

impl TreeNode:
    def total(self) -> int:
        mut sum: int = self.value
        for child in self.children:
            sum = sum + child.total()
        return sum
    def depth(self) -> int:
        if len(self.children) == 0:
            return 1
        mut max_child: int = 0
        for child in self.children:
            let d: int = child.depth()
            if d > max_child:
                max_child = d
        return 1 + max_child

def main() -> None:
    let leaf1: TreeNode = TreeNode(value=1, children=[])
    let leaf2: TreeNode = TreeNode(value=2, children=[])
    let mid: TreeNode = TreeNode(value=3, children=[leaf1, leaf2])
    let root: TreeNode = TreeNode(value=4, children=[mid])
    print(root.total())
    print(root.depth())

if __name__ == "__main__":
    main()
