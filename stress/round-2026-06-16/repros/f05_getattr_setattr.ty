class Dynamic:
    data: dict[str, int]

impl Dynamic:
    def __getitem__(self, key: str) -> int:
        return self.data[key]
    def __setitem__(self, key: str, value: int) -> None:
        self.data[key] = value
    def __contains__(self, key: str) -> bool:
        return key in self.data

def main() -> None:
    mut d: Dynamic = Dynamic(data={})
    d["a"] = 1
    d["b"] = 2
    print(d["a"], d["b"])
    print("a" in d, "z" in d)

if __name__ == "__main__":
    main()
