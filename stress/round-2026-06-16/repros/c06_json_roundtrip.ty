import json

def main() -> None:
    let data: dict[str, object] = {"name": "Alice", "age": 30, "tags": ["x", "y"], "active": True}
    let s: str = json.dumps(data, sort_keys=True)
    print(s)
    let back = json.loads(s)
    print(back["name"], back["age"])
    let nested: str = json.dumps({"a": {"b": [1, 2, 3]}}, indent=2)
    print(nested)

if __name__ == "__main__":
    main()
