def describe(x: object) -> str:
    match x:
        case 0:
            return "zero"
        case int() if x < 0:
            return "negative int"
        case int():
            return "positive int"
        case str() if len(x) == 0:
            return "empty string"
        case str():
            return f"string of len {len(x)}"
        case [a, b]:
            return f"pair {a},{b}"
        case [a, *rest]:
            return f"list starting {a}, {len(rest)} more"
        case {"type": t, "value": v}:
            return f"dict type={t} value={v}"
        case _:
            return "unknown"

def main() -> None:
    print(describe(0))
    print(describe(-5))
    print(describe(42))
    print(describe(""))
    print(describe("hello"))
    print(describe([1, 2]))
    print(describe([1, 2, 3, 4]))
    print(describe({"type": "x", "value": 99}))
    print(describe(3.14))

if __name__ == "__main__":
    main()
