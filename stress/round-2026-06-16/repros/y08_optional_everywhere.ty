class Tree:
    value: int
    left: Tree?
    right: Tree?

impl Tree:
    def insert(self, v: int) -> Tree:
        if v < self.value:
            if self.left is None:
                return Tree(value=self.value, left=Tree(value=v, left=None, right=None), right=self.right)
            return Tree(value=self.value, left=self.left.insert(v), right=self.right)
        if self.right is None:
            return Tree(value=self.value, left=self.left, right=Tree(value=v, left=None, right=None))
        return Tree(value=self.value, left=self.left, right=self.right.insert(v))
    def in_order(self) -> list[int]:
        mut result: list[int] = []
        if self.left is not None:
            result = result + self.left.in_order()
        result.append(self.value)
        if self.right is not None:
            result = result + self.right.in_order()
        return result

def main() -> None:
    mut root: Tree = Tree(value=5, left=None, right=None)
    for v in [3, 7, 1, 4, 6, 8]:
        root = root.insert(v)
    print(root.in_order())

if __name__ == "__main__":
    main()
