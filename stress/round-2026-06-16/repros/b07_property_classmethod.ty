class Temperature:
    celsius: float

impl Temperature:
    @property
    def fahrenheit(self) -> float:
        return self.celsius * 9.0 / 5.0 + 32.0
    @classmethod
    def from_fahrenheit(cls, f: float) -> Temperature:
        return Temperature(celsius=(f - 32.0) * 5.0 / 9.0)
    @staticmethod
    def freezing() -> float:
        return 0.0

def main() -> None:
    let t: Temperature = Temperature(celsius=25.0)
    print(t.fahrenheit)
    let t2: Temperature = Temperature.from_fahrenheit(212.0)
    print(t2.celsius)
    print(Temperature.freezing())

if __name__ == "__main__":
    main()
