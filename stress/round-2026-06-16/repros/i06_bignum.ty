def factorial(n: int) -> int:
    mut result: int = 1
    for i in range(1, n + 1):
        result = result * i
    return result

def main() -> None:
    print(factorial(25))
    print(2 ** 100)
    print(10 ** 50 + 1)
    let big: int = factorial(30)
    print(big)
    print(big % 1000000007)
    print(len(str(factorial(100))))

if __name__ == "__main__":
    main()
