from typing import Protocol

class Drawable(Protocol):
    def draw(self) -> str:
        ...
    def area(self) -> float:
        ...

class Circle:
    radius: float

impl Circle:
    def draw(self) -> str:
        return f"circle r={self.radius}"
    def area(self) -> float:
        return 3.14159 * self.radius * self.radius

class Rect:
    w: float
    h: float

impl Rect:
    def draw(self) -> str:
        return f"rect {self.w}x{self.h}"
    def area(self) -> float:
        return self.w * self.h

def render_all(shapes: list[Drawable]) -> float:
    mut total: float = 0.0
    for s in shapes:
        print(s.draw())
        total = total + s.area()
    return total

def main() -> None:
    let shapes: list[Drawable] = [Circle(radius=2.0), Rect(w=3.0, h=4.0)]
    print(round(render_all(shapes), 2))

if __name__ == "__main__":
    main()
