class Coord frozen:
    x: int
    y: int

impl Coord:
    def __hash__(self) -> int:
        return hash((self.x, self.y))
    def __eq__(self, other: object) -> bool:
        if isinstance(other, Coord):
            return self.x == other.x and self.y == other.y
        return False

def main() -> None:
    let visited: set[Coord] = {Coord(x=0, y=0), Coord(x=1, y=1), Coord(x=0, y=0)}
    print(len(visited))
    let d: dict[Coord, str] = {Coord(x=0, y=0): "origin", Coord(x=1, y=2): "point"}
    print(d[Coord(x=0, y=0)])
    print(Coord(x=1, y=1) in visited)

if __name__ == "__main__":
    main()
