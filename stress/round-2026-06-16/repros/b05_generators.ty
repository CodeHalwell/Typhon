from typing import Iterator

def countdown(n: int) -> Iterator[int]:
    mut i: int = n
    while i > 0:
        yield i
        i = i - 1

def squares(xs: list[int]) -> Iterator[int]:
    for x in xs:
        yield x * x

def flatten(nested: list[list[int]]) -> Iterator[int]:
    for inner in nested:
        yield from inner

def main() -> None:
    print(list(countdown(5)))
    print(list(squares([1, 2, 3, 4])))
    print(list(flatten([[1, 2], [3], [4, 5]])))
    let g: Iterator[int] = squares([10, 20])
    print(next(g))
    print(sum(countdown(100)))

if __name__ == "__main__":
    main()
