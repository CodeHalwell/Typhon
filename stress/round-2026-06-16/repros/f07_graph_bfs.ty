from collections import deque

def bfs(graph: dict[int, list[int]], start: int) -> list[int]:
    mut visited: list[int] = []
    mut seen: set[int] = {start}
    mut queue: deque[int] = deque([start])
    while len(queue) > 0:
        let node: int = queue.popleft()
        visited.append(node)
        for neighbor in graph.get(node, []):
            if neighbor not in seen:
                seen.add(neighbor)
                queue.append(neighbor)
    return visited

def main() -> None:
    let graph: dict[int, list[int]] = {0: [1, 2], 1: [3], 2: [3, 4], 3: [], 4: []}
    print(bfs(graph, 0))

if __name__ == "__main__":
    main()
