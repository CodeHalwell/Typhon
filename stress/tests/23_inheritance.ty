class Animal:
    name: str

class Dog(Animal):
    breed: str

class Pup(Dog):
    age: int

impl Animal:
    def speak(self) -> str:
        return "..."

impl Dog:
    def bark(self) -> str:
        return "woof"

def call_speak(a: Animal) -> str:
    return a.speak()

def main() -> None:
    let p: Pup = Pup(name="rex", breed="lab", age=2)
    print(p.bark())  # inherited
    print(p.speak())  # inherited
    let a: Animal = p  # upcasting
    print(call_speak(a))
