def divide(a: int, b: int) -> int:
    if b == 0:
        raise ValueError("zero")
    return a // b

def safe(a: int, b: int) -> Result[int, str]:
    try:
        return Ok(divide(a, b))
    except ValueError as e:
        return Err(str(e))
    except ZeroDivisionError:
        return Err("zerodiv")

def main() -> None:
    let r: Result[int, str] = safe(10, 2)
    match r:
        case Ok(v):
            print(v)
        case Err(e):
            print(e)
