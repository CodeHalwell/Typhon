class A:
    n: int
impl A:
    def f(self, x: int) -> int:
        return x + self.n

class B(A):
    m: int
impl B:
    def f(self, x: str) -> str:
        return x + "!"

def g(a: A) -> int:
    return a.f(1) + 1

def main() -> None:
    print(g(B(n=1, m=2)))

if __name__ == "__main__":
    main()
