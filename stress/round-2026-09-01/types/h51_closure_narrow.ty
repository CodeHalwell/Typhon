from typing import Callable

def outer(x: int?) -> Callable[[], int]:
    if x is None:
        return lambda: 0
    def inner() -> int:
        return x + 1
    return inner

def bump(x: int?, ys: list[int]) -> list[int]:
    if x is None:
        return ys
    return [y + x for y in ys]

def bump2(x: int?, ys: list[int]) -> list[int]:
    if x is None:
        return ys
    return list(map(lambda y: y + x, ys))

def main() -> None:
    print(outer(1)(), bump(1, [1]), bump2(1, [1]))

if __name__ == "__main__":
    main()
