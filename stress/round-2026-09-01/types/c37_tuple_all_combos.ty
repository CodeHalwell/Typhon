class W0:
    x: int
class W1:
    x: int
class W2:
    x: int
class W3:
    x: int
type U = W0 | W1 | W2 | W3

def f(a0: U, a1: U, a2: U) -> int:
    match (a0, a1, a2):
        case (W0(), W0(), W0()):
            return 1
        case (W0(), W0(), W1()):
            return 1
        case (W0(), W0(), W2()):
            return 1
        case (W0(), W0(), W3()):
            return 1
        case (W0(), W1(), W0()):
            return 1
        case (W0(), W1(), W1()):
            return 1
        case (W0(), W1(), W2()):
            return 1
        case (W0(), W1(), W3()):
            return 1
        case (W0(), W2(), W0()):
            return 1
        case (W0(), W2(), W1()):
            return 1
        case (W0(), W2(), W2()):
            return 1
        case (W0(), W2(), W3()):
            return 1
        case (W0(), W3(), W0()):
            return 1
        case (W0(), W3(), W1()):
            return 1
        case (W0(), W3(), W2()):
            return 1
        case (W0(), W3(), W3()):
            return 1
        case (W1(), W0(), W0()):
            return 1
        case (W1(), W0(), W1()):
            return 1
        case (W1(), W0(), W2()):
            return 1
        case (W1(), W0(), W3()):
            return 1
        case (W1(), W1(), W0()):
            return 1
        case (W1(), W1(), W1()):
            return 1
        case (W1(), W1(), W2()):
            return 1
        case (W1(), W1(), W3()):
            return 1
        case (W1(), W2(), W0()):
            return 1
        case (W1(), W2(), W1()):
            return 1
        case (W1(), W2(), W2()):
            return 1
        case (W1(), W2(), W3()):
            return 1
        case (W1(), W3(), W0()):
            return 1
        case (W1(), W3(), W1()):
            return 1
        case (W1(), W3(), W2()):
            return 1
        case (W1(), W3(), W3()):
            return 1
        case (W2(), W0(), W0()):
            return 1
        case (W2(), W0(), W1()):
            return 1
        case (W2(), W0(), W2()):
            return 1
        case (W2(), W0(), W3()):
            return 1
        case (W2(), W1(), W0()):
            return 1
        case (W2(), W1(), W1()):
            return 1
        case (W2(), W1(), W2()):
            return 1
        case (W2(), W1(), W3()):
            return 1
        case (W2(), W2(), W0()):
            return 1
        case (W2(), W2(), W1()):
            return 1
        case (W2(), W2(), W2()):
            return 1
        case (W2(), W2(), W3()):
            return 1
        case (W2(), W3(), W0()):
            return 1
        case (W2(), W3(), W1()):
            return 1
        case (W2(), W3(), W2()):
            return 1
        case (W2(), W3(), W3()):
            return 1
        case (W3(), W0(), W0()):
            return 1
        case (W3(), W0(), W1()):
            return 1
        case (W3(), W0(), W2()):
            return 1
        case (W3(), W0(), W3()):
            return 1
        case (W3(), W1(), W0()):
            return 1
        case (W3(), W1(), W1()):
            return 1
        case (W3(), W1(), W2()):
            return 1
        case (W3(), W1(), W3()):
            return 1
        case (W3(), W2(), W0()):
            return 1
        case (W3(), W2(), W1()):
            return 1
        case (W3(), W2(), W2()):
            return 1
        case (W3(), W2(), W3()):
            return 1
        case (W3(), W3(), W0()):
            return 1
        case (W3(), W3(), W1()):
            return 1
        case (W3(), W3(), W2()):
            return 1
        case (W3(), W3(), W3()):
            return 1

def main() -> None:
    print(f(W0(x=1), W1(x=1), W2(x=1)))
