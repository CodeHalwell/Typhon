class Inner:
    c: int?
class Outer:
    b: Inner?

def f(a: Outer?) -> int:
    if a is not None and a.b is not None and a.b.c is not None:
        return a.b.c + 1
    return 0

def g(a: Outer) -> int:
    if a.b is None or a.b.c is None:
        return 0
    return a.b.c

def main() -> None:
    print(f(Outer(b=Inner(c=1))), g(Outer(b=None)))

if __name__ == "__main__":
    main()
