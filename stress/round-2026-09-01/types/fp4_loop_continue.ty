def f(xs: list[int?]) -> int:
    mut total: int = 0
    for x in xs:
        if x is None:
            continue
        total += x
    let ups: list[int] = [x + 1 for x in xs if x is not None]
    return total + len(ups)

def main() -> None:
    print(f([1, None, 2]))

if __name__ == "__main__":
    main()
