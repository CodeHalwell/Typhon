import asyncio
from typing import Awaitable, Callable

order: list[str] = []

@gatherable
async def fetch(tag: str) -> str:
    return tag

async def slow_fetch(tag: str) -> str:
    await asyncio.sleep(0.05 if tag == "a" else 0.0)
    order.append(tag)
    return tag

async def run(fetch: Callable[[str], Awaitable[str]]) -> None:
    let a: str = await fetch("a")
    let b: str = await fetch("b")
    print(order, a, b)

asyncio.run(run(slow_fetch))
