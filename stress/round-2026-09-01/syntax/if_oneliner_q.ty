def parse(s: str) -> Result[int, str]:
    if s == "":
        return Err("empty")
    return Ok(int(s))

def maybe(flag: bool) -> Result[int, str]:
    mut x: int = 0
    if flag: x = parse("")?
    return Ok(x)

def sum_all(xs: list[str]) -> Result[int, str]:
    mut total: int = 0
    for s in xs: total = total + parse(s)?
    return Ok(total)

def main() -> None:
    print(maybe(False), maybe(True))
    print(sum_all([]), sum_all(["1", "2"]))

if __name__ == "__main__":
    main()
