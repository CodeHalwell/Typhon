type Shape = A | B

class A:
    x: int

class B:
    y: int

impl Shape:
    def f(self) -> int:
        return 1
# column-zero comment inside the impl body
    def g(self) -> int:
        return 2

def main() -> None:
    print(A(x=1).f(), A(x=1).g(), B(y=2).g())

if __name__ == "__main__":
    main()
