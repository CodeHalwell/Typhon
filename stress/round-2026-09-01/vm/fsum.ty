import math
print("S1", sum([0.1] * 10), sum([0.1] * 10) == 1.0, sum([1e100, 1.0, -1e100, 1.0]), sum([0.1, 0.2, 0.3]), sum([1e16, 1.0, -1e16]), sum([0.1] * 10, 0.0), sum(x / 10 for x in range(10)), sum([0.1, 0.1, 0.1]), sum([1.0, 1e-16, 1e-16]), sum([0.7, 0.1, 0.2]), sum([3.14, 2.72, 1.41, 1.62]), sum([1e-10] * 1000) == 1e-7, sum([0.1] * 3) == 0.3)
print("S2", math.fsum([0.1] * 10), sum([1, 2, 0.5]), sum([0.5, 1, 2]), sum([True, 0.5]), sum([1e20, 1, -1e20]), sum([1, 1e20, -1e20]))
xs: list[float] = [0.1] * 10
mut acc: float = 0.0
for v in xs:
    acc += v
print("S3", acc)
