print("A1", 7 // -2, -7 // 2, 7 % -2, -7 % 2, divmod(-7, 2), divmod(7, -2))
print("A2", 7.5 // -2, -7.5 // 2, 7.5 % -2, -7.5 % 2, divmod(-7.5, 2))
print("A3", round(2.5), round(3.5), round(-2.5), round(0.5), round(1.5))
print("A4", round(2.675, 2), round(1.005, 2), round(-1.5), round(2.5, 0), round(123456, -2), round(150, -2), round(250, -2), round(-150, -2))
print("A5", round(1234.5678, -2), round(0.125, 2), round(0.375, 2), round(2.5, 0), type(round(2.5, 0)).__name__, type(round(2.5)).__name__)
print("A6", pow(2, -1), pow(2, 10, 1000), pow(-2, 3, 5), pow(2, 0.5), pow(-8, 1/3))
print("A7", 2 ** -2, (-2) ** 0.5, 10 ** 20, 10 ** 20 // 3, (-10) ** 21 % 7, 2 ** 64 >> 3, -1 >> 100, -5 >> 1, -5 << 3)
print("A8", (-5) & 3, (-5) | 3, (-5) ^ 3, ~5, ~-5, (2**70) & (2**70 - 1), -(2**70) >> 65, (2**70) ^ -1)
print("A9", (255).bit_length(), (-255).bit_length(), (0).bit_length(), (2**100).bit_length(), (1).bit_length())
print("B1", 1e16, 1e-5, 0.1 + 0.2, 1e22, 1e15, 123456789012345678.0, 1.0, 100.0, 1e100, -0.0, 5e-324, 1.7976931348623157e308)
print("B2", str(1e16), str(1e-4), str(0.0001), str(0.00001), repr(1e16), float("nan"), float("inf"), -float("inf"), float("-nan"))
print("B3", int("  42  "), int("+42"), int("-42"), int("1_000"), int("0x1f", 16), int("1f", 16), int(" 0b101 ", 0), int("0o17", 8), int(True), int(3.99), int(-3.99))
print("B4", bool("False"), bool(""), bool(0.0), bool([]), bool([0]), bool(None), bool(-0.0), bool(float("nan")))
print("B5", float("1e3"), float("  -1.5  "), float("infinity"), float("+inf"), float(" .5"), float("5."))
print("B6", 1 / 3, 2 / 3, 10 / 4, 1 // 0.3, 5.0 // 2, 5 // 2.0, 2.0 ** 3, 2 ** 3.0, -2 ** 2, (-2) ** 2)
print("B7", 3 * 1.1, 0.1 * 3, 1.1 + 2.2, 100 * 1.1, 1e300 * 1e300, -1e300 * 1e300, 1e308 + 1e308)
print("B8", True + True, True * 3, True / 2, -True, +True, True << 2, True & False, True | 2, ~True, True ** 2, True % 2, abs(True), abs(-0.0))
print("B9", 5 % 0.3, -5 % 0.3, 5.5 % -2, 1e18 % 7, 2**100 % 7, 2**100 / 3, 2**100 // 3.0, 10**16 + 1.0, int(1e16) + 1)
print("C1", f"{3.14159:.2f}", f"{3.14159:8.3f}", f"{-3.14159:+.1f}", f"{3.0:g}", f"{1e-5:g}", f"{123456789.0:g}", f"{0.0001:g}", f"{1e6:g}", f"{1e5:g}", f"{1234567.0:g}")
print("C2", f"{1234567.891:,}", f"{1234567:,}", f"{1234567.891:_}", f"{1234567:_x}", f"{1234567:_b}", f"{12345.6789:,.2f}", f"{-1234.5:,.0f}", f"{1234567890123:,}")
print("C3", f"{3.14159:e}", f"{3.14159:E}", f"{0.0:e}", f"{123456.0:.2e}", f"{1e-10:.3e}", f"{1e100:e}", f"{-1.5e-7:.1e}", f"{5:e}", f"{5:.0e}")
print("C4", f"{0.25:%}", f"{0.25:.1%}", f"{1:%}", f"{0.123456:.2%}", f"{2.5:.0%}", f"{1.005:.2%}")
print("C5", f"{42:5d}|{42:<5d}|{42:^5d}|{42:>5d}|{42:05d}|{-42:05d}|{42:+d}|{42: d}|{-42: d}|{42:x}|{42:#x}|{42:#o}|{42:#b}|{255:X}|{255:#X}|{0:#x}")
print("C6", f"{'hi':>6}|{'hi':<6}|{'hi':^6}|{'hi':^7}|{'hi':*^7}|{'hi':.1}|{'hello':.3}|{'hi':6.1}|{'':^3}|")
print("C7", f"{float('nan'):.2f}", f"{float('inf'):.2f}", f"{float('-inf'):>8}", f"{float('nan'):>8}", f"{float('inf'):e}", f"{float('nan'):g}", f"{float('inf'):+f}", f"{float('nan'):010.2f}")
print("C8", f"{1.5:.0f}", f"{2.5:.0f}", f"{0.5:.0f}", f"{-0.5:.0f}", f"{1e16:.0f}", f"{1e16:f}", f"{2**64:f}", f"{1.0:.10f}", f"{1/3:.20f}", f"{0.1:.30f}")
print("C9", f"{3.14159:.3}", f"{1234567.0:.3}", f"{0.000012345:.3}", f"{12345678.0:.3g}", f"{1e-7:.3}", f"{100.0:.3}", f"{1000000.0:.7}", f"{0.1:.17}")
print("D1", f"{3.0:#g}", f"{3:#.3g}", f"{3.0:#.0f}", f"{3:#.0e}", f"{1234.5:#,.1f}", f"{3.5:#}", f"{3:#}", f"{-0.0:.1f}", f"{-0.0:g}", f"{-0.0:e}")
print("D2", f"{0.1:.1f}", f"{0.25:.1f}", f"{0.35:.1f}", f"{0.45:.1f}", f"{0.05:.1f}", f"{0.15:.1f}", f"{2.675:.2f}", f"{1.005:.2f}", f"{1.115:.2f}")
print("D3", "%d %5d %-5d| %05d %+d % d %x %X %o %#x %#o %e %.2e %g %G %.3g %%" % (42, 42, 42, 42, 42, 42, 255, 255, 8, 255, 8, 12345.678, 12345.678, 0.00001234, 1e20, 1234.5678))
print("D4", "%s %r %10s %-10s| %.2s %c %c" % ("hi", "hi", "hi", "hi", "hello", 65, "z"), "%5.1f|%-8.3f|%08.2f|%+.1f" % (3.14159, 2.5, -3.14159, 2.0))
print("D5", "%s" % [1, 2], "%s" % ((1, 2),), "%d%%" % 50, "%i" % 3.9, "%d" % -3.9, "%s %s" % (None, True), "%.3s" % "abcdef")
print("D6", "{} {}".format(1, 2), "{1} {0}".format(1, 2), "{a} {b}".format(a=1, b=2), "{:>5}|{:<5}|{:^5}".format(1, 2, 3), "{:{}}".format(3, 5), "{:{w}.{p}f}".format(3.14159, w=8, p=2), "{{}} {}".format(1))
print("D7", "{:d}".format(True), "{}".format(True), "{:s}".format("s"), "{0:,}".format(10**9), "{:5}".format(True), "{:5}".format(None) if False else "skip")
print("D8", format(3.14159, ".2f"), format(42, "08b"), format(255, "x"), format(1234567, ","), format("x", ">4"), format(True, ""), format(True, "d"), format(1.0, ""), format(1e16, ""), format(12.0, "g"), format(0.5, ".0%"))
print("D9", f"{'a'!r}", f"{'a'!s}", f"{'ü'!a}", f"{[1, 'a']!r}", f"{{}}", f"{1 + 1 = }", f"{ 1 + 1 = }", f"{'x':>3!r}" if False else f"{'x'!r:>5}", f"{3.14!r:>8}", f"{None!s:>6}")
