@dataclass
class DC:
    a: int
    b: str = "x"
    c: list[int] = field(default_factory=list)

@dataclass(order=True, frozen=True)
class Ver:
    major: int
    minor: int = 0

@dataclass(eq=False)
class NoEq:
    v: int

@dataclass(repr=False)
class NoRepr:
    v: int

class Plain:
    n: int

impl Plain:
    def __post_init__(self) -> None:
        self.n += 1

