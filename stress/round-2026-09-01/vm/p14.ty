import sys
from typing import Callable

print("M1", __name__, type(__file__).__name__, __file__.endswith((".py", ".ty")), __spec__ is None if False else "skip", __builtins__ is not None if False else "skip", "__main__" == __name__)

def side(tag: str) -> int:
    print("  eval", tag)
    return 1

def with_default(x: int = side("default")) -> int:
    return x

print("M2 after def")
print("M3", with_default(), with_default(5))

def deco_a(f: Callable[[], str]) -> Callable[[], str]:
    print("  deco_a applied")
    return f

def deco_b(f: Callable[[], str]) -> Callable[[], str]:
    print("  deco_b applied")
    return f

@deco_a
@deco_b
def decorated() -> str:
    return "d"

print("M4", decorated())

def tf1() -> str:
    mut out: str = ""
    try:
        try:
            out += "a"
            raise ValueError("x")
        except ValueError:
            out += "b"
            raise
        finally:
            out += "c"
    except ValueError:
        out += "d"
    finally:
        out += "e"
    return out

def tf2() -> str:
    for i in range(3):
        try:
            if i == 0:
                continue
            if i == 2:
                break
            return "returned"
        finally:
            print("  fin", i)
    return "end"

def tf3() -> int:
    try:
        try:
            return 1
        finally:
            return 2
    finally:
        print("  outer fin")

def tf4() -> str:
    mut out: str = ""
    try:
        out += "t"
    except Exception:
        out += "x"
    else:
        try:
            raise KeyError("in else")
        except KeyError as e:
            out += f"e{e}"
    return out

def tf5() -> str:
    try:
        raise ValueError("first")
    except ValueError as e:
        try:
            raise TypeError("second")
        except TypeError as e2:
            return f"{e}|{e2}|{e2.__context__}"
    return "no"

def tf6() -> str:
    try:
        raise ValueError("a")
    except (TypeError, ValueError) as e:
        return f"tuple {type(e).__name__}"

def tf7() -> str:
    mut log: list[str] = []
    try:
        try:
            raise ValueError("inner")
        finally:
            log.append("f1")
    except ValueError as e:
        log.append(str(e))
    return ",".join(log)

def tf8() -> str:
    try:
        return "try"
    except ValueError:
        return "exc"
    else:
        return "else"
    finally:
        pass

def tf9() -> str:
    mut out: str = ""
    for x in [1, 2]:
        try:
            out += str(x)
        except Exception:
            pass
        else:
            out += "e"
        finally:
            out += "f"
    return out

def tf10() -> str:
    let e_after: str = "unset"
    try:
        raise ValueError("v")
    except ValueError as e:
        pass
    try:
        print(e)
    except NameError:
        return "e deleted"
    return "e survives"

print("M5", tf1(), tf2(), tf3(), tf4(), tf5(), tf6(), tf7(), tf8(), tf9(), tf10())

