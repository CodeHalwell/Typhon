h.n += 5
h.items += [2]
h.items[0] += 10
d: dict[str, int] = {"a": 1}
d["a"] += 1
d["b"] = d.get("b", 0) + 1
xs: list[int] = [1, 2, 3]
xs[0] += 10
xs[-1] *= 2
mut a: int = 1
mut b: int = 2
a, b = b, a
[c, dd] = [3, 4]
(e, f), g = (5, 6), 7
print("M6", h, d, xs, a, b, c, dd, e, f, g)
names: list[str] = []
del xs[0]
del d["a"]
try:
    del d["zzz"]
except KeyError as err:
    print("M7", err)
try:
    del xs[10]
except IndexError as err:
    print("M8", err)
print("M9", xs, d)
counter: int = 0
def incr() -> None:
    global counter
    counter += 1
incr()
incr()
print("M10", counter)
def make_adders() -> list[Callable[[int], int]]:
    return [lambda x, k=k: x + k for k in range(3)]

def outer_fn() -> Callable[[], list[int]]:
    mut cell: list[int] = []
    def inner() -> list[int]:
        cell.append(len(cell))
        return cell
    return inner
fn = outer_fn()
fn()
print("M12", fn(), outer_fn()())
class Cfg:
    name: str
    debug: bool = False
    level: int = 0

cfg: Cfg = Cfg(name="n")
cfg.level = 3
print("M13", cfg, cfg == Cfg(name="n", level=3), cfg == Cfg(name="n"), Cfg(name="z", debug=True))
def kw_dict(**kw: int) -> list[str]:
    return [f"{k}={v}" for k, v in kw.items()]
print("M14", kw_dict(z=1, a=2, m=3), kw_dict(**{"b": 1, "a": 2}), kw_dict(c=0, **{"b": 1}))
