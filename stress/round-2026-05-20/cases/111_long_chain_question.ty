# Long chain of Result with `?`.

def f1(x: int) -> Result[int, str]:
    if x < 0:
        return Err("neg")
    return Ok(x + 1)

def f2(x: int) -> Result[int, str]:
    return Ok(x + 2)

def f3(x: int) -> Result[int, str]:
    return Ok(x + 3)

def f4(x: int) -> Result[int, str]:
    return Ok(x + 4)

def f5(x: int) -> Result[int, str]:
    return Ok(x + 5)

def chain(x: int) -> Result[int, str]:
    let a: int = f1(x)?
    let b: int = f2(a)?
    let c: int = f3(b)?
    let d: int = f4(c)?
    let e: int = f5(d)?
    return Ok(e)

def main() -> None:
    match chain(0):
        case Ok(v): print(v)
        case Err(e): print(e)

if __name__ == "__main__":
    main()
