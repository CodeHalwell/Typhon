# A keyword pattern with all field-bindings (Point(x=x, y=y)) should be a wildcard.

class Point:
    x: int
    y: int

def describe(p: Point) -> str:
    match p:
        case Point(x=x, y=y):
            return f"({x},{y})"

def main() -> None:
    print(describe(Point(x=1, y=2)))

if __name__ == "__main__":
    main()
