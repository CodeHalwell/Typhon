# Float literal handling — finding #31 was 1.0 emitted as 1.
# Verify fix.

import json

def main() -> None:
    let x: float = 1.0
    let y: float = 0.0
    let z: float = 5.0
    print(json.dumps([x, y, z]))
    print(type(x).__name__, x)
    print(isinstance(x, float))

if __name__ == "__main__":
    main()
