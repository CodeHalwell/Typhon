

def find(id: int) -> str?:
    if id == 1:
        return "alice"
    return None

def sum_list(xs: list[int]) -> int:
    mut total: int = 0
    for x in xs:
        total = total + x
    return total

def main() -> None:
    let u: str? = find(1)
    print(u)
    print(sum_list([1, 2, 3]))

if __name__ == "__main__":
    main()
