# with-chain without else err: — first Err shortcuts.

def f(x: int) -> Result[int, str]:
    if x < 0:
        return Err("neg")
    return Ok(x)

def g(x: int) -> Result[int, str]:
    return Ok(x * 2)

def runner(x: int) -> Result[int, str]:
    with a = f(x)?, b = g(a)?:
        return Ok(b + 1)

def main() -> None:
    match runner(5):
        case Ok(v): print(v)
        case Err(e): print(e)
    match runner(-1):
        case Ok(v): print(v)
        case Err(e): print(e)

if __name__ == "__main__":
    main()
