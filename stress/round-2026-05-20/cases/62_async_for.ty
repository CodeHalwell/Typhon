# async for + async generators

import asyncio
from typing import AsyncIterator

async def gen() -> AsyncIterator[int]:
    for i in range(3):
        await asyncio.sleep(0.001)
        yield i

async def main_a() -> None:
    mut total: int = 0
    async for v in gen():
        total = total + v
    print(total)

def main() -> None:
    asyncio.run(main_a())

if __name__ == "__main__":
    main()
