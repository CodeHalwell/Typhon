def factorial(n: int) -> int:
    mut acc: int = 1
    mut i: int = 2
    while i <= n:
        acc = acc * i
        i = i + 1
    return acc

def main() -> None:
    let big: int = factorial(30)
    print(big)
    print(2 ** 100)
    print(7 // 2, 7 % 2, -7 // 2, -7 % 2)
    print(divmod(17, 5))
    print(round(3.14159, 2))
    print(abs(-42), pow(2, 10), pow(2, 10, 1000))
    let f: float = 10 / 3
    print(f"{f:.4f}")
    print(int("ff", 16), int("101", 2), bin(10), hex(255), oct(8))
    print(3 + 4j)

if __name__ == "__main__":
    main()
