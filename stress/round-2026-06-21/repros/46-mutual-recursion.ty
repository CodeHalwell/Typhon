def is_even(n: int) -> bool:
    if n == 0:
        return True
    return is_odd(n - 1)

def is_odd(n: int) -> bool:
    if n == 0:
        return False
    return is_even(n - 1)

type Tree = Leaf | Branch

class Leaf:
    value: int
class Branch:
    left: Tree
    right: Tree

impl Tree:
    def sum(self) -> int:
        match self:
            case Leaf(v):       return v
            case Branch(l, r):  return l.sum() + r.sum()
    def depth(self) -> int:
        match self:
            case Leaf(_):       return 1
            case Branch(l, r):  return 1 + max(l.depth(), r.depth())

def main() -> None:
    print(is_even(10), is_odd(10))
    print(is_even(7), is_odd(7))

    let tree: Tree = Branch(
        left=Branch(left=Leaf(value=1), right=Leaf(value=2)),
        right=Leaf(value=3),
    )
    print(tree.sum())
    print(tree.depth())

if __name__ == "__main__":
    main()
