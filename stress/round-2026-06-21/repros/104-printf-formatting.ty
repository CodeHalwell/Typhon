def main() -> None:
    print("%d + %d = %d" % (2, 3, 5))
    print("%s is %d years old" % ("Alice", 30))
    print("%.2f" % 3.14159)
    print("%5d|%-5d|" % (42, 42))
    print("%x %o" % (255, 64))
    print("%c%c%c" % (72, 105, 33))
    print("%(name)s scored %(score)d" % {"name": "Bob", "score": 95})
    print("%+d %+d" % (5, -5))
    print("%08.3f" % 3.14159)
    print("%e" % 123456.789)
    print("%g" % 0.0001234)
    print("%r" % "quoted")
    print("%%literal%%")
    let pct: float = 0.875
    print("%.1f%%" % (pct * 100))

if __name__ == "__main__":
    main()
