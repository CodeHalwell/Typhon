class Countdown:
    n: int

class CountdownIter:
    current: int

impl Countdown:
    def __iter__(self) -> CountdownIter:
        return CountdownIter(current=self.n)

impl CountdownIter:
    def __iter__(self) -> CountdownIter:
        return self
    def __next__(self) -> int:
        if self.current <= 0:
            raise StopIteration
        let val: int = self.current
        self.current = self.current - 1
        return val

def main() -> None:
    for x in Countdown(n=5):
        print(x)
    print(list(Countdown(n=3)))
    print(sum(Countdown(n=4)))
    let doubled: list[int] = [v * 2 for v in Countdown(n=3)]
    print(doubled)

if __name__ == "__main__":
    main()
