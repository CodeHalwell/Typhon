from decimal import Decimal
from fractions import Fraction

def main() -> None:
    let a: Decimal = Decimal("0.1")
    let b: Decimal = Decimal("0.2")
    print(a + b)
    print(Decimal("1.00") / Decimal("3"))
    print(a * Decimal("3"))

    let f1: Fraction = Fraction(1, 3)
    let f2: Fraction = Fraction(1, 6)
    print(f1 + f2)
    print(f1 * f2)
    print(Fraction(3, 4) - Fraction(1, 4))
    print(Fraction("2/8"))
    print(float(Fraction(1, 4)))

if __name__ == "__main__":
    main()
