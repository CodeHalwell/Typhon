def double(x: int) -> int:
    return x * 2

def increment(x: int) -> int:
    return x + 1

def square(x: int) -> int:
    return x * x

def find_even(xs: list[int]) -> int?:
    for x in xs:
        if x % 2 == 0:
            return x
    return None

def process(xs: list[int]) -> str:
    guard first_even = find_even(xs) else:
        return "no even number"
    let result: int = first_even |> double() |> increment() |> square()
    return f"result: {result}"

def main() -> None:
    print(process([1, 3, 4, 7]))
    print(process([1, 3, 5, 7]))
    let value: int = 3 |> double() |> square()
    print(value)

if __name__ == "__main__":
    main()
