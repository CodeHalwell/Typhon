import functools

@memo
def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def main() -> None:
    print([fib(n) for n in range(15)])
    print(functools.reduce(lambda a, b: a + b, [1, 2, 3, 4, 5], 0))
    print(functools.reduce(lambda a, b: a * b, [1, 2, 3, 4, 5]))
    let add: Callable[[int], int] = functools.partial(lambda a, b: a + b, 10)
    print(add(5))
    let nums: list[int] = [3, 1, 4, 1, 5, 9, 2, 6]
    let by_parity: list[int] = sorted(nums, key=functools.cmp_to_key(lambda a, b: (a % 2) - (b % 2)))
    print(by_parity)

if __name__ == "__main__":
    main()
