from typing import Callable

class Multiplier:
    factor: int

impl Multiplier:
    def __call__(self, x: int) -> int:
        return x * self.factor

class Accumulator:
    total: int

impl Accumulator:
    def __call__(self, x: int) -> int:
        self.total = self.total + x
        return self.total

def apply_twice(fn: Callable[[int], int], x: int) -> int:
    return fn(fn(x))

def main() -> None:
    let triple: Multiplier = Multiplier(factor=3)
    print(triple(5))
    print(apply_twice(triple, 2))

    mut acc: Accumulator = Accumulator(total=0)
    print(acc(10))
    print(acc(20))
    print(acc(5))

    let multipliers: list[Multiplier] = [Multiplier(factor=i) for i in range(1, 4)]
    print([m(10) for m in multipliers])

    let mapped: list[int] = list(map(triple, [1, 2, 3]))
    print(mapped)

if __name__ == "__main__":
    main()
