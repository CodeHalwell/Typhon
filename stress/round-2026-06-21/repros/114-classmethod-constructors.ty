class Point:
    x: int
    y: int

impl Point:
    @classmethod
    def origin(cls) -> Point:
        return cls(x=0, y=0)
    @classmethod
    def from_tuple(cls, t: tuple[int, int]) -> Point:
        return cls(x=t[0], y=t[1])
    @classmethod
    def diagonal(cls, n: int) -> Point:
        return cls(x=n, y=n)
    def __repr__(self) -> str:
        return f"Point({self.x}, {self.y})"

class Temperature:
    kelvin: float

impl Temperature:
    @classmethod
    def from_celsius(cls, c: float) -> Temperature:
        return cls(kelvin=c + 273.15)
    @classmethod
    def from_fahrenheit(cls, f: float) -> Temperature:
        return cls(kelvin=(f - 32.0) * 5.0 / 9.0 + 273.15)
    def celsius(self) -> float:
        return self.kelvin - 273.15

def main() -> None:
    print(Point.origin())
    print(Point.from_tuple((3, 4)))
    print(Point.diagonal(5))

    let t1: Temperature = Temperature.from_celsius(100.0)
    print(f"{t1.celsius():.2f}")
    let t2: Temperature = Temperature.from_fahrenheit(32.0)
    print(f"{t2.celsius():.2f}")

if __name__ == "__main__":
    main()
