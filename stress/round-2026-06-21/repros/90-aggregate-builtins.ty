def main() -> None:
    let matrix: list[list[int]] = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]

    print(sum(sum(row) for row in matrix))
    print(max(max(row) for row in matrix))
    print(min(min(row) for row in matrix))
    print(all(all(x > 0 for x in row) for row in matrix))
    print(any(x == 5 for row in matrix for x in row))

    let flat: list[int] = [x for row in matrix for x in row]
    print(sorted(flat, reverse=True)[:3])
    print(sum(flat) / len(flat))

    let words: list[str] = ["apple", "banana", "kiwi", "cherry"]
    print(max(words, key=len))
    print(min(words, key=len))
    print(sorted(words, key=lambda w: (len(w), w)))

    print(sum([x * x for x in range(1, 11)]))
    print(max([abs(x) for x in [-5, 3, -8, 2]]))

    let counts: dict[str, int] = {"a": 3, "b": 1, "c": 2}
    print(max(counts, key=lambda k: counts[k]))
    print(sorted(counts.items(), key=lambda p: -p[1]))

    print(len([x for x in range(100) if x % 7 == 0]))

if __name__ == "__main__":
    main()
