import numpy as np
import pandas as pd

def main() -> None:
    let df = pd.DataFrame({"a": [1, 2, 3], "b": [4, 5, 6]})
    let g = df.groupby("a").sum()
    let s = df.sort_values(by="a", ascending=False)
    let m = df.merge(df, on="a")
    let a = np.array([[1.0, 2.0], [3.0, 4.0]])
    print(a.reshape(4))
    print(a.sum(axis=0))
    print(np.linalg.inv(a))

if __name__ == "__main__":
    main()
