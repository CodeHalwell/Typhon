# Bundled, curated Typhon stub for `requests` — best-effort and intentionally
# partial (see the module note in `seed_bundled_stubs`). `requests` is typed
# only via the separate `types-requests` package (typeshed), so venv
# introspection over the installed `requests` recovers little; this gives the
# common surface real shapes out of the box. Request methods take
# `**kwargs: object` for the many optional kwargs; `Session()` takes none.
#
# An authored project `.dty`/`.ty` overrides this bundle.

class Response:
    status_code: int = 0
    text: str = ""
    content: bytes = b""
    url: str = ""
    encoding: str? = None
    reason: str = ""
    ok: bool = True
    headers: object = None
    cookies: object = None
    elapsed: object = None

impl Response:
    def json(self, **kwargs: object) -> object: ...
    def raise_for_status(self) -> None: ...
    def iter_content(self, **kwargs: object) -> object: ...
    def iter_lines(self, **kwargs: object) -> object: ...
    def close(self) -> None: ...

class Session:
    pass

impl Session:
    def get(self, url: str, **kwargs: object) -> Response: ...
    def post(self, url: str, **kwargs: object) -> Response: ...
    def put(self, url: str, **kwargs: object) -> Response: ...
    def patch(self, url: str, **kwargs: object) -> Response: ...
    def delete(self, url: str, **kwargs: object) -> Response: ...
    def head(self, url: str, **kwargs: object) -> Response: ...
    def options(self, url: str, **kwargs: object) -> Response: ...
    def request(self, method: str, url: str, **kwargs: object) -> Response: ...
    def close(self) -> None: ...

def get(url: str, **kwargs: object) -> Response: ...
def post(url: str, **kwargs: object) -> Response: ...
def put(url: str, **kwargs: object) -> Response: ...
def patch(url: str, **kwargs: object) -> Response: ...
def delete(url: str, **kwargs: object) -> Response: ...
def head(url: str, **kwargs: object) -> Response: ...
def options(url: str, **kwargs: object) -> Response: ...
def request(method: str, url: str, **kwargs: object) -> Response: ...
