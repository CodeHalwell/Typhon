# EXPECT-ERROR: tyc::missing_await
# EXPECT-ERROR: tyc::nullable_use
# EXPECT-ERROR: tyc::type_mismatch
# EXPECT-WARN: tyc::async_without_await
# EXPECT-WARN: tyc::blocking_in_async
# EXPECT-WARN: tyc::resource_not_managed
# EXPECT-WARN: tyc::unused_import
#
# An async data pipeline that type-checks in Python's head and not in Typhon's.
# Seven diagnostics, three of them hard errors:
#
#   1. `import json` is never used — `tyc::unused_import` (warn since v0.8.0).
#   2. `load_config` opens a file without `with` — `tyc::resource_not_managed`.
#      The handle leaks if `read()` raises.
#   3. `fetch_batch` calls `time.sleep` inside `async def` —
#      `tyc::blocking_in_async`. That stalls the entire event loop, not just
#      this coroutine. Use `await asyncio.sleep(...)`.
#   4. `summarise` is `async` but never awaits — `tyc::async_without_await`.
#   5. `run` calls `fetch_batch(...)` without `await`. In CPython this binds a
#      coroutine object and skips the work — `tyc::missing_await`. The caller
#      is itself `async`, and the coroutine flows into a slot annotated with
#      the callee's own return type (`dict[str, int]`), which is the shape
#      that can never be a deliberate deferral. See
#      ../06-async-and-concurrency/missing_await_in_async_caller.ty.
#   6. `.get(...)` returns `int?`; `run` adds to it directly —
#      `tyc::nullable_use`.
#   7. `run` is annotated `-> int` but returns a `str` — `tyc::type_mismatch`.


import asyncio
import json
import time


def load_config(path: str) -> str:
    let f = open(path)
    let body: str = f.read()
    f.close()
    return body


async def fetch_batch(n: int) -> dict[str, int]:
    time.sleep(0.01)
    return {"count": n}


async def summarise(batch: dict[str, int]) -> str:
    return f"got {len(batch)} keys"


async def run() -> int:
    let batch: dict[str, int] = fetch_batch(3)
    let count: int? = batch.get("count")
    let total: int = count + 1
    return f"total {total}"


def main() -> None:
    print(asyncio.run(run()))


main()
