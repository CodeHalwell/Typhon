# EXPECT-ERROR: tyc::invalid_question_op
#
# **Only one diagnostic comes out of this file, and there are four mistakes in
# it.** Worth knowing before you spend a fix-recheck cycle wondering why the
# other three didn't show up.
#
# Three validators run on the *raw source*, before the file is preprocessed
# and parsed: `tyc::invalid_question_op`, `tyc::lazy_usage`, and
# `tyc::extend_builtin`. Each of them rewrites the text (`?` becomes an
# `isinstance(_t, Err)` ladder, `lazy import` becomes a proxy class, `extend`
# becomes free functions), so if one is malformed there is no valid AST to
# build and the whole type-checking stage is skipped —
# `tyc_db::check_source_file_with_imports` returns early.
#
# The upshot: a single misplaced `?` masks every type error in the file. Fix
# the `?` first, re-run `tyc check`, and the rest appear.
#
# Hiding behind the `?` here:
#   * `let name: str = 42`               — tyc::type_mismatch
#   * `count = count + 1`                — tyc::immutable_assign
#   * `def helper(x)`                    — tyc::missing_annotation
#
# Fix: change `summarise` to return `Result[str, str]` (or `match` on the
# Result explicitly), then re-run to see the other three.


def parse_port(raw: str) -> Result[int, str]:
    if not raw.isdigit():
        return Err(f"not a number: {raw}")
    return Ok(int(raw))


def helper(x) -> int:
    return x


def summarise(raw: str) -> str:
    let port: int = parse_port(raw)?
    let name: str = 42
    let count: int = 0
    count = count + 1
    return f"{name}:{port} ({count})"


def main() -> None:
    print(summarise("8080"))


main()
