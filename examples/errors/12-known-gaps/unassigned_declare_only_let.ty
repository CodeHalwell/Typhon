# KNOWN-GAP: no diagnostic — `tyc::missing_initialiser` exists in
# `tyc-diagnostics` and in `tyc explain --list`, but nothing in the compiler
# emits it. The code is dead.
#
# A declare-only `let NAME: T` that is never assigned *and* never read is
# accepted silently. It lowers to a bare `port: int` annotation in the emitted
# Python, which is inert at runtime — dead code rather than a crash, which is
# why this one is a lint gap rather than a soundness hole.
#
# Reading it on a path that never assigned it *is* caught, by
# `tyc::use_of_uninitialised` (see ../01-bindings-and-mutability/).
#
# Either wire `missing_initialiser` up to fire here, or retire the code — see
# docs/diagnostics/missing_initialiser.md.


def start() -> str:
    let port: int
    return "started"


def main() -> None:
    print(start())


main()
