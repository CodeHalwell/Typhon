# KNOWN-GAP: no diagnostic — `tyc::implicit_any` covers annotated-assignment
# positions (locals, module bindings, class fields) but not function parameter
# or return annotations.
#
# Rule 1 says no `Any` gets in, and a bare `dict` / `list` in a *signature* is
# the highest-leverage place for one to get in: it silently widens every call
# site and every use in the body. `let xs: list = []` errors; `def f(xs: list)`
# does not.
#
# Closing this would reject programs that run correctly today, so it is a
# deliberate narrowing decision rather than a bug fix — see
# docs/diagnostics/implicit_any.md.
#
# Fix in this file: `def keys_of(d: dict[str, int]) -> list[str]:`.


def keys_of(d: dict) -> list:
    return list(d.keys())


def main() -> None:
    print(keys_of({"a": 1}))


main()
