# KNOWN-GAP: no diagnostic — crashes at runtime with
#   TypeError: object of type 'coroutine' has no len()
#   RuntimeWarning: coroutine 'fetch_a' was never awaited
#
# `tyc::missing_await` fires only when the **caller is synchronous**. A
# forgotten `await` inside another `async def` — by far the likelier mistake,
# since that is where await-heavy code actually lives — is accepted silently.
#
# Worse, no `tyc::type_mismatch` fires either: `fetch_a()` evaluates to
# `Coroutine[..., dict[str, int]]`, and binding it to a `dict[str, int]` slot
# should be a mismatch. The checker types the call by its *return* type
# regardless of whether it was awaited, so the coroutine object flows into a
# concretely-typed name unchallenged.
#
# `tyc::async_without_await` sometimes covers for this by accident — if the
# caller has no awaits at all it warns about that instead. This file
# deliberately awaits `fetch_b` so even that proxy signal is gone, and
# `tyc check` reports absolutely nothing.
#
# Any fix has to keep the deliberate-deferral pattern legal:
#
#     let task = fetch_a()      # bind now …
#     let data = await task     # … await later
#
# so the narrow rule is "an un-awaited async call whose result flows into a
# slot annotated with the coroutine's *return* type", not "any un-awaited
# async call".
#
# Fix in this file: `let d: dict[str, int] = await fetch_a()`.


import asyncio


async def fetch_a() -> dict[str, int]:
    await asyncio.sleep(0)
    return {"a": 1}


async def fetch_b() -> int:
    await asyncio.sleep(0)
    return 2


async def run() -> int:
    let b: int = await fetch_b()
    let d: dict[str, int] = fetch_a()
    return len(d) + b


print(asyncio.run(run()))
