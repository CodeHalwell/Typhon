# EXPECT-WARN: tyc::contains_secret_literal
#
# `comptime let` is evaluated at *build* time and inlined into the emitted
# `.py` as a literal — so this bakes the resolved API key straight into the
# build artifact, where it lands in source control, container images, and
# stack traces. The lint matches names shaped like `*KEY`, `*TOKEN`,
# `*PASSWORD`, `*SECRET`, `*PASS`, `*PWD`, plus the squashed-acronym forms
# (`APIKEY`, `APITOKEN`, `APISECRET`, …) added in v1.0.0-alpha.6.
#
# Fix: read it at *runtime* — `os.environ["API_KEY"]`. Silence the lint with
# `[strictness] allow-secret-comptime = true` only when the value is genuinely
# not a secret.


comptime let API_KEY: str = env("API_KEY", "dev-placeholder")
comptime let DB_PASSWORD: str = env("DB_PASSWORD", "hunter2")


def main() -> None:
    print(len(API_KEY), len(DB_PASSWORD))


main()
