# FALSE-POSITIVE: this program is valid and returns on every path.
# EXPECT-ERROR: tyc::missing_return
#
# A `try` statement's `else:` clause runs when the `try` block completed
# without raising — it is the canonical place to put the success path, and
# CPython guarantees exactly one of `except`/`else` runs. Here every arm
# returns, so `attempt` cannot fall off the end.
#
# The checker's reachability analysis does not count the `else:` arm's return,
# so it reports `tyc::missing_return`. Narrow: `try`/`except` alone and
# `try`/`except`/`finally` are both handled correctly — only the `else:` form
# trips it.
#
#     try/except            ✅ accepted
#     try/except/finally    ✅ accepted
#     try/except/else       ❌ tyc::missing_return
#     try/except/else/finally ❌ tyc::missing_return
#
# Workaround until fixed: move the `else:` body to the end of the `try:` block.


def attempt(n: int) -> str:
    try:
        let v: int = 10 // n
    except ZeroDivisionError:
        return "divide by zero"
    else:
        return f"ok {v}"


def main() -> None:
    print(attempt(2), attempt(0))


main()
