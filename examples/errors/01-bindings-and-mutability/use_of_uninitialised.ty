# EXPECT-ERROR: tyc::use_of_uninitialised
#
# A declare-only `let NAME: T` is legal (v0.7.0), but every non-diverging path
# to a *read* must have assigned it first. Here the `else` branch falls through
# without assigning, so `chosen` is read uninitialised whenever `n <= 0`.
#
# Fix: add an `else: chosen = "none"` arm, or initialise at the declaration.


def pick(n: int) -> str:
    let chosen: str
    if n > 0:
        chosen = "positive"
    return chosen


def main() -> None:
    print(pick(1))


main()
