lazy import torch = torch
lazy import nn = torch.nn
lazy import F = torch.nn.functional


class MLP:
    layers: nn.Sequential


impl MLP:
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.layers(x)

    def parameters(self) -> object:
        return self.layers.parameters()


def make_mlp(in_dim: int, hidden: int, out_dim: int, dropout: float = 0.2) -> MLP:
    let layers: nn.Sequential = nn.Sequential(
        nn.Linear(in_dim, hidden),
        nn.ReLU(),
        nn.Dropout(dropout),
        nn.Linear(hidden, hidden),
        nn.ReLU(),
        nn.Linear(hidden, out_dim),
    )
    return MLP(layers=layers)


class SimpleCNN:
    features: nn.Sequential
    head: nn.Linear


impl SimpleCNN:
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        let feats: torch.Tensor = self.features(x)
        return self.head(feats.flatten(1))


def make_cnn(n_classes: int = 10) -> SimpleCNN:
    let features: nn.Sequential = nn.Sequential(
        nn.Conv2d(1, 16, kernel_size=3, padding=1),
        nn.ReLU(),
        nn.MaxPool2d(2, 2),
        nn.Conv2d(16, 32, kernel_size=3, padding=1),
        nn.ReLU(),
        nn.MaxPool2d(2, 2),
    )
    let head: nn.Linear = nn.Linear(32 * 7 * 7, n_classes)
    return SimpleCNN(features=features, head=head)


def count_params(layers: nn.Sequential) -> int:
    return sum(int(p.numel()) for p in layers.parameters() if p.requires_grad)


def initialise_kaiming(seq: nn.Sequential) -> None:
    for m in seq.modules():
        if isinstance(m, nn.Linear) or isinstance(m, nn.Conv2d):
            nn.init.kaiming_normal_(m.weight, nonlinearity="relu")
            if m.bias is not None:
                nn.init.zeros_(m.bias)


def main() -> None:
    let mlp: MLP = make_mlp(in_dim=20, hidden=64, out_dim=3)
    initialise_kaiming(mlp.layers)
    print(f"mlp params: {count_params(mlp.layers)}")

    let dummy: torch.Tensor = torch.randn(4, 20)
    let mlp_out: torch.Tensor = mlp.forward(dummy)
    print(f"mlp output shape: {mlp_out.shape}")

    let cnn: SimpleCNN = make_cnn(n_classes=10)
    initialise_kaiming(cnn.features)
    nn.init.kaiming_normal_(cnn.head.weight, nonlinearity="relu")
    nn.init.zeros_(cnn.head.bias)

    let img: torch.Tensor = torch.randn(2, 1, 28, 28)
    let logits: torch.Tensor = cnn.forward(img)
    print(f"cnn output shape: {logits.shape}")
    print(f"softmax row 0:   {F.softmax(logits, dim=1)[0]}")


if __name__ == "__main__":
    main()
