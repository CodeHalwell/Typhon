from source import Span


pub type Token = TkInt | TkFloat | TkStr | TkIdent | TkKeyword | TkOp | TkPunct | TkArrow | TkEof


pub class TkInt:
    value: int
    span: Span


pub class TkFloat:
    value: float
    span: Span


pub class TkStr:
    value: str
    span: Span


pub class TkIdent:
    name: str
    span: Span


pub class TkKeyword:
    word: str
    span: Span


pub class TkOp:
    op: str
    span: Span


pub class TkPunct:
    ch: str
    span: Span


pub class TkArrow:
    span: Span


pub class TkEof:
    span: Span


# Factories — required because variant→union upcast fails across module
# boundaries (TYPHON_FEEDBACK.md #1). Every call site outside this module
# constructs Tokens via these helpers and gets back a `Token`.

pub def make_tk_int(value: int, span: Span) -> Token:
    return TkInt(value=value, span=span)


pub def make_tk_float(value: float, span: Span) -> Token:
    return TkFloat(value=value, span=span)


pub def make_tk_str(value: str, span: Span) -> Token:
    return TkStr(value=value, span=span)


pub def make_tk_ident(name: str, span: Span) -> Token:
    return TkIdent(name=name, span=span)


pub def make_tk_keyword(word: str, span: Span) -> Token:
    return TkKeyword(word=word, span=span)


pub def make_tk_op(op: str, span: Span) -> Token:
    return TkOp(op=op, span=span)


pub def make_tk_punct(ch: str, span: Span) -> Token:
    return TkPunct(ch=ch, span=span)


pub def make_tk_arrow(span: Span) -> Token:
    return TkArrow(span=span)


pub def make_tk_eof(span: Span) -> Token:
    return TkEof(span=span)


pub def token_label(t: Token) -> str:
    match t:
        case TkInt(v, _):     return f"int({v})"
        case TkFloat(v, _):   return f"float({v})"
        case TkStr(v, _):     return f"str({v!r})"
        case TkIdent(n, _):   return f"ident({n})"
        case TkKeyword(w, _): return f"keyword({w})"
        case TkOp(op, _):     return f"op({op})"
        case TkPunct(c, _):   return f"punct({c})"
        case TkArrow(_):      return "arrow(->)"
        case TkEof(_):        return "eof"
    raise RuntimeError("unreachable")


pub def token_span(t: Token) -> Span:
    match t:
        case TkInt(_, sp_i):     return sp_i
        case TkFloat(_, sp_f):   return sp_f
        case TkStr(_, sp_s):     return sp_s
        case TkIdent(_, sp_id):  return sp_id
        case TkKeyword(_, sp_k): return sp_k
        case TkOp(_, sp_o):      return sp_o
        case TkPunct(_, sp_p):   return sp_p
        case TkArrow(sp_a):      return sp_a
        case TkEof(sp_e):        return sp_e
    raise RuntimeError("unreachable")


# Reserved keywords — also handy in the lexer.
pub let KEYWORDS: list[str] = [
    "let", "fun", "if", "then", "else", "print", "true", "false",
]


pub def is_keyword(s: str) -> bool:
    return s in KEYWORDS
