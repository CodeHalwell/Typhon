from lang_ast import (
    ExBinOp,
    ExBlock,
    ExBool,
    ExCall,
    ExFloat,
    ExFn,
    ExIdent,
    ExIf,
    ExInt,
    ExLet,
    ExPrint,
    ExStr,
    ExUnary,
    Expr,
    expr_span,
)
from source import Span
from values import (
    Env,
    VBool,
    VFloat,
    VFn,
    VInt,
    VStr,
    Value,
    empty_env,
    make_v_bool,
    make_v_float,
    make_v_fn,
    make_v_int,
    make_v_str,
    make_v_unit,
    value_label,
    value_to_str,
)


pub class EvalError:
    message: str
    span: Span


def _eerr(message: str, span: Span) -> EvalError:
    return EvalError(message=message, span=span)


def _as_number(v: Value) -> float?:
    match v:
        case VInt(iv):   return float(iv)
        case VFloat(fv): return fv
        case _:          return None
    raise RuntimeError("unreachable")


def _is_int(v: Value) -> bool:
    match v:
        case VInt(_): return True
        case _:       return False
    raise RuntimeError("unreachable")


def _str_of(v: Value) -> str?:
    match v:
        case VStr(sv): return sv
        case _:        return None
    raise RuntimeError("unreachable")


def _eval_binop(op: str, lv: Value, rv: Value, span: Span) -> Result[Value, EvalError]:
    # String concat
    if op == "+":
        let ls_opt: str? = _str_of(lv)
        let rs_opt: str? = _str_of(rv)
        if ls_opt is not None and rs_opt is not None:
            let ls: str = ls_opt
            let rs: str = rs_opt
            return Ok(value=make_v_str(ls + rs))
        if ls_opt is not None or rs_opt is not None:
            return Err(error=_eerr(
                f"cannot add {value_label(lv)} and {value_label(rv)}", span,
            ))

    let ln_opt: float? = _as_number(lv)
    let rn_opt: float? = _as_number(rv)

    if op == "+" or op == "-" or op == "*" or op == "/":
        if ln_opt is None or rn_opt is None:
            return Err(error=_eerr(
                f"operator '{op}' requires numbers, got {value_label(lv)} and {value_label(rv)}",
                span,
            ))
        let ln: float = ln_opt
        let rn: float = rn_opt
        if op == "/":
            if rn == 0.0:
                return Err(error=_eerr("division by zero", span))
            return Ok(value=make_v_float(ln / rn))
        let both_int: bool = _is_int(lv) and _is_int(rv)
        if op == "+":
            if both_int:
                return Ok(value=make_v_int(int(ln) + int(rn)))
            return Ok(value=make_v_float(ln + rn))
        if op == "-":
            if both_int:
                return Ok(value=make_v_int(int(ln) - int(rn)))
            return Ok(value=make_v_float(ln - rn))
        # op == "*"
        if both_int:
            return Ok(value=make_v_int(int(ln) * int(rn)))
        return Ok(value=make_v_float(ln * rn))

    if op == "<" or op == ">" or op == "<=" or op == ">=":
        if ln_opt is None or rn_opt is None:
            return Err(error=_eerr(
                f"operator '{op}' requires numbers, got {value_label(lv)} and {value_label(rv)}",
                span,
            ))
        let ln_c: float = ln_opt
        let rn_c: float = rn_opt
        if op == "<":  return Ok(value=make_v_bool(ln_c < rn_c))
        if op == ">":  return Ok(value=make_v_bool(ln_c > rn_c))
        if op == "<=": return Ok(value=make_v_bool(ln_c <= rn_c))
        return Ok(value=make_v_bool(ln_c >= rn_c))

    if op == "==" or op == "!=":
        let eq: bool = _values_equal(lv, rv)
        if op == "==":
            return Ok(value=make_v_bool(eq))
        return Ok(value=make_v_bool(not eq))

    return Err(error=_eerr(f"unknown operator '{op}'", span))


def _values_equal(a: Value, b: Value) -> bool:
    match a:
        case VInt(av_i):
            match b:
                case VInt(bv_i):    return av_i == bv_i
                case VFloat(bv_f1): return float(av_i) == bv_f1
                case _:             return False
            raise RuntimeError("unreachable")
        case VFloat(av_f):
            match b:
                case VInt(bv_i2):   return av_f == float(bv_i2)
                case VFloat(bv_f2): return av_f == bv_f2
                case _:             return False
            raise RuntimeError("unreachable")
        case VStr(av_s):
            match b:
                case VStr(bv_s):    return av_s == bv_s
                case _:             return False
            raise RuntimeError("unreachable")
        case VBool(av_b):
            match b:
                case VBool(bv_b):   return av_b == bv_b
                case _:             return False
            raise RuntimeError("unreachable")
        case _:
            return False
    raise RuntimeError("unreachable")


def _truthy_as_bool(v: Value, span: Span) -> Result[bool, EvalError]:
    match v:
        case VBool(bv):
            return Ok(value=bv)
        case _:
            return Err(error=_eerr(
                f"condition must be bool, got {value_label(v)}", span,
            ))
    raise RuntimeError("unreachable")


pub def eval_expr(expr: Expr, env: Env) -> Result[Value, EvalError]:
    match expr:
        case ExInt(iv, _):
            return Ok(value=make_v_int(iv))
        case ExFloat(fv, _):
            return Ok(value=make_v_float(fv))
        case ExStr(sv, _):
            return Ok(value=make_v_str(sv))
        case ExBool(bv, _):
            return Ok(value=make_v_bool(bv))
        case ExIdent(nm, sp_id):
            let found: Value? = env.lookup(nm)
            if found is None:
                return Err(error=_eerr(f"unbound identifier '{nm}'", sp_id))
            return Ok(value=found)
        case ExBinOp(op, left, right, sp_bin):
            let lv: Value = eval_expr(left, env)?
            let rv: Value = eval_expr(right, env)?
            return _eval_binop(op, lv, rv, sp_bin)
        case ExUnary(uop, operand, sp_un):
            let ov: Value = eval_expr(operand, env)?
            if uop == "-":
                match ov:
                    case VInt(iv):   return Ok(value=make_v_int(-iv))
                    case VFloat(fv): return Ok(value=make_v_float(-fv))
                    case _:
                        return Err(error=_eerr(
                            f"unary '-' requires number, got {value_label(ov)}", sp_un,
                        ))
                raise RuntimeError("unreachable")
            return Err(error=_eerr(f"unknown unary operator '{uop}'", sp_un))
        case ExCall(callee, args, sp_call):
            let callee_v: Value = eval_expr(callee, env)?
            match callee_v:
                case VFn(params, body, closure):
                    if len(args) != len(params):
                        return Err(error=_eerr(
                            f"arity mismatch: expected {len(params)}, got {len(args)}",
                            sp_call,
                        ))
                    mut call_env: Env = closure
                    mut i: int = 0
                    while i < len(args):
                        let arg_v: Value = eval_expr(args[i], env)?
                        call_env = call_env.with_binding(params[i].name, arg_v)
                        i = i + 1
                    return eval_expr(body, call_env)
                case _:
                    return Err(error=_eerr(
                        f"cannot call non-function value ({value_label(callee_v)})",
                        sp_call,
                    ))
            raise RuntimeError("unreachable")
        case ExIf(cond, then_branch, else_branch, _sp_if):
            let cv: Value = eval_expr(cond, env)?
            let b: bool = _truthy_as_bool(cv, expr_span(cond))?
            if b:
                return eval_expr(then_branch, env)
            return eval_expr(else_branch, env)
        case ExLet(name, value, body, _sp_let):
            let bound: Value = eval_expr(value, env)?
            let child: Env = env.with_binding(name, bound)
            return eval_expr(body, child)
        case ExFn(params, _ret, body, _sp_fn):
            return Ok(value=make_v_fn(params, body, env))
        case ExBlock(exprs, _sp_blk):
            if len(exprs) == 0:
                return Ok(value=make_v_unit())
            mut block_env: Env = env
            mut last_v: Value = make_v_unit()
            mut idx_b: int = 0
            while idx_b < len(exprs):
                let sub: Expr = exprs[idx_b]
                match sub:
                    case ExLet(ln, lv, _lb, _lsp):
                        let bound_b: Value = eval_expr(lv, block_env)?
                        block_env = block_env.with_binding(ln, bound_b)
                        last_v = make_v_unit()
                    case _:
                        last_v = eval_expr(sub, block_env)?
                idx_b = idx_b + 1
            return Ok(value=last_v)
        case ExPrint(arg, _sp_pr):
            let av: Value = eval_expr(arg, env)?
            print(value_to_str(av))
            return Ok(value=make_v_unit())
    raise RuntimeError("unreachable")


pub def eval_program(expr: Expr) -> Result[Value, EvalError]:
    let env: Env = empty_env()
    return eval_expr(expr, env)
