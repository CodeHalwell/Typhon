from source import Source, Span, line_col_at, make_span
from tokens import (
    Token,
    is_keyword,
    make_tk_arrow,
    make_tk_eof,
    make_tk_float,
    make_tk_ident,
    make_tk_int,
    make_tk_keyword,
    make_tk_op,
    make_tk_punct,
    make_tk_str,
)


pub class LexError:
    message: str
    span: Span


def _is_digit(ch: str) -> bool:
    return ch >= "0" and ch <= "9"


def _is_alpha(ch: str) -> bool:
    return (ch >= "a" and ch <= "z") or (ch >= "A" and ch <= "Z") or ch == "_"


def _is_alnum(ch: str) -> bool:
    return _is_alpha(ch) or _is_digit(ch)


def _span(text: str, start: int, end: int) -> Span:
    let lc: tuple[int, int] = line_col_at(text, start)
    return make_span(start, end, lc[0], lc[1])


pub def tokenize(source: Source) -> Result[list[Token], LexError]:
    let text: str = source.text
    let n: int = len(text)
    mut tokens: list[Token] = []
    mut i: int = 0

    while i < n:
        let ch: str = text[i]

        # Whitespace
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r":
            i = i + 1
            continue

        # Line comment
        if ch == "#":
            while i < n and text[i] != "\n":
                i = i + 1
            continue

        # Number (int or float)
        if _is_digit(ch):
            let start_n: int = i
            while i < n and _is_digit(text[i]):
                i = i + 1
            if i < n and text[i] == "." and i + 1 < n and _is_digit(text[i + 1]):
                i = i + 1
                while i < n and _is_digit(text[i]):
                    i = i + 1
                let raw_f: str = text[start_n:i]
                tokens.append(make_tk_float(float(raw_f), _span(text, start_n, i)))
            else:
                let raw_i: str = text[start_n:i]
                tokens.append(make_tk_int(int(raw_i), _span(text, start_n, i)))
            continue

        # Identifier / keyword
        if _is_alpha(ch):
            let start_id: int = i
            while i < n and _is_alnum(text[i]):
                i = i + 1
            let word: str = text[start_id:i]
            let sp_id: Span = _span(text, start_id, i)
            if is_keyword(word):
                tokens.append(make_tk_keyword(word, sp_id))
            else:
                tokens.append(make_tk_ident(word, sp_id))
            continue

        # String literal
        if ch == "\"":
            let start_s: int = i
            i = i + 1
            mut buf: str = ""
            mut closed: bool = False
            while i < n:
                let sc: str = text[i]
                if sc == "\"":
                    closed = True
                    i = i + 1
                    break
                buf = buf + sc
                i = i + 1
            if not closed:
                return Err(error=LexError(
                    message="unterminated string literal",
                    span=_span(text, start_s, i),
                ))
            tokens.append(make_tk_str(buf, _span(text, start_s, i)))
            continue

        # Two-char operators
        if i + 1 < n:
            let two: str = text[i:i + 2]
            if two == "<=" or two == ">=" or two == "==" or two == "!=":
                tokens.append(make_tk_op(two, _span(text, i, i + 2)))
                i = i + 2
                continue
            if two == "->":
                tokens.append(make_tk_arrow(_span(text, i, i + 2)))
                i = i + 2
                continue

        # Single-char operators (and `=` used by `let` bindings)
        if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "<" or ch == ">" or ch == "=":
            tokens.append(make_tk_op(ch, _span(text, i, i + 1)))
            i = i + 1
            continue

        # Punctuation
        if ch == "(" or ch == ")" or ch == "{" or ch == "}" or ch == "," or ch == ":" or ch == ";":
            tokens.append(make_tk_punct(ch, _span(text, i, i + 1)))
            i = i + 1
            continue

        return Err(error=LexError(
            message=f"unexpected character: {ch!r}",
            span=_span(text, i, i + 1),
        ))

    tokens.append(make_tk_eof(_span(text, n, n)))
    return Ok(value=tokens)
