from source import Span


pub type Expr = ExInt | ExFloat | ExStr | ExBool | ExIdent | ExBinOp | ExUnary | ExCall | ExIf | ExLet | ExFn | ExBlock | ExPrint


pub class ExInt:
    value: int
    span: Span


pub class ExFloat:
    value: float
    span: Span


pub class ExStr:
    value: str
    span: Span


pub class ExBool:
    value: bool
    span: Span


pub class ExIdent:
    name: str
    span: Span


pub class ExBinOp:
    op: str
    left: Expr
    right: Expr
    span: Span


pub class ExUnary:
    op: str
    operand: Expr
    span: Span


pub class ExCall:
    callee: Expr
    args: list[Expr]
    span: Span


pub class ExIf:
    cond: Expr
    then_branch: Expr
    else_branch: Expr
    span: Span


pub class ExLet:
    name: str
    value: Expr
    body: Expr
    span: Span


pub class Param frozen:
    name: str
    type_annot: str


pub class ExFn:
    params: list[Param]
    ret_type: str
    body: Expr
    span: Span


pub class ExBlock:
    exprs: list[Expr]
    span: Span


pub class ExPrint:
    arg: Expr
    span: Span


# Factories — variant→union cross-module upcast fails. Every Expr
# construction outside this module routes through one of these.

pub def make_ex_int(value: int, span: Span) -> Expr:
    return ExInt(value=value, span=span)


pub def make_ex_float(value: float, span: Span) -> Expr:
    return ExFloat(value=value, span=span)


pub def make_ex_str(value: str, span: Span) -> Expr:
    return ExStr(value=value, span=span)


pub def make_ex_bool(value: bool, span: Span) -> Expr:
    return ExBool(value=value, span=span)


pub def make_ex_ident(name: str, span: Span) -> Expr:
    return ExIdent(name=name, span=span)


pub def make_ex_binop(op: str, left: Expr, right: Expr, span: Span) -> Expr:
    return ExBinOp(op=op, left=left, right=right, span=span)


pub def make_ex_unary(op: str, operand: Expr, span: Span) -> Expr:
    return ExUnary(op=op, operand=operand, span=span)


pub def make_ex_call(callee: Expr, args: list[Expr], span: Span) -> Expr:
    return ExCall(callee=callee, args=args, span=span)


pub def make_ex_if(cond: Expr, then_branch: Expr, else_branch: Expr, span: Span) -> Expr:
    return ExIf(cond=cond, then_branch=then_branch, else_branch=else_branch, span=span)


pub def make_ex_let(name: str, value: Expr, body: Expr, span: Span) -> Expr:
    return ExLet(name=name, value=value, body=body, span=span)


pub def make_param(name: str, type_annot: str) -> Param:
    return Param(name=name, type_annot=type_annot)


pub def make_ex_fn(params: list[Param], ret_type: str, body: Expr, span: Span) -> Expr:
    return ExFn(params=params, ret_type=ret_type, body=body, span=span)


pub def make_ex_block(exprs: list[Expr], span: Span) -> Expr:
    return ExBlock(exprs=exprs, span=span)


pub def make_ex_print(arg: Expr, span: Span) -> Expr:
    return ExPrint(arg=arg, span=span)


pub def expr_span(e: Expr) -> Span:
    match e:
        case ExInt(_, sp_int):              return sp_int
        case ExFloat(_, sp_flt):            return sp_flt
        case ExStr(_, sp_str):              return sp_str
        case ExBool(_, sp_bool):            return sp_bool
        case ExIdent(_, sp_id):             return sp_id
        case ExBinOp(_, _, _, sp_bin):      return sp_bin
        case ExUnary(_, _, sp_un):          return sp_un
        case ExCall(_, _, sp_call):         return sp_call
        case ExIf(_, _, _, sp_if):          return sp_if
        case ExLet(_, _, _, sp_let):        return sp_let
        case ExFn(_, _, _, sp_fn):          return sp_fn
        case ExBlock(_, sp_blk):            return sp_blk
        case ExPrint(_, sp_print):          return sp_print
    raise RuntimeError("unreachable")


pub def expr_label(e: Expr) -> str:
    match e:
        case ExInt(_, _):           return "ExInt"
        case ExFloat(_, _):         return "ExFloat"
        case ExStr(_, _):           return "ExStr"
        case ExBool(_, _):          return "ExBool"
        case ExIdent(_, _):         return "ExIdent"
        case ExBinOp(_, _, _, _):   return "ExBinOp"
        case ExUnary(_, _, _):      return "ExUnary"
        case ExCall(_, _, _):       return "ExCall"
        case ExIf(_, _, _, _):      return "ExIf"
        case ExLet(_, _, _, _):     return "ExLet"
        case ExFn(_, _, _, _):      return "ExFn"
        case ExBlock(_, _):         return "ExBlock"
        case ExPrint(_, _):         return "ExPrint"
    raise RuntimeError("unreachable")
