from datetime import datetime

from .ids import LobbyId, MatchId, PlayerId, Rating, RoomId


# Sealed-union event log for room/lobby state transitions.
pub type GameEvent = (
    EvPlayerJoined
    | EvPlayerLeft
    | EvMatchStarted
    | EvMatchTick
    | EvMatchEnded
    | EvRoomClosed
    | EvRatingUpdated
)


pub class EvPlayerJoined:
    room: RoomId
    player: PlayerId
    at: datetime


pub class EvPlayerLeft:
    room: RoomId
    player: PlayerId
    reason: str
    at: datetime


pub class EvMatchStarted:
    match_id: MatchId
    room: RoomId
    mode: str
    player_count: int
    at: datetime


pub class EvMatchTick:
    match_id: MatchId
    room: RoomId
    tick: int
    alive_count: int
    at: datetime


pub class EvMatchEnded:
    match_id: MatchId
    room: RoomId
    winner: PlayerId?
    duration_ticks: int
    at: datetime


pub class EvRoomClosed:
    room: RoomId
    final_match: MatchId?
    at: datetime


pub class EvRatingUpdated:
    match_id: MatchId
    player: PlayerId
    before: Rating
    after: Rating
    at: datetime


# Factory functions live in the union's own module (R1-1 workaround).
# Lobby-level aggregate stream wraps GameEvent with the originating lobby.
pub class LobbyStreamEntry:
    lobby: LobbyId
    seq: int
    event: GameEvent


pub def event_kind(ev: GameEvent) -> str:
    match ev:
        case EvPlayerJoined(_, _, _):       return "player.joined"
        case EvPlayerLeft(_, _, _, _):      return "player.left"
        case EvMatchStarted(_, _, _, _, _): return "match.started"
        case EvMatchTick(_, _, _, _, _):    return "match.tick"
        case EvMatchEnded(_, _, _, _, _):   return "match.ended"
        case EvRoomClosed(_, _, _):         return "room.closed"
        case EvRatingUpdated(_, _, _, _, _): return "rating.updated"
    raise RuntimeError("unreachable")


pub def event_room(ev: GameEvent) -> RoomId?:
    match ev:
        case EvPlayerJoined(r, _, _):       return r
        case EvPlayerLeft(r, _, _, _):      return r
        case EvMatchStarted(_, r, _, _, _): return r
        case EvMatchTick(_, r, _, _, _):    return r
        case EvMatchEnded(_, r, _, _, _):   return r
        case EvRoomClosed(r, _, _):         return r
        case EvRatingUpdated(_, _, _, _, _): return None
    raise RuntimeError("unreachable")


pub def event_player(ev: GameEvent) -> PlayerId?:
    match ev:
        case EvPlayerJoined(_, p, _):           return p
        case EvPlayerLeft(_, p, _, _):          return p
        case EvMatchStarted(_, _, _, _, _):     return None
        case EvMatchTick(_, _, _, _, _):        return None
        case EvMatchEnded(_, _, w, _, _):       return w
        case EvRoomClosed(_, _, _):             return None
        case EvRatingUpdated(_, p, _, _, _):    return p
    raise RuntimeError("unreachable")


pub def event_message(ev: GameEvent) -> str:
    match ev:
        case EvPlayerJoined(r, p, _):
            return f"player {int(p)} joined room {int(r)}"
        case EvPlayerLeft(r, p, reason, _):
            return f"player {int(p)} left room {int(r)}: {reason}"
        case EvMatchStarted(_, r, mode, n, _):
            return f"match starting on room {int(r)} mode={mode} players={n}"
        case EvMatchTick(_, _, t, alive, _):
            return f"tick {t} alive={alive}"
        case EvMatchEnded(_, r, w, dur, _):
            let who: str = str(int(w)) if w is not None else "(none)"
            return f"match ended on room {int(r)} winner={who} after {dur} ticks"
        case EvRoomClosed(r, _, _):
            return f"room {int(r)} closed"
        case EvRatingUpdated(_, p, before, after, _):
            return f"player {int(p)} rating {int(before)} -> {int(after)}"
    raise RuntimeError("unreachable")


pub def event_at(ev: GameEvent) -> datetime:
    match ev:
        case EvPlayerJoined(_, _, t):           return t
        case EvPlayerLeft(_, _, _, t):          return t
        case EvMatchStarted(_, _, _, _, t):     return t
        case EvMatchTick(_, _, _, _, t):        return t
        case EvMatchEnded(_, _, _, _, t):       return t
        case EvRoomClosed(_, _, t):             return t
        case EvRatingUpdated(_, _, _, _, t):    return t
    raise RuntimeError("unreachable")
