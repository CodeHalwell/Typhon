import asyncio
from pathlib import Path

from fastapi import FastAPI, HTTPException

from config import ServerConfig, game_version, load_config
from events import GameEvent, event_kind, event_message, event_at
from ids import LobbyId, PlayerId, RoomId, SessionToken
from lobby import Lobby, new_lobby
from modes import all_modes
from profiles import (
    PlayerProfile,
    ProfileStore,
    open_store,
)
from registry import (
    ConnectionRegistry,
    new_registry,
)
from rooms import Room, room_state_label


# ---- HTTP request/response models ------------------------------------------

pub model RegisterRequest:
    name: str


pub model RegisterResponse:
    player_id: int
    name: str
    rating: int
    session_token: str


pub model QueueRequest:
    session_token: str
    mode: str


pub model QueueResponse:
    queued: bool
    mode: str
    position: int


pub model PlayerProfileView:
    id: int
    name: str
    rating: int
    wins: int
    losses: int
    draws: int
    matches_played: int


pub model LeaderboardEntryView:
    id: int
    name: str
    rating: int
    wins: int
    losses: int


pub model LeaderboardResponse:
    entries: list[LeaderboardEntryView]


pub model RoomView:
    id: int
    mode: str
    state: str
    player_count: int


pub model RoomsResponse:
    rooms: list[RoomView]


pub model QueueSummaryResponse:
    queues: dict[str, int]
    version: str


pub model EventView:
    seq: int
    kind: str
    message: str
    at: str


pub model EventsResponse:
    events: list[EventView]


pub model MatchHistoryEntryView:
    match_id: int
    mode: str
    placement: int
    rating_before: int
    rating_after: int
    ended_at: str


pub model MatchHistoryResponse:
    player_id: int
    entries: list[MatchHistoryEntryView]


pub model RecentMatchView:
    match_id: int
    mode: str
    room_id: int
    winner_id: int?
    duration: int
    ended_at: str


pub model RecentMatchesResponse:
    matches: list[RecentMatchView]


# ---- App state -------------------------------------------------------------

pub class AppState:
    config: ServerConfig
    store: ProfileStore
    registry: ConnectionRegistry
    lobby: Lobby


def _open_store_or_raise(path: Path) -> ProfileStore:
    match open_store(path):
        case Ok(store):
            return store
        case Err(e):
            raise RuntimeError(f"{e.op}: {e.reason}")
    raise RuntimeError("unreachable")


pub def build_state() -> AppState:
    let cfg: ServerConfig = load_config()
    let store: ProfileStore = _open_store_or_raise(Path(cfg.db_path))
    let modes = all_modes()
    let lobby: Lobby = new_lobby(LobbyId(1), modes, store)
    return AppState(
        config=cfg,
        store=store,
        registry=new_registry(),
        lobby=lobby,
    )


pub let STATE: AppState = build_state()
pub let app: FastAPI = FastAPI(title="Typhon Realtime Game Server")


def _profile_to_view(p: PlayerProfile) -> PlayerProfileView:
    return PlayerProfileView(
        id=int(p.id),
        name=p.name,
        rating=int(p.rating),
        wins=p.wins,
        losses=p.losses,
        draws=p.draws,
        matches_played=p.matches_played,
    )


def _room_to_view(r: Room) -> RoomView:
    return RoomView(
        id=int(r.id),
        mode=r.mode.name,
        state=room_state_label(r.state),
        player_count=len(r.players),
    )


def _event_to_view(seq: int, ev: GameEvent) -> EventView:
    return EventView(
        seq=seq,
        kind=event_kind(ev),
        message=event_message(ev),
        at=event_at(ev).isoformat(),
    )


@app.post("/players/register", response_model=RegisterResponse)
def register_player(req: RegisterRequest) -> RegisterResponse:
    match STATE.store.upsert(req.name):
        case Ok(profile):
            match STATE.registry.open(profile.id):
                case Ok(session):
                    return RegisterResponse(
                        player_id=int(profile.id),
                        name=profile.name,
                        rating=int(profile.rating),
                        session_token=str(session.token),
                    )
                case Err(_):
                    raise HTTPException(status_code=409, detail="session already open")
        case Err(e):
            raise HTTPException(status_code=500, detail=f"{e.op}: {e.reason}")
    raise RuntimeError("unreachable")


@app.post("/lobby/queue", response_model=QueueResponse)
def queue_player(req: QueueRequest) -> QueueResponse:
    let tok: SessionToken = SessionToken(req.session_token)
    match STATE.registry.resume(tok):
        case Ok(session):
            match STATE.store.fetch(session.player):
                case Ok(profile):
                    match STATE.lobby.enqueue(req.mode, profile):
                        case Ok(_):
                            return QueueResponse(
                                queued=True,
                                mode=req.mode,
                                position=STATE.lobby.queue_size(req.mode),
                            )
                        case Err(msg):
                            raise HTTPException(status_code=400, detail=msg)
                case Err(_):
                    raise HTTPException(status_code=404, detail="profile not found")
        case Err(_):
            raise HTTPException(status_code=401, detail="invalid session")
    raise RuntimeError("unreachable")


@app.delete("/lobby/queue/{player_id}")
def dequeue_player(player_id: int) -> dict[str, object]:
    let pid: PlayerId = PlayerId(player_id)
    let removed: bool = STATE.lobby.dequeue(pid)
    return {"removed": removed}


@app.get("/players/{player_id}", response_model=PlayerProfileView)
def get_player(player_id: int) -> PlayerProfileView:
    match STATE.store.fetch(PlayerId(player_id)):
        case Ok(profile):
            return _profile_to_view(profile)
        case Err(_):
            raise HTTPException(status_code=404, detail="player not found")
    raise RuntimeError("unreachable")


@app.get("/players/{player_id}/history", response_model=MatchHistoryResponse)
def get_player_history(player_id: int, limit: int = 20) -> MatchHistoryResponse:
    let rows = STATE.store.player_match_history(PlayerId(player_id), limit)
    mut entries: list[MatchHistoryEntryView] = []
    for r in rows:
        entries.append(MatchHistoryEntryView(
            match_id=r[0],
            mode=r[1],
            placement=r[2],
            rating_before=r[3],
            rating_after=r[4],
            ended_at=r[5],
        ))
    return MatchHistoryResponse(player_id=player_id, entries=entries)


@app.get("/leaderboard", response_model=LeaderboardResponse)
def get_leaderboard(limit: int = 10) -> LeaderboardResponse:
    let rows = STATE.store.leaderboard(limit)
    mut entries: list[LeaderboardEntryView] = []
    for e in rows:
        entries.append(LeaderboardEntryView(
            id=int(e.id),
            name=e.name,
            rating=int(e.rating),
            wins=e.wins,
            losses=e.losses,
        ))
    return LeaderboardResponse(entries=entries)


@app.get("/rooms", response_model=RoomsResponse)
def get_rooms() -> RoomsResponse:
    mut out: list[RoomView] = []
    for r in STATE.lobby.list_rooms():
        out.append(_room_to_view(r))
    return RoomsResponse(rooms=out)


@app.get("/rooms/{room_id}", response_model=RoomView)
def get_room(room_id: int) -> RoomView:
    let room_opt: Room? = STATE.lobby.get_room(RoomId(room_id))
    if room_opt is None:
        raise HTTPException(status_code=404, detail="room not found")
    return _room_to_view(room_opt)


@app.get("/lobbies", response_model=QueueSummaryResponse)
def get_lobbies() -> QueueSummaryResponse:
    return QueueSummaryResponse(
        queues=STATE.lobby.queue_summary(),
        version=game_version(),
    )


@app.get("/events", response_model=EventsResponse)
def get_events(since: int = 0, limit: int = 100) -> EventsResponse:
    let entries = STATE.lobby.stream_since(since, limit)
    mut out: list[EventView] = []
    for entry in entries:
        out.append(_event_to_view(entry.seq, entry.event))
    return EventsResponse(events=out)


@app.get("/matches/recent", response_model=RecentMatchesResponse)
def recent_matches(limit: int = 20) -> RecentMatchesResponse:
    let rows = STATE.store.recent_matches(limit)
    mut out: list[RecentMatchView] = []
    for r in rows:
        out.append(RecentMatchView(
            match_id=r[0],
            mode=r[1],
            room_id=r[2],
            winner_id=r[3],
            duration=r[4],
            ended_at=r[5],
        ))
    return RecentMatchesResponse(matches=out)


@app.get("/health")
def health() -> dict[str, object]:
    return {
        "ok": True,
        "version": game_version(),
        "rooms": len(STATE.lobby.list_rooms()),
        "sessions": len(STATE.registry.active_sessions()),
    }


pub async def warm_state() -> dict[str, int]:
    # Parallel I/O example using `gather:` for independent reads.
    gather:
        leaderboard = asyncio.to_thread(STATE.store.leaderboard, 5)
        recent = asyncio.to_thread(STATE.store.recent_matches, 5)
    return {
        "leaderboard_size": len(leaderboard),
        "recent_size": len(recent),
    }
