from ids import ClientReqId, LogIndex, NodeId, Term
from log import (
    CmdSet,
    Command,
    LogEntry,
    ReplicatedLog,
    new_log,
)
from rpc import (
    Message,
    MsgAppendEntries,
    MsgAppendEntriesReply,
    MsgClientGet,
    MsgClientPut,
    MsgClientReply,
    MsgRequestVote,
    MsgRequestVoteReply,
    make_append_entries,
    make_append_entries_reply,
    make_client_reply,
    make_request_vote,
    make_request_vote_reply,
)
from state import (
    Role,
    RoleCandidate,
    RoleFollower,
    RoleLeader,
    make_candidate,
    make_follower,
    make_leader,
)
from store import KVStore, new_store


# Timing constants (seconds). Election timeout = base + per-node offset
# to deterministically stagger elections without real randomness.
let ELECTION_TIMEOUT_BASE: float = 0.150
let ELECTION_TIMEOUT_SPREAD: float = 0.150
let HEARTBEAT_INTERVAL: float = 0.050

# Special "recipient id" used for messages addressed to the external client.
pub let CLIENT_RECIPIENT: int = -1


def _election_deadline(node_id: NodeId, now: float) -> float:
    let id_int: int = int(node_id)
    let offset: float = ELECTION_TIMEOUT_SPREAD * (float(id_int % 7) / 7.0)
    return now + ELECTION_TIMEOUT_BASE + offset


def _majority(cluster_size: int) -> int:
    return (cluster_size // 2) + 1


pub class Node:
    id: NodeId
    peers: list[NodeId]
    current_term: Term
    voted_for: NodeId?
    log: ReplicatedLog
    commit_index: LogIndex
    last_applied: LogIndex
    store: KVStore
    role: Role
    pending_client: dict[int, ClientReqId]
    last_known_leader: NodeId?


pub def new_node(id: NodeId, peers: list[NodeId], now: float) -> Node:
    let init_role: Role = make_follower(None, _election_deadline(id, now))
    return Node(
        id=id,
        peers=peers,
        current_term=Term(0),
        voted_for=None,
        log=new_log(),
        commit_index=LogIndex(0),
        last_applied=LogIndex(0),
        store=new_store(),
        role=init_role,
        pending_client={},
        last_known_leader=None,
    )


impl Node:
    # --- Role transitions ---------------------------------------------------

    def become_follower(self, term: Term, leader: NodeId?, now: float) -> None:
        self.current_term = term
        self.voted_for = None
        self.role = make_follower(leader, _election_deadline(self.id, now))
        if leader is not None:
            self.last_known_leader = leader

    def become_candidate(self, now: float) -> list[tuple[int, Message]]:
        let new_term: Term = Term(int(self.current_term) + 1)
        self.current_term = new_term
        self.voted_for = self.id
        mut votes: dict[int, bool] = {}
        votes[int(self.id)] = True
        self.role = make_candidate(votes, _election_deadline(self.id, now))
        self.last_known_leader = None

        mut out: list[tuple[int, Message]] = []
        let last_idx: LogIndex = self.log.last_index()
        let last_term: Term = self.log.last_term()
        for peer in self.peers:
            if int(peer) == int(self.id):
                continue
            let rv: Message = make_request_vote(
                term=new_term,
                candidate=self.id,
                last_log_index=last_idx,
                last_log_term=last_term,
            )
            out.append((int(peer), rv))
        return out

    def become_leader(self, now: float) -> list[tuple[int, Message]]:
        mut next_index: dict[int, int] = {}
        mut match_index: dict[int, int] = {}
        let last: int = int(self.log.last_index())
        for peer in self.peers:
            if int(peer) == int(self.id):
                continue
            next_index[int(peer)] = last + 1
            match_index[int(peer)] = 0
        self.role = make_leader(next_index, match_index, now + HEARTBEAT_INTERVAL)
        self.last_known_leader = self.id
        return self._broadcast_append(now)

    # --- Message dispatch ---------------------------------------------------

    def handle(self, msg: Message, now: float) -> list[tuple[int, Message]]:
        match msg:
            case MsgAppendEntries(ae_term, ae_leader, ae_pi, ae_pt, ae_ents, ae_lc):
                return self._on_append(
                    ae_term, ae_leader, ae_pi, ae_pt, ae_ents, ae_lc, now
                )
            case MsgAppendEntriesReply(aer_term, aer_from, aer_ok, aer_mi):
                return self._on_append_reply(
                    aer_term, aer_from, aer_ok, aer_mi, now
                )
            case MsgRequestVote(rv_term, rv_cand, rv_li, rv_lt):
                return self._on_request_vote(
                    rv_term, rv_cand, rv_li, rv_lt, now
                )
            case MsgRequestVoteReply(rvr_term, rvr_from, rvr_granted):
                return self._on_request_vote_reply(
                    rvr_term, rvr_from, rvr_granted, now
                )
            case MsgClientPut(cp_rid, cp_k, cp_v):
                return self._on_client_put(cp_rid, cp_k, cp_v, now)
            case MsgClientGet(cg_rid, cg_k):
                return self._on_client_get(cg_rid, cg_k)
            case MsgClientReply(_, _, _, _, _):
                # Nodes never process client replies.
                return []
        raise RuntimeError("unreachable")

    # --- AppendEntries (follower side) --------------------------------------

    def _on_append(
        self,
        term: Term,
        leader: NodeId,
        prev_idx: LogIndex,
        prev_term: Term,
        entries: list[LogEntry],
        leader_commit: LogIndex,
        now: float,
    ) -> list[tuple[int, Message]]:
        mut out: list[tuple[int, Message]] = []
        if int(term) < int(self.current_term):
            let reply_stale: Message = make_append_entries_reply(
                term=self.current_term,
                from_node=self.id,
                success=False,
                match_index=LogIndex(0),
            )
            out.append((int(leader), reply_stale))
            return out

        if int(term) > int(self.current_term):
            self.become_follower(term, leader, now)
        else:
            self.role = make_follower(leader, _election_deadline(self.id, now))
            self.last_known_leader = leader

        # Log consistency check.
        let our_prev_term_opt: Term? = self.log.term_at(prev_idx)
        if our_prev_term_opt is None:
            let reply_missing: Message = make_append_entries_reply(
                term=self.current_term,
                from_node=self.id,
                success=False,
                match_index=LogIndex(0),
            )
            out.append((int(leader), reply_missing))
            return out

        let our_prev_term: Term = our_prev_term_opt
        if int(our_prev_term) != int(prev_term):
            self.log.truncate_from(prev_idx)
            let reply_conflict: Message = make_append_entries_reply(
                term=self.current_term,
                from_node=self.id,
                success=False,
                match_index=LogIndex(0),
            )
            out.append((int(leader), reply_conflict))
            return out

        # Apply incoming entries; on divergent term at an existing index,
        # truncate from that point and re-append.
        mut idx: int = int(prev_idx) + 1
        for ent in entries:
            let existing_opt: LogEntry? = self.log.entry_at(LogIndex(idx))
            if existing_opt is None:
                self.log.append(ent)
            else:
                let existing_entry: LogEntry = existing_opt
                if int(existing_entry.term) != int(ent.term):
                    self.log.truncate_from(LogIndex(idx))
                    self.log.append(ent)
            idx = idx + 1

        let new_match: LogIndex = LogIndex(int(prev_idx) + len(entries))

        if int(leader_commit) > int(self.commit_index):
            let last_idx: int = int(self.log.last_index())
            let new_commit: int = (
                int(leader_commit) if int(leader_commit) < last_idx else last_idx
            )
            self.commit_index = LogIndex(new_commit)

        let reply_ok: Message = make_append_entries_reply(
            term=self.current_term,
            from_node=self.id,
            success=True,
            match_index=new_match,
        )
        out.append((int(leader), reply_ok))
        return out

    # --- AppendEntriesReply (leader side) -----------------------------------

    def _on_append_reply(
        self,
        term: Term,
        from_node: NodeId,
        success: bool,
        match_idx: LogIndex,
        now: float,
    ) -> list[tuple[int, Message]]:
        if int(term) > int(self.current_term):
            self.become_follower(term, None, now)
            return []

        match self.role:
            case RoleLeader(next_index, match_index, _):
                let peer_key: int = int(from_node)
                if success:
                    let new_match: int = int(match_idx)
                    let cur_match: int = (
                        match_index[peer_key] if peer_key in match_index else 0
                    )
                    if new_match > cur_match:
                        match_index[peer_key] = new_match
                    next_index[peer_key] = new_match + 1
                    self._advance_commit_index()
                    return self.apply_committed()
                let cur_next: int = (
                    next_index[peer_key] if peer_key in next_index else 1
                )
                let new_next: int = cur_next - 1 if cur_next > 1 else 1
                next_index[peer_key] = new_next
                return self._send_append_to(from_node, now)
            case RoleFollower(_, _):
                return []
            case RoleCandidate(_, _):
                return []
        raise RuntimeError("unreachable")

    # --- RequestVote (any node) --------------------------------------------

    def _on_request_vote(
        self,
        term: Term,
        candidate: NodeId,
        cand_last_idx: LogIndex,
        cand_last_term: Term,
        now: float,
    ) -> list[tuple[int, Message]]:
        mut out: list[tuple[int, Message]] = []
        if int(term) < int(self.current_term):
            let reply_no: Message = make_request_vote_reply(
                term=self.current_term, from_node=self.id, granted=False,
            )
            out.append((int(candidate), reply_no))
            return out

        if int(term) > int(self.current_term):
            self.become_follower(term, None, now)

        let our_last_idx: int = int(self.log.last_index())
        let our_last_term: int = int(self.log.last_term())
        let cand_up_to_date: bool = (
            int(cand_last_term) > our_last_term
            or (
                int(cand_last_term) == our_last_term
                and int(cand_last_idx) >= our_last_idx
            )
        )

        # Voted-for check, narrowed to avoid `?` issues across boundaries.
        mut already_voted_other: bool = False
        let voted: NodeId? = self.voted_for
        if voted is not None:
            if int(voted) != int(candidate):
                already_voted_other = True

        if cand_up_to_date and not already_voted_other:
            self.voted_for = candidate
            self.role = make_follower(None, _election_deadline(self.id, now))
            let reply_yes: Message = make_request_vote_reply(
                term=self.current_term, from_node=self.id, granted=True,
            )
            out.append((int(candidate), reply_yes))
            return out

        let reply_deny: Message = make_request_vote_reply(
            term=self.current_term, from_node=self.id, granted=False,
        )
        out.append((int(candidate), reply_deny))
        return out

    def _on_request_vote_reply(
        self,
        term: Term,
        from_node: NodeId,
        granted: bool,
        now: float,
    ) -> list[tuple[int, Message]]:
        if int(term) > int(self.current_term):
            self.become_follower(term, None, now)
            return []

        match self.role:
            case RoleCandidate(votes, _):
                if int(term) != int(self.current_term):
                    return []
                if granted:
                    votes[int(from_node)] = True
                mut yes_count: int = 0
                for v in votes.values():
                    if v:
                        yes_count = yes_count + 1
                if yes_count >= _majority(len(self.peers)):
                    return self.become_leader(now)
                return []
            case RoleFollower(_, _):
                return []
            case RoleLeader(_, _, _):
                return []
        raise RuntimeError("unreachable")

    # --- Client traffic -----------------------------------------------------

    def _on_client_put(
        self, req_id: ClientReqId, key: str, value: str, now: float
    ) -> list[tuple[int, Message]]:
        mut out: list[tuple[int, Message]] = []
        match self.role:
            case RoleLeader(_, _, _):
                let cmd: Command = CmdSet(key=key, value=value)
                let new_idx: LogIndex = LogIndex(int(self.log.last_index()) + 1)
                let entry: LogEntry = LogEntry(
                    index=new_idx,
                    term=self.current_term,
                    command=cmd,
                    client_req=req_id,
                )
                self.log.append(entry)
                self.pending_client[int(new_idx)] = req_id
                let broadcasts: list[tuple[int, Message]] = self._broadcast_append(now)
                for b in broadcasts:
                    out.append(b)
                return out
            case RoleFollower(leader, _):
                let reply_redir: Message = make_client_reply(
                    req_id=req_id,
                    ok=False,
                    value=None,
                    redirect=leader,
                    message="not leader",
                )
                out.append((CLIENT_RECIPIENT, reply_redir))
                return out
            case RoleCandidate(_, _):
                let reply_busy: Message = make_client_reply(
                    req_id=req_id,
                    ok=False,
                    value=None,
                    redirect=None,
                    message="election in progress",
                )
                out.append((CLIENT_RECIPIENT, reply_busy))
                return out
        raise RuntimeError("unreachable")

    def _on_client_get(
        self, req_id: ClientReqId, key: str
    ) -> list[tuple[int, Message]]:
        mut out: list[tuple[int, Message]] = []
        match self.role:
            case RoleLeader(_, _, _):
                let v: str? = self.store.get(key)
                let reply_ok: Message = make_client_reply(
                    req_id=req_id,
                    ok=True,
                    value=v,
                    redirect=None,
                    message="ok",
                )
                out.append((CLIENT_RECIPIENT, reply_ok))
                return out
            case RoleFollower(leader, _):
                let reply_redir: Message = make_client_reply(
                    req_id=req_id,
                    ok=False,
                    value=None,
                    redirect=leader,
                    message="not leader",
                )
                out.append((CLIENT_RECIPIENT, reply_redir))
                return out
            case RoleCandidate(_, _):
                let reply_busy: Message = make_client_reply(
                    req_id=req_id,
                    ok=False,
                    value=None,
                    redirect=None,
                    message="election in progress",
                )
                out.append((CLIENT_RECIPIENT, reply_busy))
                return out
        raise RuntimeError("unreachable")

    # --- Tick + commit application ------------------------------------------

    def tick(self, now: float) -> list[tuple[int, Message]]:
        match self.role:
            case RoleFollower(_, deadline):
                if now >= deadline:
                    return self.become_candidate(now)
                return []
            case RoleCandidate(_, deadline):
                if now >= deadline:
                    return self.become_candidate(now)
                return []
            case RoleLeader(_, _, hb):
                if now >= hb:
                    let next_hb: float = now + HEARTBEAT_INTERVAL
                    self._update_heartbeat_deadline(next_hb)
                    return self._broadcast_append(now)
                return []
        raise RuntimeError("unreachable")

    def apply_committed(self) -> list[tuple[int, Message]]:
        mut out: list[tuple[int, Message]] = []
        while int(self.last_applied) < int(self.commit_index):
            let next_idx: int = int(self.last_applied) + 1
            let ent_opt: LogEntry? = self.log.entry_at(LogIndex(next_idx))
            if ent_opt is None:
                break
            let ent: LogEntry = ent_opt
            self.store.apply(ent.command)
            self.last_applied = LogIndex(next_idx)
            if next_idx in self.pending_client:
                let req: ClientReqId = self.pending_client[next_idx]
                del self.pending_client[next_idx]
                let reply: Message = make_client_reply(
                    req_id=req,
                    ok=True,
                    value=None,
                    redirect=None,
                    message="committed",
                )
                out.append((CLIENT_RECIPIENT, reply))
        return out

    # --- Internal helpers ---------------------------------------------------

    def _update_heartbeat_deadline(self, new_deadline: float) -> None:
        match self.role:
            case RoleLeader(ni, mi, _):
                self.role = make_leader(ni, mi, new_deadline)
            case RoleFollower(_, _):
                pass
            case RoleCandidate(_, _):
                pass

    def _broadcast_append(self, now: float) -> list[tuple[int, Message]]:
        mut out: list[tuple[int, Message]] = []
        for peer in self.peers:
            if int(peer) == int(self.id):
                continue
            let sent: list[tuple[int, Message]] = self._send_append_to(peer, now)
            for s in sent:
                out.append(s)
        return out

    def _send_append_to(
        self, peer: NodeId, now: float
    ) -> list[tuple[int, Message]]:
        mut out: list[tuple[int, Message]] = []
        match self.role:
            case RoleLeader(next_index, _, _):
                let peer_key: int = int(peer)
                let ni: int = next_index[peer_key] if peer_key in next_index else 1
                let prev_idx: int = ni - 1
                let prev_term_opt: Term? = self.log.term_at(LogIndex(prev_idx))
                mut prev_term: Term = Term(0)
                if prev_term_opt is not None:
                    prev_term = prev_term_opt
                let to_send: list[LogEntry] = self.log.entries_from(LogIndex(ni))
                let ae: Message = make_append_entries(
                    term=self.current_term,
                    leader=self.id,
                    prev_log_index=LogIndex(prev_idx),
                    prev_log_term=prev_term,
                    entries=to_send,
                    leader_commit=self.commit_index,
                )
                out.append((peer_key, ae))
                return out
            case RoleFollower(_, _):
                return out
            case RoleCandidate(_, _):
                return out
        raise RuntimeError("unreachable")

    def _advance_commit_index(self) -> None:
        match self.role:
            case RoleLeader(_, match_index, _):
                let last_idx: int = int(self.log.last_index())
                let majority: int = _majority(len(self.peers))
                mut n: int = last_idx
                while n > int(self.commit_index):
                    mut count: int = 1  # leader itself
                    for v in match_index.values():
                        if v >= n:
                            count = count + 1
                    let term_opt: Term? = self.log.term_at(LogIndex(n))
                    if term_opt is not None:
                        let n_term: Term = term_opt
                        if count >= majority and int(n_term) == int(self.current_term):
                            self.commit_index = LogIndex(n)
                            return
                    n = n - 1
            case RoleFollower(_, _):
                pass
            case RoleCandidate(_, _):
                pass
