from ids import ClientReqId, LogIndex, NodeId, Term
from log import LogEntry


pub type Message = MsgAppendEntries | MsgAppendEntriesReply | MsgRequestVote | MsgRequestVoteReply | MsgClientPut | MsgClientGet | MsgClientReply


pub class MsgAppendEntries:
    term: Term
    leader: NodeId
    prev_log_index: LogIndex
    prev_log_term: Term
    entries: list[LogEntry]
    leader_commit: LogIndex


pub class MsgAppendEntriesReply:
    term: Term
    from_node: NodeId
    success: bool
    match_index: LogIndex


pub class MsgRequestVote:
    term: Term
    candidate: NodeId
    last_log_index: LogIndex
    last_log_term: Term


pub class MsgRequestVoteReply:
    term: Term
    from_node: NodeId
    granted: bool


pub class MsgClientPut:
    req_id: ClientReqId
    key: str
    value: str


pub class MsgClientGet:
    req_id: ClientReqId
    key: str


pub class MsgClientReply:
    req_id: ClientReqId
    ok: bool
    value: str?
    redirect: NodeId?
    message: str


pub def make_append_entries(
    term: Term,
    leader: NodeId,
    prev_log_index: LogIndex,
    prev_log_term: Term,
    entries: list[LogEntry],
    leader_commit: LogIndex,
) -> Message:
    return MsgAppendEntries(
        term=term,
        leader=leader,
        prev_log_index=prev_log_index,
        prev_log_term=prev_log_term,
        entries=entries,
        leader_commit=leader_commit,
    )


pub def make_append_entries_reply(
    term: Term, from_node: NodeId, success: bool, match_index: LogIndex
) -> Message:
    return MsgAppendEntriesReply(
        term=term, from_node=from_node, success=success, match_index=match_index
    )


pub def make_request_vote(
    term: Term, candidate: NodeId, last_log_index: LogIndex, last_log_term: Term
) -> Message:
    return MsgRequestVote(
        term=term,
        candidate=candidate,
        last_log_index=last_log_index,
        last_log_term=last_log_term,
    )


pub def make_request_vote_reply(
    term: Term, from_node: NodeId, granted: bool
) -> Message:
    return MsgRequestVoteReply(term=term, from_node=from_node, granted=granted)


pub def make_client_put(req_id: ClientReqId, key: str, value: str) -> Message:
    return MsgClientPut(req_id=req_id, key=key, value=value)


pub def make_client_get(req_id: ClientReqId, key: str) -> Message:
    return MsgClientGet(req_id=req_id, key=key)


pub def make_client_reply(
    req_id: ClientReqId,
    ok: bool,
    value: str?,
    redirect: NodeId?,
    message: str,
) -> Message:
    return MsgClientReply(
        req_id=req_id, ok=ok, value=value, redirect=redirect, message=message
    )


pub def message_label(m: Message) -> str:
    match m:
        case MsgAppendEntries(term, leader, pi, pt, ents, lc):
            return f"AE(term={int(term)} leader={int(leader)} prev={int(pi)}@{int(pt)} n={len(ents)} commit={int(lc)})"
        case MsgAppendEntriesReply(term, frm, ok, mi):
            return f"AEReply(term={int(term)} from={int(frm)} ok={ok} match={int(mi)})"
        case MsgRequestVote(term, cand, li, lt):
            return f"RV(term={int(term)} cand={int(cand)} last={int(li)}@{int(lt)})"
        case MsgRequestVoteReply(term, frm, granted):
            return f"RVReply(term={int(term)} from={int(frm)} granted={granted})"
        case MsgClientPut(rid, k, v):
            return f"ClientPut(req={int(rid)} {k}={v})"
        case MsgClientGet(rid, k):
            return f"ClientGet(req={int(rid)} {k})"
        case MsgClientReply(rid, ok, _, _, msg):
            return f"ClientReply(req={int(rid)} ok={ok} '{msg}')"
    raise RuntimeError("unreachable")
