from datetime import datetime

from ids import AccountId, CustomerId, Currency, TransactionId
from money import Money


pub type Command = OpenAccount | Deposit | Withdraw | Transfer | FreezeAccount | UnfreezeAccount | CloseAccount | AccrueInterest


pub class OpenAccount:
    account_id: AccountId
    customer_id: CustomerId
    currency: Currency


pub class Deposit:
    account_id: AccountId
    amount: Money
    source: str
    transaction_id: TransactionId


pub class Withdraw:
    account_id: AccountId
    amount: Money
    destination: str
    transaction_id: TransactionId


pub class Transfer:
    from_account: AccountId
    to_account: AccountId
    amount: Money
    transaction_id: TransactionId


pub class FreezeAccount:
    account_id: AccountId
    reason: str


pub class UnfreezeAccount:
    account_id: AccountId


pub class CloseAccount:
    account_id: AccountId


pub class AccrueInterest:
    account_id: AccountId
    rate: float


pub type RejectionReason = NoSuchAccount | AccountIsFrozen | AccountAlreadyExists | InsufficientFunds | NegativeAmount | CurrencyMismatch | AccountClosedAlready | AmlRejection


pub class NoSuchAccount:
    account_id: AccountId


pub class AccountIsFrozen:
    account_id: AccountId
    reason: str


pub class AccountAlreadyExists:
    account_id: AccountId


pub class InsufficientFunds:
    account_id: AccountId
    available: Money
    requested: Money


pub class NegativeAmount:
    field: str
    value: Money


pub class CurrencyMismatch:
    expected: Currency
    found: Currency


pub class AccountClosedAlready:
    account_id: AccountId


pub class AmlRejection:
    rule: str
    detail: str


pub def rejection_message(r: RejectionReason) -> str:
    match r:
        case NoSuchAccount(aid):
            return f"no such account: {str(aid)}"
        case AccountIsFrozen(aid, reason):
            return f"account {str(aid)} is frozen ({reason})"
        case AccountAlreadyExists(aid):
            return f"account {str(aid)} already exists"
        case InsufficientFunds(aid, avail, req):
            return (
                f"account {str(aid)}: insufficient funds "
                f"(have {int(avail)}, want {int(req)})"
            )
        case NegativeAmount(field, val):
            return f"negative amount on {field}: {int(val)}"
        case CurrencyMismatch(expected, found):
            return f"currency mismatch: expected {str(expected)}, found {str(found)}"
        case AccountClosedAlready(aid):
            return f"account {str(aid)} already closed"
        case AmlRejection(rule, detail):
            return f"AML rejection by {rule}: {detail}"
