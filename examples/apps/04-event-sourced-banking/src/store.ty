from events import Event, EventEnvelope, event_account_id
from ids import AccountId, EventId


pub class EventStore:
    events: list[EventEnvelope]
    next_seq: int


pub class SnapshotEntry:
    account_id: AccountId
    last_seq: EventId


pub class SnapshotStore:
    snapshots: dict[str, SnapshotEntry]


impl EventStore:
    def append(self, event: Event) -> EventEnvelope:
        let env: EventEnvelope = EventEnvelope(
            seq=EventId(self.next_seq),
            payload=event,
        )
        self.events.append(env)
        self.next_seq = self.next_seq + 1
        return env

    def all(self) -> list[EventEnvelope]:
        return list(self.events)

    def for_account(self, account_id: AccountId) -> list[Event]:
        let target: str = str(account_id)
        mut out: list[Event] = []
        for env in self.events:
            let aid: AccountId? = event_account_id(env.payload)
            if aid is not None and str(aid) == target:
                out.append(env.payload)
        return out

    def since(self, after_seq: int) -> list[EventEnvelope]:
        mut out: list[EventEnvelope] = []
        for env in self.events:
            if int(env.seq) > after_seq:
                out.append(env)
        return out


impl SnapshotStore:
    def record(self, account_id: AccountId, last_seq: EventId) -> None:
        self.snapshots[str(account_id)] = SnapshotEntry(
            account_id=account_id, last_seq=last_seq
        )

    def get(self, account_id: AccountId) -> SnapshotEntry?:
        return self.snapshots.get(str(account_id))


pub def new_event_store() -> EventStore:
    return EventStore(events=[], next_seq=1)


pub def new_snapshot_store() -> SnapshotStore:
    return SnapshotStore(snapshots={})
