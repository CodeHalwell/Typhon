from ids import Currency


pub newtype Money = int


comptime let BASE_CURRENCY: str = "USD"


pub freeze let FX_RATES: dict[str, dict[str, float]] = {
    "USD": {"USD": 1.0, "EUR": 0.92, "GBP": 0.79, "JPY": 156.20},
    "EUR": {"USD": 1.087, "EUR": 1.0, "GBP": 0.859, "JPY": 169.78},
    "GBP": {"USD": 1.266, "EUR": 1.164, "GBP": 1.0, "JPY": 197.65},
    "JPY": {"USD": 0.0064, "EUR": 0.0059, "GBP": 0.0051, "JPY": 1.0},
}


pub class FxError:
    from_ccy: str
    to_ccy: str
    reason: str


pub def add_money(a: Money, b: Money) -> Money:
    return Money(int(a) + int(b))


pub def sub_money(a: Money, b: Money) -> Money:
    return Money(int(a) - int(b))


pub def neg_money(a: Money) -> Money:
    return Money(-int(a))


pub def is_positive(a: Money) -> bool:
    return int(a) > 0


pub def is_non_negative(a: Money) -> bool:
    return int(a) >= 0


pub def format_money(amount: Money, ccy: Currency) -> str:
    let raw: int = int(amount)
    let major: int = raw // 100
    let minor: int = abs(raw) % 100
    let sign: str = "-" if raw < 0 else ""
    return f"{sign}{abs(major)}.{minor:02d} {str(ccy)}"


pub def convert(amount: Money, from_ccy: Currency, to_ccy: Currency) -> Result[Money, FxError]:
    if str(from_ccy) == str(to_ccy):
        return Ok(amount)
    let from_row: dict[str, float]? = FX_RATES.get(str(from_ccy))
    if from_row is None:
        return Err(FxError(
            from_ccy=str(from_ccy),
            to_ccy=str(to_ccy),
            reason="unknown_from_currency",
        ))
    let rate: float? = from_row.get(str(to_ccy))
    if rate is None:
        return Err(FxError(
            from_ccy=str(from_ccy),
            to_ccy=str(to_ccy),
            reason="unknown_to_currency",
        ))
    return Ok(Money(int(float(int(amount)) * rate)))


pub def is_base(ccy: Currency) -> bool:
    return str(ccy) == BASE_CURRENCY
