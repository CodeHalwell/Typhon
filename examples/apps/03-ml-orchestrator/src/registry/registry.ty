import hashlib
from datetime import datetime, timezone

from domain import Dataset
from domain import DatasetId, DatasetVersion, ModelName, ModelVersion, RunId
from domain import LinearModel, model_to_json


pub class DatasetMeta:
    id: DatasetId
    version: DatasetVersion
    n_samples: int
    n_features: int
    content_hash: str
    registered_at: datetime


pub class ModelEntry:
    name: ModelName
    version: ModelVersion
    serialised: str
    metrics: dict[str, float]
    registered_at: datetime
    parent_run: RunId?


pub class DatasetRegistry:
    items: dict[str, DatasetMeta]


pub class ModelRegistry:
    items: dict[str, ModelEntry]


def _hash_dataset(ds: Dataset[list[float]]) -> str:
    let h = hashlib.sha256()
    for s in ds.samples:
        for v in s.features:
            h.update(repr(v).encode())
        h.update(repr(s.label).encode())
    return h.hexdigest()[:16]


impl DatasetRegistry:
    def register(self, ds: Dataset[list[float]]) -> DatasetMeta:
        let n_features: int = len(ds.samples[0].features) if ds.size() > 0 else 0
        let meta: DatasetMeta = DatasetMeta(
            id=ds.id,
            version=ds.version,
            n_samples=ds.size(),
            n_features=n_features,
            content_hash=_hash_dataset(ds),
            registered_at=datetime.now(timezone.utc),
        )
        self.items[f"{str(ds.id)}::{str(ds.version)}"] = meta
        return meta

    def get(self, id: DatasetId, version: DatasetVersion) -> DatasetMeta?:
        return self.items.get(f"{str(id)}::{str(version)}")

    def list_all(self) -> list[DatasetMeta]:
        return [v for (_, v) in self.items.items()]


impl ModelRegistry:
    def register(
        self,
        model: LinearModel,
        metrics: dict[str, float],
        parent_run: RunId?,
    ) -> ModelEntry:
        let entry: ModelEntry = ModelEntry(
            name=model.name,
            version=model.version,
            serialised=model_to_json(model),
            metrics=metrics,
            registered_at=datetime.now(timezone.utc),
            parent_run=parent_run,
        )
        self.items[f"{str(model.name)}::{str(model.version)}"] = entry
        return entry

    def best(self, name: ModelName, metric: str, lower_is_better: bool) -> ModelEntry?:
        mut winner: ModelEntry? = None
        for (_, entry) in self.items.items():
            if str(entry.name) != str(name):
                continue
            let value: float? = entry.metrics.get(metric)
            if value is None:
                continue
            if winner is None:
                winner = entry
                continue
            let current: float? = winner.metrics.get(metric)
            if current is None:
                continue
            if lower_is_better:
                if value < current:
                    winner = entry
            else:
                if value > current:
                    winner = entry
        return winner


pub def new_dataset_registry() -> DatasetRegistry:
    return DatasetRegistry(items={})


pub def new_model_registry() -> ModelRegistry:
    return ModelRegistry(items={})
