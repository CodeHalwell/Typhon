import json

lazy import np = numpy

from .datatypes import Dataset
from .ids import ModelName, ModelVersion


pub class TrainConfig frozen:
    learning_rate: float
    epochs: int
    l2: float


pub class LinearModel:
    name: ModelName
    version: ModelVersion
    weights: list[float]
    bias: float
    n_features: int


pub class TrainResult:
    model: LinearModel
    final_loss: float
    epoch_losses: list[float]


pub class EvalMetrics:
    mse: float
    mae: float
    r2: float


def _xy(ds: Dataset[list[float]]) -> tuple[list[list[float]], list[float]]:
    return ([s.features for s in ds.samples], [s.label for s in ds.samples])


pub def train_linear(
    name: ModelName,
    version: ModelVersion,
    ds: Dataset[list[float]],
    cfg: TrainConfig,
) -> TrainResult:
    let (xs, ys) = _xy(ds)
    let X = np.array(xs, dtype=np.float64)
    let y = np.array(ys, dtype=np.float64)
    let n_features: int = X.shape[1]

    mut w = np.zeros(n_features, dtype=np.float64)
    mut b: float = 0.0
    let n: int = X.shape[0]
    mut epoch_losses: list[float] = []
    mut last_loss: float = 0.0

    for _ in range(cfg.epochs):
        let preds = X @ w + b
        let residual = preds - y
        let grad_w = (X.T @ residual) / float(n) + cfg.l2 * w
        let grad_b: float = float(residual.mean())
        w = w - cfg.learning_rate * grad_w
        b = b - cfg.learning_rate * grad_b
        let loss: float = float((residual * residual).mean())
        epoch_losses.append(loss)
        last_loss = loss

    let model: LinearModel = LinearModel(
        name=name,
        version=version,
        weights=[float(x) for x in w.tolist()],
        bias=b,
        n_features=n_features,
    )
    return TrainResult(
        model=model,
        final_loss=last_loss,
        epoch_losses=epoch_losses,
    )


pub def predict(model: LinearModel, features: list[float]) -> float:
    if len(features) != model.n_features:
        raise ValueError(
            f"expected {model.n_features} features, got {len(features)}"
        )
    mut acc: float = model.bias
    for i in range(model.n_features):
        acc = acc + model.weights[i] * features[i]
    return acc


pub def evaluate(model: LinearModel, ds: Dataset[list[float]]) -> EvalMetrics:
    if ds.size() == 0:
        return EvalMetrics(mse=0.0, mae=0.0, r2=0.0)
    mut sse: float = 0.0
    mut sae: float = 0.0
    mut sum_y: float = 0.0
    for s in ds.samples:
        sum_y = sum_y + s.label
    let mean_y: float = sum_y / float(ds.size())
    mut tss: float = 0.0
    for s in ds.samples:
        let pred: float = predict(model, s.features)
        let err: float = s.label - pred
        sse = sse + err * err
        sae = sae + (err if err >= 0.0 else -err)
        tss = tss + (s.label - mean_y) * (s.label - mean_y)
    let n: float = float(ds.size())
    let mse: float = sse / n
    let mae: float = sae / n
    let r2: float = 1.0 - (sse / tss) if tss > 0.0 else 0.0
    return EvalMetrics(mse=mse, mae=mae, r2=r2)


pub def model_to_json(model: LinearModel) -> str:
    return json.dumps({
        "name": str(model.name),
        "version": str(model.version),
        "weights": model.weights,
        "bias": model.bias,
        "n_features": model.n_features,
    })
