import hashlib
from datetime import datetime, timezone
from pathlib import Path

from config import SiteConfig
from frontmatter import parse_frontmatter
from ids import PageId, SlugStr, SourceHash, TemplateName
from manifest import Manifest
from md_parse import parse_blocks, render_blocks_html
from models import (
    Document,
    FrontMatter,
    RenderedPage,
    StageError,
    Template,
    make_se_front,
    make_se_read,
    make_se_render,
    make_se_template,
    make_se_write,
)
from tpl_parse import parse_template
from tpl_render import RenderCtx, new_ctx, render_template


def _hash_text(text: str) -> SourceHash:
    let h = hashlib.sha256(text.encode("utf-8"))
    return SourceHash(h.hexdigest())


def _read_file(path: str) -> Result[str, StageError]:
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return Ok(fh.read())
    except OSError as e:
        return Err(make_se_read(path, str(e)))


def _write_file(path: str, content: str) -> Result[None, StageError]:
    try:
        let parent: Path = Path(path).parent
        parent.mkdir(parents=True, exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(content)
        return Ok(None)
    except OSError as e:
        return Err(make_se_write(path, str(e)))


def _slugify(name: str) -> str:
    mut out: str = ""
    for ch in name.lower():
        if (ch >= "a" and ch <= "z") or (ch >= "0" and ch <= "9"):
            out = out + ch
        elif ch == "-" or ch == "_":
            out = out + ch
        elif ch == " ":
            out = out + "-"
    return out


def _derive_slug(path: str, declared: str) -> SlugStr:
    if len(declared) > 0:
        return SlugStr(declared)
    let stem: str = Path(path).stem
    return SlugStr(_slugify(stem) + ".html")


# R2-6 — heterogeneous-error pipelines via `.map_err` (v0.6.0+).
# Each stage returns a different `Err` type; `.map_err(lambda e: ...)` is
# the per-stage converter that funnels everything into `StageError`, and
# `?` propagates the unified error. The shape collapses what was
# previously a multi-level `match` tower (~25 lines per pipeline function)
# back to the canonical 6-line straight-line form.

pub def load_document(path: str, default_layout: str) -> Result[Document, StageError]:
    let text: str = _read_file(path)?
    let pair = parse_frontmatter(text, default_layout).map_err(lambda fe: make_se_front(path, fe.line, fe.detail))?
    let fm: FrontMatter = pair[0]
    let body: str = pair[1]
    # Markdown parsing is total in our implementation (no Result), so
    # `parse_blocks` is called directly without `?`.
    let blocks = parse_blocks(body)
    let pid: PageId = PageId(Path(path).stem)
    return Ok(Document(
        id=pid,
        source_path=path,
        front=fm,
        blocks=blocks,
        body_text=body,
    ))


pub def load_template(
    name: TemplateName, template_dir: str
) -> Result[Template, StageError]:
    let path: str = str(Path(template_dir) / (str(name) + ".html"))
    let text: str = _read_file(path)?
    let tpl: Template = parse_template(name, text).map_err(lambda pe: make_se_template(str(name), pe.line, pe.detail))?
    return Ok(tpl)


pub def load_all_templates(
    names: list[str], template_dir: str
) -> Result[dict[str, Template], StageError]:
    mut out: dict[str, Template] = {}
    for name in names:
        match load_template(TemplateName(name), template_dir):
            case Err(e):
                return Err(e)
            case Ok(tpl):
                out[name] = tpl
    return Ok(out)


def _doc_to_ctx(
    doc: Document,
    cfg: SiteConfig,
    templates: dict[str, Template],
    body_html: str,
) -> RenderCtx:
    let ctx: RenderCtx = new_ctx(templates)
    ctx.scalars["title"] = doc.front.title
    ctx.scalars["site_title"] = cfg.site_title
    ctx.scalars["site_url"] = cfg.site_url
    ctx.scalars["author"] = cfg.author
    ctx.scalars["date"] = doc.front.date.date().isoformat()
    ctx.scalars["content"] = body_html
    ctx.scalars["page_id"] = str(doc.id)
    ctx.flags["draft"] = doc.front.draft
    ctx.flags["has_tags"] = len(doc.front.tags) > 0
    mut tag_items: list[dict[str, str]] = []
    for tag in doc.front.tags:
        tag_items.append({"name": tag, "__str__": tag})
    ctx.lists["tags"] = tag_items
    return ctx


pub def render_document(
    doc: Document,
    cfg: SiteConfig,
    templates: dict[str, Template],
) -> Result[RenderedPage, StageError]:
    let body_html: str = render_blocks_html(doc.blocks)
    let ctx: RenderCtx = _doc_to_ctx(doc, cfg, templates, body_html)
    let layout: str = doc.front.layout
    if layout not in templates:
        return Err(make_se_template(layout, 0, f"template {layout!r} not loaded"))
    let doc_id: str = str(doc.id)
    let html: str = render_template(layout, ctx).map_err(lambda re: make_se_render(doc_id, re.detail))?
    let slug: SlugStr = _derive_slug(doc.source_path, doc.front.slug)
    return Ok(RenderedPage(
        id=doc.id,
        slug=slug,
        layout=TemplateName(layout),
        title=doc.front.title,
        date=doc.front.date,
        tags=doc.front.tags,
        html=html,
        out_path=str(slug),
    ))


pub def write_page(
    page: RenderedPage, cfg: SiteConfig
) -> Result[None, StageError]:
    let path: str = str(Path(cfg.output_dir) / page.out_path)
    return _write_file(path, page.html)


pub def should_rebuild(
    path: str, text: str, page_id: PageId, manifest: Manifest, incremental: bool
) -> bool:
    if not incremental:
        return True
    let new_hash: SourceHash = _hash_text(text)
    match manifest.hash_for(page_id):
        case Err(_):
            return True
        case Ok(prev):
            if prev is None:
                return True
            return str(prev) != str(new_hash)
    raise RuntimeError("unreachable")


pub def record_render(
    path: str, text: str, page_id: PageId, out_path: str, manifest: Manifest
) -> Result[None, StageError]:
    let new_hash: SourceHash = _hash_text(text)
    let now: str = datetime.now(timezone.utc).isoformat()
    return manifest.record_page(page_id, new_hash, out_path, now).map_err(lambda me: make_se_write(path, me.detail))


# End-to-end build pass: discover, parse, render, write, sitemap, rss.

pub class PipelineReport:
    pages_rendered: int
    pages_skipped: int
    errors: list[str]


pub def build_pages(
    cfg: SiteConfig,
    templates: dict[str, Template],
    manifest: Manifest,
) -> tuple[list[RenderedPage], PipelineReport]:
    mut rendered: list[RenderedPage] = []
    mut errors: list[str] = []
    mut skipped: int = 0
    let content_root: Path = Path(cfg.content_dir)
    if not content_root.exists():
        return (rendered, PipelineReport(
            pages_rendered=0,
            pages_skipped=0,
            errors=[f"content directory not found: {cfg.content_dir}"],
        ))
    let files: list[Path] = sorted(content_root.rglob("*.md"))
    for path in files:
        let path_str: str = str(path)
        match _read_file(path_str):
            case Err(re):
                errors.append(f"[{path_str}] read: {re}")
                continue
            case Ok(text):
                let pid: PageId = PageId(path.stem)
                if not should_rebuild(path_str, text, pid, manifest, cfg.incremental):
                    skipped = skipped + 1
                    continue
                match load_document(path_str, "post"):
                    case Err(de):
                        errors.append(f"[{path_str}] load: {de}")
                        continue
                    case Ok(doc):
                        if doc.front.draft:
                            skipped = skipped + 1
                            continue
                        match render_document(doc, cfg, templates):
                            case Err(rde):
                                errors.append(f"[{path_str}] render: {rde}")
                                continue
                            case Ok(page):
                                match write_page(page, cfg):
                                    case Err(we):
                                        errors.append(f"[{path_str}] write: {we}")
                                        continue
                                    case Ok(_):
                                        match record_render(path_str, text, pid, page.out_path, manifest):
                                            case Err(mre):
                                                errors.append(f"[{path_str}] manifest: {mre}")
                                            case Ok(_):
                                                pass
                                        rendered.append(page)
    return (rendered, PipelineReport(
        pages_rendered=len(rendered),
        pages_skipped=skipped,
        errors=errors,
    ))
