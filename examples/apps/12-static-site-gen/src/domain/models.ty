from datetime import datetime

from .ids import PageId, SlugStr, TemplateName


# ----- Frontmatter -----

pub class FrontMatter:
    title: str
    date: datetime
    tags: list[str]
    layout: str
    draft: bool
    slug: str


pub class FrontMatterError:
    line: int
    detail: str


# ----- Markdown AST -----
# Inline nodes.

pub type Inline = InText | InEmph | InStrong | InCode | InLink | InImage | InBreak


pub class InText:
    text: str


pub class InEmph:
    children: list[Inline]


pub class InStrong:
    children: list[Inline]


pub class InCode:
    code: str


pub class InLink:
    href: str
    children: list[Inline]


pub class InImage:
    src: str
    alt: str


pub class InBreak frozen:
    pass


# Inline factories — see TYPHON_FEEDBACK R1-#1.
# Block nodes.

pub type Block = BkHeading | BkParagraph | BkList | BkCode | BkQuote | BkRule | BkHtml


pub class BkHeading:
    level: int
    children: list[Inline]


pub class BkParagraph:
    children: list[Inline]


pub class BkList:
    ordered: bool
    items: list[list[Inline]]


pub class BkCode:
    lang: str
    code: str


pub class BkQuote:
    children: list[Inline]


pub class BkRule frozen:
    pass


pub class BkHtml:
    raw: str


# Block factories.

# ----- Document -----

pub class Document:
    id: PageId
    source_path: str
    front: FrontMatter
    blocks: list[Block]
    body_text: str


pub class RenderedPage:
    id: PageId
    slug: SlugStr
    layout: TemplateName
    title: str
    date: datetime
    tags: list[str]
    html: str
    out_path: str


# ----- Template AST -----

pub type TplNode = TnText | TnExpr | TnIf | TnFor | TnBlock | TnExtends


pub class TnText:
    text: str


pub class TnExpr:
    name: str


pub class TnIf:
    cond: str
    then_body: list[TplNode]
    else_body: list[TplNode]


pub class TnFor:
    var_name: str
    iter_name: str
    body: list[TplNode]


pub class TnBlock:
    block_name: str
    body: list[TplNode]


pub class TnExtends:
    parent: str


# Template factories.

pub class Template:
    name: TemplateName
    nodes: list[TplNode]


# ----- Pipeline error envelope (heterogeneous) -----

pub type StageError = SeRead | SeFront | SeMarkdown | SeTemplate | SeRender | SeWrite


pub class SeRead:
    path: str
    detail: str


pub class SeFront:
    path: str
    line: int
    detail: str


pub class SeMarkdown:
    path: str
    line: int
    detail: str


pub class SeTemplate:
    name: str
    line: int
    detail: str


pub class SeRender:
    page: str
    detail: str


pub class SeWrite:
    path: str
    detail: str


pub def stage_error_label(e: StageError) -> str:
    match e:
        case SeRead(_, _):       return "read"
        case SeFront(_, _, _):   return "frontmatter"
        case SeMarkdown(_, _, _): return "markdown"
        case SeTemplate(_, _, _): return "template"
        case SeRender(_, _):     return "render"
        case SeWrite(_, _):      return "write"
    raise RuntimeError("unreachable")


pub def stage_error_detail(e: StageError) -> str:
    match e:
        case SeRead(p, d):       return f"{p}: {d}"
        case SeFront(p, line, d): return f"{p}:{line}: {d}"
        case SeMarkdown(p, line, d): return f"{p}:{line}: {d}"
        case SeTemplate(n, line, d): return f"<{n}>:{line}: {d}"
        case SeRender(pg, d):    return f"page {pg}: {d}"
        case SeWrite(p, d):      return f"{p}: {d}"
    raise RuntimeError("unreachable")
