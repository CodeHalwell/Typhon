pub type TplTok = TtText | TtExpr | TtTag


pub class TtText:
    text: str
    line: int


pub class TtExpr:
    body: str
    line: int


pub class TtTag:
    body: str
    line: int

def _count_newlines(text: str) -> int:
    mut n: int = 0
    for ch in text:
        if ch == "\n":
            n = n + 1
    return n


pub def lex_template(source: str) -> list[TplTok]:
    mut out: list[TplTok] = []
    mut i: int = 0
    mut line: int = 1
    let n: int = len(source)
    mut buf: str = ""
    mut buf_line: int = 1
    while i < n:
        let two: str = source[i:i + 2] if i + 1 < n else ""
        if two == "{{":
            if len(buf) > 0:
                out.append(TtText(buf, buf_line))
                buf = ""
            let end: int = source.find("}}", i + 2)
            if end < 0:
                buf = buf + source[i:n]
                i = n
                break
            let body: str = source[i + 2:end].strip()
            out.append(TtExpr(body, line))
            line = line + _count_newlines(source[i:end + 2])
            i = end + 2
            buf_line = line
            continue
        if two == "{%":
            if len(buf) > 0:
                out.append(TtText(buf, buf_line))
                buf = ""
            let end_t: int = source.find("%}", i + 2)
            if end_t < 0:
                buf = buf + source[i:n]
                i = n
                break
            let body_t: str = source[i + 2:end_t].strip()
            out.append(TtTag(body_t, line))
            line = line + _count_newlines(source[i:end_t + 2])
            i = end_t + 2
            buf_line = line
            continue
        if source[i] == "\n":
            line = line + 1
        buf = buf + source[i]
        i = i + 1
    if len(buf) > 0:
        out.append(TtText(buf, buf_line))
    return out
