from conf import html_escape
from domain import (
    Template,
    TnBlock,
    TnExpr,
    TnExtends,
    TnFor,
    TnIf,
    TnText,
    TplNode,
)


pub class RenderError:
    line: int
    detail: str


pub class RenderCtx:
    scalars: dict[str, str]
    lists: dict[str, list[dict[str, str]]]
    flags: dict[str, bool]
    blocks: dict[str, list[TplNode]]
    templates: dict[str, Template]


pub def new_ctx(templates: dict[str, Template]) -> RenderCtx:
    return RenderCtx(
        scalars={},
        lists={},
        flags={},
        blocks={},
        templates=templates,
    )


def _lookup_scalar(name: str, ctx: RenderCtx, loop_scope: dict[str, dict[str, str]]) -> str:
    let dot: int = name.find(".")
    if dot >= 0:
        let head: str = name[0:dot]
        let tail: str = name[dot + 1:len(name)]
        let item: dict[str, str]? = loop_scope.get(head)
        if item is not None:
            return item.get(tail) or ""
        return ""
    let v: str? = ctx.scalars.get(name)
    if v is not None:
        return v
    let f: bool? = ctx.flags.get(name)
    if f is not None:
        return "true" if f else ""
    let inner: dict[str, str]? = loop_scope.get(name)
    if inner is not None:
        return inner.get("__str__") or ""
    return ""


def _truthy(name: str, ctx: RenderCtx, loop_scope: dict[str, dict[str, str]]) -> bool:
    let f: bool? = ctx.flags.get(name)
    if f is not None:
        return f
    let v: str = _lookup_scalar(name, ctx, loop_scope)
    return len(v) > 0


# Collect named blocks defined within a node list (recursively into ifs/fors).
def _collect_blocks(nodes: list[TplNode], blocks: dict[str, list[TplNode]]) -> None:
    for node in nodes:
        match node:
            case TnText(_):
                pass
            case TnExpr(_):
                pass
            case TnExtends(_):
                pass
            case TnBlock(block_name, body):
                if block_name not in blocks:
                    blocks[block_name] = body
                _collect_blocks(body, blocks)
            case TnIf(_, then_body, else_body):
                _collect_blocks(then_body, blocks)
                _collect_blocks(else_body, blocks)
            case TnFor(_, _, body_f):
                _collect_blocks(body_f, blocks)


def _find_extends(nodes: list[TplNode]) -> str?:
    for node in nodes:
        match node:
            case TnExtends(parent):
                return parent
            case _:
                pass
    return None


def _render_nodes(
    nodes: list[TplNode],
    ctx: RenderCtx,
    loop_scope: dict[str, dict[str, str]],
) -> Result[str, RenderError]:
    mut out: str = ""
    for node in nodes:
        match node:
            case TnText(text):
                out = out + text
            case TnExpr(name):
                let trimmed: str = name.strip()
                if trimmed.startswith("raw "):
                    let raw_name: str = trimmed[4:len(trimmed)].strip()
                    out = out + _lookup_scalar(raw_name, ctx, loop_scope)
                else:
                    out = out + html_escape(_lookup_scalar(trimmed, ctx, loop_scope))
            case TnIf(cond, then_body, else_body):
                let mut_cond: str = cond.strip()
                mut negate: bool = False
                mut check: str = mut_cond
                if mut_cond.startswith("not "):
                    negate = True
                    check = mut_cond[4:len(mut_cond)].strip()
                let truth_val: bool = _truthy(check, ctx, loop_scope)
                let final_truth: bool = (not truth_val) if negate else truth_val
                if final_truth:
                    match _render_nodes(then_body, ctx, loop_scope):
                        case Err(e):
                            return Err(e)
                        case Ok(s):
                            out = out + s
                else:
                    match _render_nodes(else_body, ctx, loop_scope):
                        case Err(e2):
                            return Err(e2)
                        case Ok(s2):
                            out = out + s2
            case TnFor(var_name, iter_name, body_f):
                let series: list[dict[str, str]]? = ctx.lists.get(iter_name)
                if series is None:
                    pass
                else:
                    for item in series:
                        mut next_scope: dict[str, dict[str, str]] = {}
                        for k in loop_scope:
                            next_scope[k] = loop_scope[k]
                        next_scope[var_name] = item
                        match _render_nodes(body_f, ctx, next_scope):
                            case Err(e3):
                                return Err(e3)
                            case Ok(s3):
                                out = out + s3
            case TnBlock(block_name, default_body):
                let override: list[TplNode]? = ctx.blocks.get(block_name)
                let body_to_render: list[TplNode] = override if override is not None else default_body
                match _render_nodes(body_to_render, ctx, loop_scope):
                    case Err(e4):
                        return Err(e4)
                    case Ok(s4):
                        out = out + s4
            case TnExtends(_):
                pass
    return Ok(out)


pub def render_template(name: str, ctx: RenderCtx) -> Result[str, RenderError]:
    let tpl: Template? = ctx.templates.get(name)
    if tpl is None:
        return Err(RenderError(line=0, detail=f"unknown template {name!r}"))
    let parent: str? = _find_extends(tpl.nodes)
    # Collect overriding blocks from this template before walking parent.
    _collect_blocks(tpl.nodes, ctx.blocks)
    if parent is not None:
        return render_template(parent, ctx)
    return _render_nodes(tpl.nodes, ctx, {})
