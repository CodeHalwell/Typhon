from domain import JobId, OperatorId
from connectors import LateSideOutput, Sink
from connectors import Source
from .stream_op import Operator
from state import WindowKind


# A node in the topology DAG. Each node holds enough information to be
# scheduled by the runner.
pub class TopologyNode:
    id: OperatorId
    parent_ids: list[OperatorId]
    has_window: bool
    window_kind_size_ms: int
    window_kind_slide_ms: int
    window_kind_label: str
    is_keyed_aggregate: bool
    aggregate_field: str
    is_join: bool


pub def new_topology_node(id: OperatorId, parent_ids: list[OperatorId]) -> TopologyNode:
    return TopologyNode(
        id=id,
        parent_ids=parent_ids,
        has_window=False,
        window_kind_size_ms=0,
        window_kind_slide_ms=0,
        window_kind_label="none",
        is_keyed_aggregate=False,
        aggregate_field="",
        is_join=False,
    )


impl TopologyNode:
    def with_window(self, kind: WindowKind) -> None:
        from state import window_kind_label, WTumbling, WSliding, WSession
        self.has_window = True
        self.window_kind_label = window_kind_label(kind)
        match kind:
            case WTumbling(size):
                self.window_kind_size_ms = size
                self.window_kind_slide_ms = size
            case WSliding(size, slide):
                self.window_kind_size_ms = size
                self.window_kind_slide_ms = slide
            case WSession(gap):
                self.window_kind_size_ms = gap
                self.window_kind_slide_ms = gap

    def mark_aggregate(self, field: str) -> None:
        self.is_keyed_aggregate = True
        self.aggregate_field = field

    def mark_join(self) -> None:
        self.is_join = True


# A Topology is the DAG of sources → operators → sinks for one job.
pub class Topology:
    job_id: JobId
    sources: list[Source]
    operators: list[Operator[object, object]]
    sinks: list[Sink]
    nodes: list[TopologyNode]
    late_side_output: LateSideOutput


pub def new_topology(job_id: JobId, late_name: str) -> Topology:
    from connectors import new_late_side_output
    return Topology(
        job_id=job_id,
        sources=[],
        operators=[],
        sinks=[],
        nodes=[],
        late_side_output=new_late_side_output(late_name),
    )


impl Topology:
    def add_source(self, src: Source) -> None:
        self.sources.append(src)
        self.nodes.append(new_topology_node(src.id, []))

    def add_operator(
        self, op: Operator[object, object], parent_id: OperatorId,
    ) -> TopologyNode:
        self.operators.append(op)
        let node: TopologyNode = new_topology_node(op.id, [parent_id])
        self.nodes.append(node)
        return node

    def add_sink(self, sink: Sink, parent_id: OperatorId) -> None:
        self.sinks.append(sink)
        let node: TopologyNode = new_topology_node(sink.id, [parent_id])
        self.nodes.append(node)

    def add_join(
        self,
        op: Operator[object, object],
        left_id: OperatorId,
        right_id: OperatorId,
    ) -> None:
        self.operators.append(op)
        let node: TopologyNode = new_topology_node(op.id, [left_id, right_id])
        node.mark_join()
        self.nodes.append(node)

    def describe(self) -> list[str]:
        mut out: list[str] = []
        for n in self.nodes:
            let parents: str = ",".join([str(p) for p in n.parent_ids])
            out.append(f"node {n.id} parents=[{parents}] window={n.window_kind_label}")
        return out

    def operator_count(self) -> int:
        return len(self.operators)
