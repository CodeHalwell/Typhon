from typing import Callable

from event import Envelope
from ids import OperatorId, StreamKey


# Sealed-union OperatorKind — used to tag operator nodes in the topology so the
# runner can dispatch to the correct execution strategy.
pub type OperatorKind = OkSource | OkMap | OkFilter | OkKeyBy | OkWindow | OkAggregate | OkReduce | OkJoin | OkSink


pub class OkSource:
    pass


pub class OkMap:
    pass


pub class OkFilter:
    pass


pub class OkKeyBy:
    pass


pub class OkWindow:
    pass


pub class OkAggregate:
    pass


pub class OkReduce:
    pass


pub class OkJoin:
    pass


pub class OkSink:
    pass


pub def kind_label(k: OperatorKind) -> str:
    match k:
        case OkSource():    return "source"
        case OkMap():       return "map"
        case OkFilter():    return "filter"
        case OkKeyBy():     return "key-by"
        case OkWindow():    return "window"
        case OkAggregate(): return "aggregate"
        case OkReduce():    return "reduce"
        case OkJoin():      return "join"
        case OkSink():      return "sink"
    raise RuntimeError("unreachable")


# An Operator[I, O] takes envelopes carrying I-typed payloads and produces
# envelopes carrying O-typed payloads. We materialise this as a concrete
# generic class with a `step` callable so cross-module conformance works.
#
# `step(env)` returns the list of envelopes to forward downstream (may be
# empty, may be many — for example a window-flush emits N aggregate rows).
pub class Operator[I, O]:
    id: OperatorId
    kind: OperatorKind
    step: Callable[[Envelope], list[Envelope]]
    on_end: Callable[[], list[Envelope]]


# Stream[T] is a logical stream of T-payloads. It owns a reference back to the
# topology so chained operator calls (`.map(...).filter(...)`) add nodes to a
# shared builder.
pub class Stream[T]:
    source_id: OperatorId
    # The chain of operator-ids that this stream has accumulated.
    op_chain: list[OperatorId]


pub def new_stream(source_id: OperatorId) -> Stream[object]:
    return Stream(source_id=source_id, op_chain=[source_id])


pub def extend_stream(prev: Stream[object], op_id: OperatorId) -> Stream[object]:
    mut chain: list[OperatorId] = []
    for c in prev.op_chain:
        chain.append(c)
    chain.append(op_id)
    return Stream(source_id=prev.source_id, op_chain=chain)


# Concrete operator builders. Each returns an Operator whose `step` callable
# closes over a small local state object.

pub def make_map_op[I, O](
    id: OperatorId,
    fn: Callable[[object], object],
) -> Operator[I, O]:
    def step(env: Envelope) -> list[Envelope]:
        from event import is_record, make_record_envelope
        if not is_record(env):
            return [env]
        let new_payload: object = fn(env.record_payload)
        return [make_record_envelope(env.timestamp_ms, env.key, new_payload)]

    def on_end() -> list[Envelope]:
        return []

    return Operator(id=id, kind=OkMap(), step=step, on_end=on_end)


pub def make_filter_op[T](
    id: OperatorId,
    predicate: Callable[[object], bool],
) -> Operator[T, T]:
    def step(env: Envelope) -> list[Envelope]:
        from event import is_record
        if not is_record(env):
            return [env]
        if predicate(env.record_payload):
            return [env]
        return []

    def on_end() -> list[Envelope]:
        return []

    return Operator(id=id, kind=OkFilter(), step=step, on_end=on_end)


pub def make_key_by_op[T](
    id: OperatorId,
    keyer: Callable[[object], str],
) -> Operator[T, T]:
    def step(env: Envelope) -> list[Envelope]:
        from event import is_record, make_record_envelope
        if not is_record(env):
            return [env]
        let new_key: str = keyer(env.record_payload)
        return [make_record_envelope(
            env.timestamp_ms, StreamKey(new_key), env.record_payload,
        )]

    def on_end() -> list[Envelope]:
        return []

    return Operator(id=id, kind=OkKeyBy(), step=step, on_end=on_end)


# A reduce operator with an externally-managed accumulator. `reducer(acc, x)`
# yields the next accumulator; the operator emits the running accumulator on
# every record.
pub class ReduceState:
    has_seed: bool
    acc: object


pub def make_reduce_op[T](
    id: OperatorId,
    seed: object,
    reducer: Callable[[object, object], object],
) -> Operator[T, T]:
    let state: ReduceState = ReduceState(has_seed=True, acc=seed)

    def step(env: Envelope) -> list[Envelope]:
        from event import is_record, make_record_envelope
        if not is_record(env):
            return [env]
        state.acc = reducer(state.acc, env.record_payload)
        return [make_record_envelope(env.timestamp_ms, env.key, state.acc)]

    def on_end() -> list[Envelope]:
        return []

    return Operator(id=id, kind=OkReduce(), step=step, on_end=on_end)


# A windowed-join operator state: two buffers per key, flushed when both sides
# have at least one record in the same window. Simplified for the demo —
# emits all left × right pairs within the window.
pub class JoinBufferEntry:
    key: StreamKey
    ts_ms: int
    payload: object
    side: int  # 0 = left, 1 = right


pub class JoinOpState:
    window_ms: int
    buffered: list[JoinBufferEntry]


pub def new_join_op_state(window_ms: int) -> JoinOpState:
    return JoinOpState(window_ms=window_ms, buffered=[])


pub def make_join_op[L, R, O](
    id: OperatorId,
    window_ms: int,
    combiner: Callable[[object, object], object],
) -> Operator[object, O]:
    let state: JoinOpState = new_join_op_state(window_ms)

    def step(env: Envelope) -> list[Envelope]:
        from event import is_record, make_record_envelope
        if not is_record(env):
            return [env]
        # Treat all records as "left side" for this demo entry-point; a real
        # join would discriminate by source-operator-id at the topology layer.
        let entry: JoinBufferEntry = JoinBufferEntry(
            key=env.key, ts_ms=env.timestamp_ms, payload=env.record_payload, side=0,
        )
        state.buffered.append(entry)
        # Garbage-collect entries older than window.
        mut keep: list[JoinBufferEntry] = []
        let horizon: int = env.timestamp_ms - state.window_ms
        for e in state.buffered:
            if e.ts_ms >= horizon:
                keep.append(e)
        state.buffered = keep
        # Emit one synthetic joined record per buffered same-key entry.
        mut out: list[Envelope] = []
        for e in state.buffered:
            if str(e.key) == str(env.key) and e.ts_ms != env.timestamp_ms:
                let joined: object = combiner(e.payload, env.record_payload)
                out.append(make_record_envelope(env.timestamp_ms, env.key, joined))
        return out

    def on_end() -> list[Envelope]:
        return []

    return Operator(id=id, kind=OkJoin(), step=step, on_end=on_end)
