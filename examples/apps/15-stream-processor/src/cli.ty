import asyncio

from config import JobConfig, build_tag, default_config, loaded_config
from demo_job import run_collecting_demo, run_demo
from models import AggregateRow, error_message


pub def print_banner() -> None:
    print(f"typhon-stream-processor (build={build_tag()})")
    print("a Flink-lite stream processing engine for event-time pipelines")


pub def print_help() -> None:
    print("usage: stream-processor [demo|collect|describe|help]")
    print("  demo      — run the stock-price moving-average demo end-to-end")
    print("  collect   — run a buffer-sink variant and print collected rows")
    print("  describe  — print the topology of the demo job and exit")
    print("  help      — print this help text")


pub async def cmd_demo() -> None:
    mut cfg: JobConfig = default_config()
    match loaded_config():
        case Ok(c):
            cfg = c
        case Err(e):
            print("config error: " + error_message(e))
            return
    let rows: list[AggregateRow] = await run_demo(cfg)
    print(f"demo finished: emitted {len(rows)} aggregate row(s)")
    mut shown: int = 0
    for row in rows:
        if shown >= 6:
            break
        print(
            f"  win[{row.window_start_ms}..{row.window_end_ms}) "
            f"key={row.key} count={row.count} "
            f"avg={row.avg_value:.2f} min={row.min_value:.2f} "
            f"max={row.max_value:.2f}"
        )
        shown = shown + 1


pub async def cmd_collect() -> None:
    let cfg: JobConfig = default_config()
    let collected: tuple[list[object], int] = await run_collecting_demo(cfg)
    let items: list[object] = collected[0]
    let row_count: int = collected[1]
    print(f"collect finished: buffer={len(items)} aggregate_rows={row_count}")


pub def cmd_describe() -> None:
    from demo_job import build_demo_topology
    let cfg: JobConfig = default_config()
    let topo = build_demo_topology(cfg)
    print(f"topology has {topo.operator_count()} operator(s)")
    for line in topo.describe():
        print("  " + line)


pub def dispatch(argv: list[str]) -> int:
    if len(argv) < 2:
        print_banner()
        print_help()
        return 0
    let cmd: str = argv[1]
    if cmd == "help" or cmd == "-h" or cmd == "--help":
        print_banner()
        print_help()
        return 0
    if cmd == "describe":
        cmd_describe()
        return 0
    if cmd == "demo":
        asyncio.run(cmd_demo())
        return 0
    if cmd == "collect":
        asyncio.run(cmd_collect())
        return 0
    print(f"unknown command: {cmd}")
    print_help()
    return 2
