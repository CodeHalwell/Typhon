from typing import Callable

from domain import Envelope, make_record, make_watermark, make_end_of_stream
from domain import OperatorId, StreamKey, WatermarkTs
from domain import StockTick


# A Source is a concrete class carrying a `produce` callable that returns a
# fresh list of envelopes each invocation. We use a concrete-class-with-Callable
# rather than a cross-module `interface Source[T]` because the latter cannot be
# satisfied across module boundaries (TYPHON_FEEDBACK round-1 #2).
pub class Source:
    id: OperatorId
    produce: Callable[[], list[Envelope]]


# A ListSource[T] driven by a fixture list. Stateful — once exhausted it emits
# a final end-of-stream envelope.
pub class ListSource[T]:
    id: OperatorId
    items: list[Envelope]
    cursor: int
    finished: bool


impl[T] ListSource[T]:
    def pump(self) -> list[Envelope]:
        if self.finished:
            return []
        mut out: list[Envelope] = []
        while self.cursor < len(self.items):
            out.append(self.items[self.cursor])
            self.cursor = self.cursor + 1
        out.append(make_end_of_stream())
        self.finished = True
        return out


pub def list_source_for_ticks(
    id: OperatorId, ticks: list[tuple[int, str, int]],
) -> Source:
    mut envs: list[Envelope] = []
    for triple in ticks:
        let ts_ms: int = triple[0]
        let symbol: str = triple[1]
        let price: int = triple[2]
        envs.append(make_record(
            ts_ms, StreamKey(symbol), StockTick(symbol=symbol, price_cents=price, venue="L"),
        ))
    let inner: ListSource[StockTick] = ListSource(
        id=id, items=envs, cursor=0, finished=False,
    )
    return Source(id=id, produce=inner.pump)


# A GeneratorSource[T] that synthesises a deterministic walk of stock ticks
# over event-time. Useful for the moving-average demo without external data.
pub class GeneratorSource[T]:
    id: OperatorId
    symbols: list[str]
    start_ts_ms: int
    step_ms: int
    horizon_ms: int
    seed: int
    cursor_ms: int
    rng_state: int
    finished: bool


def _lcg(state: int) -> int:
    # Tiny deterministic LCG (Numerical Recipes). Pure int math, no stdlib
    # random — keeps the demo reproducible.
    let next_v: int = (1664525 * state + 1013904223) % 4294967296
    return next_v


impl[T] GeneratorSource[T]:
    def pump(self) -> list[Envelope]:
        if self.finished:
            return []
        mut out: list[Envelope] = []
        mut state: int = self.rng_state
        mut t: int = self.cursor_ms
        let end_t: int = self.start_ts_ms + self.horizon_ms
        # Emit a fixed batch per pump call so the runner can interleave.
        mut produced: int = 0
        while t < end_t and produced < 32:
            state = _lcg(state)
            let sym_idx: int = state % len(self.symbols)
            let symbol: str = self.symbols[sym_idx]
            state = _lcg(state)
            # Price walks in cents around 10000 ± up to ~500
            let drift: int = (state % 1001) - 500
            let price: int = 10000 + drift
            out.append(make_record(
                t, StreamKey(symbol),
                StockTick(symbol=symbol, price_cents=price, venue="G"),
            ))
            t = t + self.step_ms
            produced = produced + 1
        # Emit a watermark for the latest event-time we produced.
        if produced > 0:
            out.append(make_watermark(WatermarkTs(t - self.step_ms)))
        self.cursor_ms = t
        self.rng_state = state
        if t >= end_t:
            out.append(make_end_of_stream())
            self.finished = True
        return out


pub def new_generator_source(
    id: OperatorId,
    symbols: list[str],
    start_ts_ms: int,
    step_ms: int,
    horizon_ms: int,
    seed: int,
) -> Source:
    let inner: GeneratorSource[StockTick] = GeneratorSource(
        id=id,
        symbols=symbols,
        start_ts_ms=start_ts_ms,
        step_ms=step_ms,
        horizon_ms=horizon_ms,
        seed=seed,
        cursor_ms=start_ts_ms,
        rng_state=seed,
        finished=False,
    )
    return Source(id=id, produce=inner.pump)
