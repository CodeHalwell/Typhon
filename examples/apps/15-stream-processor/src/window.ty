from ids import StreamKey, WindowId
from keyed_state import AggregateCell, empty_cell
from models import AggregateRow


# Sealed-union over the supported window kinds. Tumbling and Sliding both have
# size+slide in milliseconds (for Tumbling, slide == size). Session windows are
# closed by a gap of inactivity.
pub type WindowKind = WTumbling | WSliding | WSession


pub class WTumbling:
    size_ms: int


pub class WSliding:
    size_ms: int
    slide_ms: int


pub class WSession:
    gap_ms: int


pub def make_tumbling(size_ms: int) -> WindowKind:
    return WTumbling(size_ms=size_ms)


pub def make_sliding(size_ms: int, slide_ms: int) -> WindowKind:
    return WSliding(size_ms=size_ms, slide_ms=slide_ms)


pub def make_session(gap_ms: int) -> WindowKind:
    return WSession(gap_ms=gap_ms)


pub def window_kind_label(k: WindowKind) -> str:
    match k:
        case WTumbling(_):     return "tumbling"
        case WSliding(_, _):   return "sliding"
        case WSession(_):      return "session"
    raise RuntimeError("unreachable")


# A pane is one concrete window instance with a start..end range. Sliding
# windows produce overlapping panes; tumbling windows produce non-overlapping
# ones.
pub class Pane:
    id: WindowId
    key: StreamKey
    start_ms: int
    end_ms: int
    cell: AggregateCell


pub def new_pane(id: WindowId, key: StreamKey, start_ms: int, end_ms: int) -> Pane:
    return Pane(
        id=id,
        key=key,
        start_ms=start_ms,
        end_ms=end_ms,
        cell=empty_cell(),
    )


# Compute which window starts a given event-time falls into for the given
# window kind. For tumbling, returns a single start; for sliding, returns all
# overlapping starts. Session windows are assigned dynamically and use a
# different code path.
pub def assign_windows(kind: WindowKind, ts_ms: int) -> list[tuple[int, int]]:
    match kind:
        case WTumbling(size):
            let start: int = (ts_ms // size) * size
            return [(start, start + size)]
        case WSliding(size, slide):
            mut out: list[tuple[int, int]] = []
            # First slide-start at or before ts_ms is floor(ts_ms / slide) * slide.
            # Walk back `size // slide` panes; each is a valid candidate window.
            let last_start: int = (ts_ms // slide) * slide
            mut s: int = last_start
            while s > ts_ms - size and s >= 0:
                out.append((s, s + size))
                s = s - slide
            return out
        case WSession(_):
            # Session windows aren't assigned by interval — they grow on the
            # fly. The runner handles session windows via a separate path; this
            # branch returns an empty assignment, which assign_windows callers
            # must treat as "use session logic".
            return []
    raise RuntimeError("unreachable")


# Build the aggregate row that a pane emits on close.
pub def pane_to_row(pane: Pane) -> AggregateRow:
    let cell: AggregateCell = pane.cell
    let avg: float = cell.avg()
    let min_v: float = cell.min_value if cell.has_value else 0.0
    let max_v: float = cell.max_value if cell.has_value else 0.0
    return AggregateRow(
        key=pane.key,
        window_start_ms=pane.start_ms,
        window_end_ms=pane.end_ms,
        count=cell.count,
        sum_value=cell.sum_value,
        min_value=min_v,
        max_value=max_v,
        avg_value=avg,
    )
