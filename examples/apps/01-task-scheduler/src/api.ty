import asyncio
from pathlib import Path

from fastapi import FastAPI, HTTPException

from config import SchedulerConfig, load_config, worker_id_for
from handlers import always_fail_handler, flaky_handler, hello_handler, slow_handler
from ids import JobName, TaskId, WorkerId
from models import (
    EventView,
    SubmitTaskRequest,
    SubmitTaskResponse,
    Task,
    TaskView,
)
from scheduler import Registry, Scheduler
from store import Store, open_store


pub class AppState:
    config: SchedulerConfig
    store: Store
    scheduler: Scheduler
    registry: Registry
    worker_ids: list[WorkerId]


def _open_store_or_raise(path: Path) -> Store:
    match open_store(path):
        case Ok(store):
            return store
        case Err(e):
            raise RuntimeError(f"{e.op}: {e.reason}")
    raise RuntimeError("unreachable")


pub def build_state() -> AppState:
    let cfg: SchedulerConfig = load_config()
    let store: Store = _open_store_or_raise(Path(cfg.db_path))

    let registry: Registry = Registry(handlers={})
    registry.register(hello_handler())
    registry.register(slow_handler())
    registry.register(flaky_handler())
    registry.register(always_fail_handler())

    let scheduler: Scheduler = Scheduler(
        config=cfg,
        store=store,
        registry=registry,
        shutdown=asyncio.Event(),
        inflight={},
    )

    let worker_ids: list[WorkerId] = [worker_id_for(i) for i in range(cfg.worker_count)]
    return AppState(
        config=cfg,
        store=store,
        scheduler=scheduler,
        registry=registry,
        worker_ids=worker_ids,
    )


pub let STATE: AppState = build_state()
pub let app: FastAPI = FastAPI(title="Typhon Task Scheduler")


def _task_to_view(task: Task) -> TaskView:
    return TaskView(
        id=int(task.id),
        job=str(task.job),
        status=task.status_label(),
        priority=task.priority,
        attempts=task.attempts,
        last_error=task.last_error,
        created_at=task.created_at.isoformat(),
        updated_at=task.updated_at.isoformat(),
    )


@app.post("/tasks", response_model=SubmitTaskResponse)
def submit_task(req: SubmitTaskRequest) -> SubmitTaskResponse:
    let deps: list[TaskId] = [TaskId(d) for d in req.depends_on]
    match STATE.scheduler.submit(JobName(req.job), req.args, req.priority, deps):
        case Ok(task):
            return SubmitTaskResponse(task_id=int(task.id))
        case Err(e):
            raise HTTPException(status_code=500, detail=f"{e.op}: {e.reason}")
    raise RuntimeError("unreachable")


@app.get("/tasks/{task_id}", response_model=TaskView)
def get_task(task_id: int) -> TaskView:
    match STATE.store.fetch_task(TaskId(task_id)):
        case Ok(task):
            return _task_to_view(task)
        case Err(e):
            raise HTTPException(status_code=404, detail=f"{e.op}: {e.reason}")
    raise RuntimeError("unreachable")


@app.get("/events", response_model=list[EventView])
def list_events(since: int = 0, limit: int = 100) -> list[EventView]:
    let rows = STATE.store.events_since(since, limit)
    return [
        EventView(seq=seq, kind=kind, task_id=tid, worker_id=wid, message=msg, at=at)
        for (seq, kind, tid, wid, msg, at) in rows
    ]


@app.get("/health")
def health() -> dict[str, object]:
    return {
        "ok": True,
        "workers": len(STATE.worker_ids),
        "db": STATE.config.db_path,
    }
