import asyncio
import time
from datetime import datetime, timezone

from config import SchedulerConfig
from ids import WorkerId
from models import (
    StatusRunning,
    Task,
    make_task_started,
    make_worker_started,
    make_worker_stopped,
)
from scheduler import HandlerFailure, HandlerOk, Registry, Scheduler


pub class Worker:
    id: WorkerId
    scheduler: Scheduler
    registry: Registry


impl Worker:
    async def loop(self) -> None:
        let now: datetime = datetime.now(timezone.utc)
        self.scheduler.emit(make_worker_started(worker=self.id, at=now))
        try:
            while not self.scheduler.shutdown.is_set():
                await self._tick()
        finally:
            let stopped_at: datetime = datetime.now(timezone.utc)
            self.scheduler.emit(make_worker_stopped(worker=self.id, at=stopped_at))

    async def _tick(self) -> None:
        let cfg: SchedulerConfig = self.scheduler.config
        match self.scheduler.store.claim_next_ready(self.id):
            case Ok(maybe):
                if maybe is None:
                    try:
                        await asyncio.wait_for(
                            self.scheduler.shutdown.wait(),
                            timeout=cfg.poll_interval_seconds,
                        )
                    except asyncio.TimeoutError:
                        return
                    return
                await self._execute(maybe)
            case Err(e):
                print(f"[{self.id}] claim error: {e.reason}")
                await asyncio.sleep(cfg.poll_interval_seconds)

    async def _execute(self, task: Task) -> None:
        let attempt: int = task.attempts + 1
        match task.status:
            case StatusRunning(_, _, _):
                self.scheduler.emit(make_task_started(
                    task_id=task.id,
                    worker=self.id,
                    attempt=attempt,
                    at=datetime.now(timezone.utc),
                ))
            case _:
                pass

        let handler = self.registry.lookup(task.job)
        if handler is None:
            self.scheduler.record_failure(
                task,
                message=f"no handler registered for {task.job}",
                attempt=attempt,
                retryable=False,
            )
            return

        let started_at: float = time.monotonic()
        try:
            let outcome = await asyncio.to_thread(handler.fn, task.args)
        except Exception as e:
            self.scheduler.record_failure(
                task,
                message=f"{type(e).__name__}: {e}",
                attempt=attempt,
                retryable=True,
            )
            return
        let duration_ms: int = int((time.monotonic() - started_at) * 1000.0)

        match outcome:
            case HandlerOk(summary):
                self.scheduler.record_success(task, summary, duration_ms)
            case HandlerFailure(message, retryable):
                self.scheduler.record_failure(task, message, attempt, retryable)
