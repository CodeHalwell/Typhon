from .ids import ClientId, RequestId, RouteId, TraceId, UpstreamId


# ---------------------------------------------------------------------------
# HTTP-level value types used end-to-end through the gateway. These are
# internal `class` types (NOT pydantic models — those live at the FastAPI
# boundary in `wire.ty`).
# ---------------------------------------------------------------------------


pub class HttpRequest:
    request_id: RequestId
    trace_id: TraceId
    client_id: ClientId
    method: str
    path: str
    headers: dict[str, str]
    body: bytes


pub class HttpResponse:
    status: int
    headers: dict[str, str]
    body: bytes
    upstream: UpstreamId?
    route_id: RouteId?
    elapsed_ms: int

pub def text_response(status: int, body: str) -> HttpResponse:
    return HttpResponse(
        status=status,
        headers={"content-type": "text/plain; charset=utf-8"},
        body=body.encode("utf-8"),
        upstream=None,
        route_id=None,
        elapsed_ms=0,
    )


pub def json_response(status: int, body: str) -> HttpResponse:
    return HttpResponse(
        status=status,
        headers={"content-type": "application/json"},
        body=body.encode("utf-8"),
        upstream=None,
        route_id=None,
        elapsed_ms=0,
    )


# ---------------------------------------------------------------------------
# Error types — split into distinct nominal classes so a `Result[T, GwError]`
# union can carry rich error context. (R1-#1 workaround: factories below.)
# ---------------------------------------------------------------------------


pub type GwError = NoRouteError | NoUpstreamError | UpstreamFailure | BreakerOpen | RateLimitExceeded | AuthRequired


pub class NoRouteError:
    method: str
    path: str


pub class NoUpstreamError:
    route_id: RouteId
    reason: str


pub class UpstreamFailure:
    upstream: UpstreamId
    status: int
    message: str


pub class BreakerOpen:
    upstream: UpstreamId
    cooldown_remaining_ms: int


pub class RateLimitExceeded:
    route_id: RouteId
    client_id: ClientId
    retry_after_ms: int


pub class AuthRequired:
    reason: str


pub def err_no_route(method: str, path: str) -> GwError:
    return NoRouteError(method=method, path=path)


pub def err_no_upstream(route_id: RouteId, reason: str) -> GwError:
    return NoUpstreamError(route_id=route_id, reason=reason)


pub def err_upstream_failure(upstream: UpstreamId, status: int, message: str) -> GwError:
    return UpstreamFailure(upstream=upstream, status=status, message=message)


pub def err_breaker_open(upstream: UpstreamId, cooldown_remaining_ms: int) -> GwError:
    return BreakerOpen(upstream=upstream, cooldown_remaining_ms=cooldown_remaining_ms)


pub def err_rate_limit(route_id: RouteId, client_id: ClientId, retry_after_ms: int) -> GwError:
    return RateLimitExceeded(route_id=route_id, client_id=client_id, retry_after_ms=retry_after_ms)


pub def err_auth(reason: str) -> GwError:
    return AuthRequired(reason=reason)


pub def error_status(err: GwError) -> int:
    match err:
        case NoRouteError(_, _):       return 404
        case NoUpstreamError(_, _):    return 503
        case UpstreamFailure(_, s, _): return s if s >= 500 else 502
        case BreakerOpen(_, _):        return 503
        case RateLimitExceeded(_, _, _): return 429
        case AuthRequired(_):          return 401
    raise RuntimeError("unreachable")


pub def error_message(err: GwError) -> str:
    match err:
        case NoRouteError(m, p):       return f"no route matches {m} {p}"
        case NoUpstreamError(r, why):  return f"route {str(r)} has no upstream: {why}"
        case UpstreamFailure(u, s, m): return f"upstream {str(u)} returned {s}: {m}"
        case BreakerOpen(u, c):        return f"breaker open for {str(u)} ({c}ms left)"
        case RateLimitExceeded(_, c, ra): return f"rate limit for client {str(c)} (retry in {ra}ms)"
        case AuthRequired(why):        return f"authentication required: {why}"
    raise RuntimeError("unreachable")
