import asyncio
import random

from runtime import RetryPolicy


# ---------------------------------------------------------------------------
# Sealed-union RetryOutcome — per-attempt classification of an upstream call.
# Round-1 #1 workaround: factory functions in this module to widen variants
# into the union when crossing module boundaries.
# ---------------------------------------------------------------------------


pub type RetryOutcome = RetryOk | RetryAgain | RetryGiveUp


pub class RetryOk:
    attempt: int
    status: int


pub class RetryAgain:
    attempt: int
    reason: str
    delay_ms: int


pub class RetryGiveUp:
    attempts: int
    last_reason: str

pub def outcome_label(o: RetryOutcome) -> str:
    match o:
        case RetryOk(_, _):    return "ok"
        case RetryAgain(_, _, _): return "again"
        case RetryGiveUp(_, _):  return "giveup"
    raise RuntimeError("unreachable")


# ---------------------------------------------------------------------------
# Per-error-class predicate: should this status / exception class trigger a
# retry? Centralised here so middleware can stay simple.
# ---------------------------------------------------------------------------


pub def is_retryable_status(status: int) -> bool:
    if status == 502 or status == 503 or status == 504:
        return True
    if status == 429:
        return True
    return False


pub def is_retryable_exception(name: str) -> bool:
    if name == "TimeoutException":
        return True
    if name == "ReadTimeout":
        return True
    if name == "ConnectError":
        return True
    if name == "ConnectTimeout":
        return True
    if name == "RemoteProtocolError":
        return True
    return False


pub def backoff_delay_ms(policy: RetryPolicy, attempt: int) -> int:
    let raw_exp: int = attempt - 1
    let bounded_exp: int = raw_exp if raw_exp < 20 else 20
    let base: float = float(policy.base_delay_ms)
    let raw: float = base * float(2 ** bounded_exp)
    let cap: float = float(policy.max_delay_ms)
    let bounded: float = raw if raw < cap else cap
    let jitter: float = bounded * policy.jitter_ratio * (random.random() - 0.5) * 2.0
    let total: float = bounded + jitter
    let final_val: float = total if total > 0.0 else 1.0
    return int(final_val)


pub async def sleep_ms(ms: int) -> None:
    if ms <= 0:
        return
    await asyncio.sleep(float(ms) / 1000.0)
