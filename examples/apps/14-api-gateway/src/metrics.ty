import random

from ids import RouteId


# ---------------------------------------------------------------------------
# Per-route metrics. Latency p50/p99 via reservoir sampling; counters for
# requests / errors / breaker-rejections / rate-limit-rejections.
# ---------------------------------------------------------------------------


pub class Reservoir:
    samples: list[int]
    cap: int
    seen: int


pub def new_reservoir(cap: int = 512) -> Reservoir:
    return Reservoir(samples=[], cap=cap, seen=0)


pub def record_sample(reservoir: Reservoir, value: int) -> None:
    reservoir.seen = reservoir.seen + 1
    if len(reservoir.samples) < reservoir.cap:
        reservoir.samples.append(value)
        return
    let idx: int = random.randint(0, reservoir.seen - 1)
    if idx < reservoir.cap:
        reservoir.samples[idx] = value


def _percentile(samples: list[int], pct: float) -> int:
    if len(samples) == 0:
        return 0
    mut sorted_copy: list[int] = []
    for s in samples:
        sorted_copy.append(s)
    sorted_copy.sort()
    let raw_idx: int = int(pct * float(len(sorted_copy)))
    let clamped: int = raw_idx if raw_idx < len(sorted_copy) else len(sorted_copy) - 1
    return sorted_copy[clamped]


pub def percentile(reservoir: Reservoir, pct: float) -> int:
    return _percentile(reservoir.samples, pct)


pub class RouteMetrics:
    route_id: RouteId
    requests: int
    successes: int
    errors: int
    breaker_rejections: int
    rate_limit_rejections: int
    latency_ms: Reservoir


pub def new_route_metrics(route_id: RouteId) -> RouteMetrics:
    return RouteMetrics(
        route_id=route_id,
        requests=0,
        successes=0,
        errors=0,
        breaker_rejections=0,
        rate_limit_rejections=0,
        latency_ms=new_reservoir(512),
    )


pub class MetricsRegistry:
    per_route: dict[str, RouteMetrics]
    total_requests: int
    total_errors: int


pub def new_metrics_registry() -> MetricsRegistry:
    return MetricsRegistry(per_route={}, total_requests=0, total_errors=0)


impl MetricsRegistry:
    def metrics_for(self, route: RouteId) -> RouteMetrics:
        let key: str = str(route)
        let existing: RouteMetrics? = self.per_route.get(key)
        if existing is not None:
            return existing
        let fresh: RouteMetrics = new_route_metrics(route)
        self.per_route[key] = fresh
        return fresh

    def record_request(self, route: RouteId, status: int, latency_ms: int) -> None:
        let m: RouteMetrics = self.metrics_for(route)
        m.requests = m.requests + 1
        self.total_requests = self.total_requests + 1
        if status >= 200 and status < 400:
            m.successes = m.successes + 1
        else:
            m.errors = m.errors + 1
            self.total_errors = self.total_errors + 1
        record_sample(m.latency_ms, latency_ms)

    def record_breaker_rejection(self, route: RouteId) -> None:
        let m: RouteMetrics = self.metrics_for(route)
        m.breaker_rejections = m.breaker_rejections + 1
        m.requests = m.requests + 1
        m.errors = m.errors + 1
        self.total_requests = self.total_requests + 1
        self.total_errors = self.total_errors + 1

    def record_rate_limit_rejection(self, route: RouteId) -> None:
        let m: RouteMetrics = self.metrics_for(route)
        m.rate_limit_rejections = m.rate_limit_rejections + 1
        m.requests = m.requests + 1
        m.errors = m.errors + 1
        self.total_requests = self.total_requests + 1
        self.total_errors = self.total_errors + 1

    def render_prometheus(self) -> str:
        mut lines: list[str] = []
        lines.append("# HELP gateway_requests_total Total requests handled, by route.")
        lines.append("# TYPE gateway_requests_total counter")
        for (key, m) in self.per_route.items():
            lines.append(f'gateway_requests_total{{route="{key}"}} {m.requests}')
        lines.append("# HELP gateway_errors_total Total errored requests, by route.")
        lines.append("# TYPE gateway_errors_total counter")
        for (key2, m2) in self.per_route.items():
            lines.append(f'gateway_errors_total{{route="{key2}"}} {m2.errors}')
        lines.append("# HELP gateway_breaker_rejects_total Requests rejected by an open breaker.")
        lines.append("# TYPE gateway_breaker_rejects_total counter")
        for (key3, m3) in self.per_route.items():
            lines.append(f'gateway_breaker_rejects_total{{route="{key3}"}} {m3.breaker_rejections}')
        lines.append("# HELP gateway_rate_limit_rejects_total Requests rejected by the rate limiter.")
        lines.append("# TYPE gateway_rate_limit_rejects_total counter")
        for (key4, m4) in self.per_route.items():
            lines.append(f'gateway_rate_limit_rejects_total{{route="{key4}"}} {m4.rate_limit_rejections}')
        lines.append("# HELP gateway_latency_p50_ms p50 latency by route.")
        lines.append("# TYPE gateway_latency_p50_ms gauge")
        for (key5, m5) in self.per_route.items():
            lines.append(f'gateway_latency_p50_ms{{route="{key5}"}} {percentile(m5.latency_ms, 0.5)}')
        lines.append("# HELP gateway_latency_p99_ms p99 latency by route.")
        lines.append("# TYPE gateway_latency_p99_ms gauge")
        for (key6, m6) in self.per_route.items():
            lines.append(f'gateway_latency_p99_ms{{route="{key6}"}} {percentile(m6.latency_ms, 0.99)}')
        return "\n".join(lines) + "\n"
