import time
from typing import Callable

from auth import TokenStore
from balancer import Balancer
from forward import ForwardContext, forward_with_retry, pick_upstream_or_error
from ids import ClientId, RouteId
from limiter import RateLimiter
from metrics import MetricsRegistry
from models import (
    GwError,
    HttpRequest,
    HttpResponse,
    err_auth,
    err_no_route,
    err_no_upstream,
    err_rate_limit,
    error_message,
    error_status,
    text_response,
)
from routes import (
    MatchHit,
    MatchMethodMismatch,
    MatchMiss,
    Route,
    RouteTable,
)
from upstream import Upstream


# ---------------------------------------------------------------------------
# Middleware shape — concrete class. The Round-1 #2 workaround is on full
# display here: we cannot declare a cross-module
# `interface Middleware: async def handle(...)` because cross-module
# interface conformance is rejected. Even worse, the next-style
# `Callable[..., Awaitable[Result[T, E]]]` shape that the original design
# used does NOT type-check (R3 candidate: `await` of a value whose declared
# type is `Awaitable[T]` from a `Callable` return doesn't unwrap to `T`).
#
# Two-pass design adopted instead: each middleware is a concrete class with
# a `name` field plus a `pre`-pass synchronous "decide whether to short
# circuit" hook and a `post`-pass hook that runs after the upstream call.
# The pre-pass can return a short-circuit `Result[HttpResponse, GwError]`
# (`Some(...)` = short-circuit, `None` = continue). All composition happens
# inside one `handle_request` async function so we never need to express a
# higher-order async type that Typhon cannot await-unwrap.
# ---------------------------------------------------------------------------


pub type PreHook = Callable[[HttpRequest], Result[HttpResponse, GwError]?]
pub type PostHook = Callable[[HttpRequest, Result[HttpResponse, GwError], int], Result[HttpResponse, GwError]]


pub class Middleware:
    name: str
    pre: PreHook
    post: PostHook


pub def new_middleware(name: str, pre: PreHook, post: PostHook) -> Middleware:
    return Middleware(name=name, pre=pre, post=post)


# ---------------------------------------------------------------------------
# Gateway-wide state threaded through every layer. Each `make_*` factory
# closes over this so middleware bodies stay tiny.
# ---------------------------------------------------------------------------


pub class GatewayCore:
    table: RouteTable
    forward: ForwardContext
    rate_limiter: RateLimiter
    metrics: MetricsRegistry
    tokens: TokenStore
    balancers: dict[str, Balancer]
    matched: dict[str, MatchHit]


pub def new_gateway_core(
    table: RouteTable,
    forward: ForwardContext,
    rate_limiter: RateLimiter,
    metrics: MetricsRegistry,
    tokens: TokenStore,
    balancers: dict[str, Balancer],
) -> GatewayCore:
    return GatewayCore(
        table=table,
        forward=forward,
        rate_limiter=rate_limiter,
        metrics=metrics,
        tokens=tokens,
        balancers=balancers,
        matched={},
    )


pub def balancer_for(core: GatewayCore, route: Route) -> Balancer?:
    return core.balancers.get(str(route.id))


def _noop_post(req: HttpRequest, resp: Result[HttpResponse, GwError], elapsed_ms: int) -> Result[HttpResponse, GwError]:
    return resp


# ---------------------------------------------------------------------------
# Layer: routing. Pre-hook resolves the path → route and stashes the result.
# ---------------------------------------------------------------------------


pub def make_routing_middleware(core: GatewayCore) -> Middleware:
    def routing_pre(request: HttpRequest) -> Result[HttpResponse, GwError]?:
        let mr = core.table.match_request(request.method, request.path)
        match mr:
            case MatchHit(route):
                core.matched[str(request.request_id)] = MatchHit(route=route)
                return None
            case MatchMiss(_):
                return Err(err_no_route(request.method, request.path))
            case MatchMethodMismatch(_, _, allowed):
                let allowed_str: str = ", ".join(allowed)
                return Err(err_no_route(request.method, f"{request.path} (allowed: {allowed_str})"))
        raise RuntimeError("unreachable")

    def routing_post(request: HttpRequest, resp: Result[HttpResponse, GwError], elapsed_ms: int) -> Result[HttpResponse, GwError]:
        if str(request.request_id) in core.matched:
            del core.matched[str(request.request_id)]
        return resp

    return new_middleware("routing", routing_pre, routing_post)


# ---------------------------------------------------------------------------
# Layer: auth. After routing has resolved, check whether the matched route
# requires a valid bearer token.
# ---------------------------------------------------------------------------


pub def make_auth_middleware(core: GatewayCore) -> Middleware:
    def auth_pre(request: HttpRequest) -> Result[HttpResponse, GwError]?:
        let header_value: str? = request.headers.get("authorization")
        let resolved: ClientId? = core.tokens.resolve(header_value)
        if resolved is not None:
            request.client_id = resolved
        let hit: MatchHit? = core.matched.get(str(request.request_id))
        if hit is not None:
            let h: MatchHit = hit
            if h.route.requires_auth and resolved is None:
                return Err(err_auth("missing or invalid bearer token"))
        return None

    return new_middleware("auth", auth_pre, _noop_post)


# ---------------------------------------------------------------------------
# Layer: rate limit. We need to await the limiter inside the chain, so the
# limiter check lives outside the `pre` hook (which is sync). The PreHook
# only flags routes that have already exhausted their bucket on the previous
# tick — the real async acquire happens in `handle_request` directly.
# ---------------------------------------------------------------------------


pub def make_rate_limit_middleware(_core: GatewayCore) -> Middleware:
    # Rate limiting cannot be expressed as a sync pre-hook because token
    # bucket acquisition is async. The handler invokes the limiter inline
    # (see `handle_request`); this middleware exists in the chain mostly as
    # a name for the post-hook hook that surfaces 429 errors cleanly.
    def rl_pre(_req: HttpRequest) -> Result[HttpResponse, GwError]?:
        return None

    return new_middleware("rate_limit", rl_pre, _noop_post)


# ---------------------------------------------------------------------------
# Layer: tracing. Stamps the trace id back onto the response headers and
# records per-route latency in the metrics registry.
# ---------------------------------------------------------------------------


pub def make_tracing_middleware(core: GatewayCore) -> Middleware:
    def tracing_pre(_req: HttpRequest) -> Result[HttpResponse, GwError]?:
        return None

    def tracing_post(request: HttpRequest, resp: Result[HttpResponse, GwError], elapsed_ms: int) -> Result[HttpResponse, GwError]:
        let hit: MatchHit? = core.matched.get(str(request.request_id))
        let route_id: RouteId? = hit.route.id if hit is not None else None
        match resp:
            case Ok(response):
                if route_id is not None:
                    let rid: RouteId = route_id
                    core.metrics.record_request(rid, response.status, elapsed_ms)
                response.headers["x-trace-id"] = str(request.trace_id)
                response.headers["x-elapsed-ms"] = str(elapsed_ms)
                return Ok(response)
            case Err(err):
                if route_id is not None:
                    let rid2: RouteId = route_id
                    core.metrics.record_request(rid2, error_status(err), elapsed_ms)
                return Err(err)
        raise RuntimeError("unreachable")

    return new_middleware("tracing", tracing_pre, tracing_post)


# ---------------------------------------------------------------------------
# Layer: logging. Outermost, runs in the post hook of the chain so it sees
# the final response.
# ---------------------------------------------------------------------------


pub def make_logging_middleware(_core: GatewayCore) -> Middleware:
    def logging_pre(_req: HttpRequest) -> Result[HttpResponse, GwError]?:
        return None

    def logging_post(request: HttpRequest, resp: Result[HttpResponse, GwError], elapsed_ms: int) -> Result[HttpResponse, GwError]:
        match resp:
            case Ok(response):
                print(
                    f"access method={request.method} path={request.path} "
                    f"status={response.status} elapsed_ms={elapsed_ms} "
                    f"client={str(request.client_id)} trace={str(request.trace_id)}"
                )
                return Ok(response)
            case Err(err):
                print(
                    f"access method={request.method} path={request.path} "
                    f"status={error_status(err)} elapsed_ms={elapsed_ms} "
                    f"client={str(request.client_id)} trace={str(request.trace_id)} "
                    f"error=\"{error_message(err)}\""
                )
                return Err(err)
        raise RuntimeError("unreachable")

    return new_middleware("logging", logging_pre, logging_post)


# ---------------------------------------------------------------------------
# The unified handler. The chain is just a list of `Middleware`; we run all
# pre-hooks in order, short-circuit on the first one to return `Some(err)`,
# perform the async rate-limit + forward, then run every post-hook in
# reverse order. This is the equivalent of the recursive "next" chain but
# expressed as a straight-line pipeline.
# ---------------------------------------------------------------------------


pub async def handle_request(core: GatewayCore, request: HttpRequest) -> HttpResponse:
    let started: float = time.monotonic()
    let chain: list[Middleware] = standard_chain(core)

    # 1. Pre-pass (forward order).
    mut short_circuit: Result[HttpResponse, GwError]? = None
    for layer in chain:
        let outcome: Result[HttpResponse, GwError]? = layer.pre(request)
        if outcome is not None:
            short_circuit = outcome
            break

    # 2. Body — async rate-limit + forward to upstream, unless something
    #    upstream already short-circuited the chain.
    let response: Result[HttpResponse, GwError] = (
        short_circuit
        if short_circuit is not None
        else await _execute_request(core, request)
    )

    # 3. Post-pass (reverse order).
    mut current: Result[HttpResponse, GwError] = response
    mut idx: int = len(chain) - 1
    while idx >= 0:
        let layer2: Middleware = chain[idx]
        let elapsed_ms: int = int((time.monotonic() - started) * 1000.0)
        current = layer2.post(request, current, elapsed_ms)
        idx = idx - 1

    return envelope(current)


async def _execute_request(core: GatewayCore, request: HttpRequest) -> Result[HttpResponse, GwError]:
    let hit: MatchHit? = core.matched.get(str(request.request_id))
    if hit is None:
        return Err(err_no_route(request.method, request.path))
    let route: Route = hit.route

    # Rate-limit check (async).
    let retry_after_ms: int? = await core.rate_limiter.try_acquire(route.id, request.client_id)
    if retry_after_ms is not None:
        core.metrics.record_rate_limit_rejection(route.id)
        return Err(err_rate_limit(route.id, request.client_id, retry_after_ms))

    # Balancer selection.
    let balancer: Balancer? = balancer_for(core, route)
    if balancer is None:
        return Err(err_no_upstream(route.id, "no balancer configured"))
    let chosen_upstream: Upstream? = balancer.pick(route.upstreams)
    let pick_res: Result[Upstream, GwError] = pick_upstream_or_error(route, chosen_upstream)
    match pick_res:
        case Ok(upstream):
            return await forward_with_retry(core.forward, route, upstream, request)
        case Err(e):
            return Err(e)
    raise RuntimeError("unreachable")


pub def standard_chain(core: GatewayCore) -> list[Middleware]:
    # Outermost first. Logging wraps everything; routing has to be early
    # enough that auth / rate-limit can read `core.matched`.
    return [
        make_logging_middleware(core),
        make_tracing_middleware(core),
        make_routing_middleware(core),
        make_auth_middleware(core),
        make_rate_limit_middleware(core),
    ]


pub def error_to_response(err: GwError) -> HttpResponse:
    return text_response(error_status(err), error_message(err))


pub def envelope(result: Result[HttpResponse, GwError]) -> HttpResponse:
    match result:
        case Ok(resp):
            return resp
        case Err(e):
            return error_to_response(e)
    raise RuntimeError("unreachable")
