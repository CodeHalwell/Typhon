from domain import CommentId, PostId, UserId
from domain import Comment, Post, User


pub class Store:
    users: dict[int, User]
    posts: dict[int, Post]
    comments: dict[int, Comment]


impl Store:
    def find_user(self, uid: UserId) -> User?:
        return self.users.get(int(uid))

    def find_users_by_role(self, role: str) -> list[User]:
        mut out: list[User] = []
        for (_, u) in self.users.items():
            if u.role == role:
                out.append(u)
        return out

    def all_users(self) -> list[User]:
        mut out: list[User] = []
        for (_, u) in self.users.items():
            out.append(u)
        return out

    def find_post(self, pid: PostId) -> Post?:
        return self.posts.get(int(pid))

    def find_posts_by_author(self, uid: UserId) -> list[Post]:
        mut out: list[Post] = []
        let target: int = int(uid)
        for (_, p) in self.posts.items():
            if int(p.author) == target:
                out.append(p)
        return out

    def all_posts(self) -> list[Post]:
        mut out: list[Post] = []
        for (_, p) in self.posts.items():
            out.append(p)
        return out

    def find_comments_by_post(self, pid: PostId) -> list[Comment]:
        mut out: list[Comment] = []
        let target: int = int(pid)
        for (_, c) in self.comments.items():
            if int(c.post) == target:
                out.append(c)
        return out

    def batch_load_users(self, ids: list[int]) -> dict[int, User]:
        mut out: dict[int, User] = {}
        for i in ids:
            let u: User? = self.users.get(i)
            if u is not None:
                out[i] = u
        return out

    def batch_load_posts(self, ids: list[int]) -> dict[int, Post]:
        mut out: dict[int, Post] = {}
        for i in ids:
            let p: Post? = self.posts.get(i)
            if p is not None:
                out[i] = p
        return out


pub def seed_store() -> Store:
    let users: dict[int, User] = {
        1: User(id=UserId(1), name="Ada Lovelace",   email="ada@example.com",   role="admin"),
        2: User(id=UserId(2), name="Alan Turing",    email="alan@example.com",  role="admin"),
        3: User(id=UserId(3), name="Grace Hopper",   email="grace@example.com", role="user"),
        4: User(id=UserId(4), name="Linus Torvalds", email="linus@example.com", role="user"),
        5: User(id=UserId(5), name="Margaret Hamilton", email="meg@example.com", role="user"),
