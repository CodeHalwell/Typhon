from middleware import (
    AuthContext,
    auth_error_msg,
    require_role,
    validate_token,
)
from middleware import DataLoader
from domain import Token
from .query import node_name, parse_query
from .resolvers import ResolverContext, resolve_node
from domain import Post, ResolvedField, User
from storage import Store


# Per-root-field minimum role. "admin" can do anything; ordinary "user"
# can only read its own profile and public post/comment data.
let MIN_ROLES: dict[str, str] = {
    "user":     "user",
    "users":    "admin",
    "post":     "user",
    "posts":    "user",
    "comments": "user",
}


def _required_role(root_name: str) -> str:
    let role: str? = MIN_ROLES.get(root_name)
    return role if role is not None else "admin"


def _build_context(store: Store, auth: AuthContext) -> ResolverContext:
    # Bound methods are passed directly. If the checker rejects this we
    # would have to introduce a per-store closure-class — see FRICTION.md.
    let user_loader: DataLoader[int, User] = DataLoader(
        batch_fn=store.batch_load_users, cache={}, pending=[],
    )
    let post_loader: DataLoader[int, Post] = DataLoader(
        batch_fn=store.batch_load_posts, cache={}, pending=[],
    )
    return ResolverContext(
        store=store,
        auth=auth,
        user_loader=user_loader,
        post_loader=post_loader,
    )


pub def execute(
    raw_query: str,
    token: Token,
    store: Store,
) -> Result[ResolvedField, str]:
    match parse_query(raw_query):
        case Err(pe):
            return Err(f"parse: {pe}")
        case Ok(root):
            match validate_token(token, store):
                case Err(ae):
                    return Err(auth_error_msg(ae))
                case Ok(auth):
                    let needed: str = _required_role(node_name(root))
                    match require_role(auth, needed):
                        case Err(re):
                            return Err(auth_error_msg(re))
                        case Ok(_):
                            let ctx: ResolverContext = _build_context(store, auth)
                            return resolve_node(ctx, root)
    raise RuntimeError("unreachable")
