import asyncio
import time

from ids import Host


pub class TokenBucket:
    host: Host
    capacity: int
    refill_rate: float
    tokens: float
    last_refill: float
    lock: asyncio.Lock


impl TokenBucket:
    def _refill(self) -> None:
        let now: float = time.monotonic()
        let elapsed: float = now - self.last_refill
        if elapsed <= 0.0:
            return
        let new_tokens: float = self.tokens + elapsed * self.refill_rate
        let cap: float = float(self.capacity)
        self.tokens = new_tokens if new_tokens < cap else cap
        self.last_refill = now

    async def acquire(self, n: int = 1) -> None:
        while True:
            async with self.lock:
                self._refill()
                if self.tokens >= float(n):
                    self.tokens = self.tokens - float(n)
                    return
                let deficit: float = float(n) - self.tokens
                let wait: float = deficit / self.refill_rate if self.refill_rate > 0.0 else 1.0
            await asyncio.sleep(wait if wait > 0.05 else 0.05)


pub class RateLimiter:
    buckets: dict[str, TokenBucket]
    capacity: int
    refill_rate: float
    lock: asyncio.Lock


impl RateLimiter:
    async def bucket_for(self, host: Host) -> TokenBucket:
        let key: str = str(host)
        async with self.lock:
            let existing: TokenBucket? = self.buckets.get(key)
            if existing is not None:
                return existing
            let fresh: TokenBucket = TokenBucket(
                host=host,
                capacity=self.capacity,
                refill_rate=self.refill_rate,
                tokens=float(self.capacity),
                last_refill=time.monotonic(),
                lock=asyncio.Lock(),
            )
            self.buckets[key] = fresh
            return fresh

    async def acquire(self, host: Host) -> None:
        let bucket: TokenBucket = await self.bucket_for(host)
        await bucket.acquire(1)


pub def new_limiter(capacity: int, refill_rate: float) -> RateLimiter:
    return RateLimiter(
        buckets={},
        capacity=capacity,
        refill_rate=refill_rate,
        lock=asyncio.Lock(),
    )
