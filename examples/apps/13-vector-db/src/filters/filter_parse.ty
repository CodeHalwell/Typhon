from .filter_ast import (
    FilterExpr,
    FilterValue,
    fv_bool,
    fv_float,
    fv_int,
    fv_str,
    FAnd,
    FEq,
    FGe,
    FGt,
    FIn,
    FLe,
    FLt,
    FNe,
    FNot,
    FOr,
)


pub class ParseError:
    message: str
    pos: int


# ---------------------------------------------------------------------------
# Tokenizer


pub class FToken:
    kind: str  # "ident" | "string" | "int" | "float" | "bool"
                # | "op" | "and" | "or" | "not" | "in" | "lparen" | "rparen"
                # | "lbracket" | "rbracket" | "comma"
    text: str
    pos: int


def _is_space(ch: str) -> bool:
    return ch == " " or ch == "\t" or ch == "\n" or ch == "\r"


def _is_digit(ch: str) -> bool:
    if len(ch) == 0:
        return False
    let code: int = ord(ch)
    return code >= ord("0") and code <= ord("9")


def _is_ident_start(ch: str) -> bool:
    if len(ch) == 0:
        return False
    let code: int = ord(ch)
    if code >= ord("a") and code <= ord("z"):
        return True
    if code >= ord("A") and code <= ord("Z"):
        return True
    return ch == "_"


def _is_ident_cont(ch: str) -> bool:
    return _is_ident_start(ch) or _is_digit(ch)


def _lex(raw: str) -> Result[list[FToken], ParseError]:
    mut out: list[FToken] = []
    let n: int = len(raw)
    mut i: int = 0
    while i < n:
        let ch: str = raw[i]
        if _is_space(ch):
            i = i + 1
            continue
        if ch == "(":
            out.append(FToken(kind="lparen", text="(", pos=i))
            i = i + 1
            continue
        if ch == ")":
            out.append(FToken(kind="rparen", text=")", pos=i))
            i = i + 1
            continue
        if ch == "[":
            out.append(FToken(kind="lbracket", text="[", pos=i))
            i = i + 1
            continue
        if ch == "]":
            out.append(FToken(kind="rbracket", text="]", pos=i))
            i = i + 1
            continue
        if ch == ",":
            out.append(FToken(kind="comma", text=",", pos=i))
            i = i + 1
            continue
        if ch == "\"" or ch == "'":
            let quote: str = ch
            let start_pos: int = i
            i = i + 1
            mut j: int = i
            while j < n and raw[j] != quote:
                j = j + 1
            if j >= n:
                return Err(ParseError(message="unterminated string", pos=start_pos))
            let s: str = raw[i:j]
            out.append(FToken(kind="string", text=s, pos=start_pos))
            i = j + 1
            continue
        # Operators: = != >= <= > <
        if ch == "!":
            if i + 1 < n and raw[i + 1] == "=":
                out.append(FToken(kind="op", text="!=", pos=i))
                i = i + 2
                continue
            return Err(ParseError(message="expected '!='", pos=i))
        if ch == "=":
            if i + 1 < n and raw[i + 1] == "=":
                out.append(FToken(kind="op", text="=", pos=i))
                i = i + 2
                continue
            out.append(FToken(kind="op", text="=", pos=i))
            i = i + 1
            continue
        if ch == ">":
            if i + 1 < n and raw[i + 1] == "=":
                out.append(FToken(kind="op", text=">=", pos=i))
                i = i + 2
                continue
            out.append(FToken(kind="op", text=">", pos=i))
            i = i + 1
            continue
        if ch == "<":
            if i + 1 < n and raw[i + 1] == "=":
                out.append(FToken(kind="op", text="<=", pos=i))
                i = i + 2
                continue
            out.append(FToken(kind="op", text="<", pos=i))
            i = i + 1
            continue
        # Numbers (possibly negative is handled at parse time? — accept leading '-').
        if _is_digit(ch) or (ch == "-" and i + 1 < n and _is_digit(raw[i + 1])):
            let start: int = i
            if ch == "-":
                i = i + 1
            mut saw_dot: bool = False
            while i < n and (_is_digit(raw[i]) or raw[i] == "."):
                if raw[i] == ".":
                    if saw_dot:
                        break
                    saw_dot = True
                i = i + 1
            let text: str = raw[start:i]
            if saw_dot:
                out.append(FToken(kind="float", text=text, pos=start))
            else:
                out.append(FToken(kind="int", text=text, pos=start))
            continue
        if _is_ident_start(ch):
            let start_id: int = i
            while i < n and _is_ident_cont(raw[i]):
                i = i + 1
            let word: str = raw[start_id:i]
            let upper: str = word.upper()
            if upper == "AND":
                out.append(FToken(kind="and", text=word, pos=start_id))
            elif upper == "OR":
                out.append(FToken(kind="or", text=word, pos=start_id))
            elif upper == "NOT":
                out.append(FToken(kind="not", text=word, pos=start_id))
            elif upper == "IN":
                out.append(FToken(kind="in", text=word, pos=start_id))
            elif upper == "TRUE":
                out.append(FToken(kind="bool", text="true", pos=start_id))
            elif upper == "FALSE":
                out.append(FToken(kind="bool", text="false", pos=start_id))
            else:
                out.append(FToken(kind="ident", text=word, pos=start_id))
            continue
        return Err(ParseError(message=f"unexpected character '{ch}'", pos=i))
    return Ok(out)


# ---------------------------------------------------------------------------
# Parser


pub class FParser:
    tokens: list[FToken]
    pos: int


impl FParser:
    def peek(self) -> FToken?:
        if self.pos < len(self.tokens):
            return self.tokens[self.pos]
        return None

    def advance(self) -> FToken?:
        let t: FToken? = self.peek()
        if t is not None:
            self.pos = self.pos + 1
        return t

    def parse_or(self) -> Result[FilterExpr, ParseError]:
        let first: FilterExpr = self.parse_and()?
        mut parts: list[FilterExpr] = [first]
        while True:
            let nxt: FToken? = self.peek()
            if nxt is None:
                break
            let nx: FToken = nxt
            if nx.kind != "or":
                break
            self.pos = self.pos + 1
            let part: FilterExpr = self.parse_and()?
            parts.append(part)
        if len(parts) == 1:
            return Ok(parts[0])
        return Ok(FOr(parts))

    def parse_and(self) -> Result[FilterExpr, ParseError]:
        let first: FilterExpr = self.parse_not()?
        mut parts: list[FilterExpr] = [first]
        while True:
            let nxt: FToken? = self.peek()
            if nxt is None:
                break
            let nx: FToken = nxt
            if nx.kind != "and":
                break
            self.pos = self.pos + 1
            let part: FilterExpr = self.parse_not()?
            parts.append(part)
        if len(parts) == 1:
            return Ok(parts[0])
        return Ok(FAnd(parts))

    def parse_not(self) -> Result[FilterExpr, ParseError]:
        let nxt: FToken? = self.peek()
        if nxt is None:
            return Err(ParseError(message="unexpected end of filter", pos=0))
        let nx: FToken = nxt
        if nx.kind == "not":
            self.pos = self.pos + 1
            let inner: FilterExpr = self.parse_not()?
            return Ok(FNot(inner))
        return self.parse_atom()

    def parse_atom(self) -> Result[FilterExpr, ParseError]:
        let nxt: FToken? = self.peek()
        if nxt is None:
            return Err(ParseError(message="unexpected end of filter", pos=0))
        let nx: FToken = nxt
        if nx.kind == "lparen":
            self.pos = self.pos + 1
            let inner: FilterExpr = self.parse_or()?
            let close_opt: FToken? = self.advance()
            if close_opt is None:
                return Err(ParseError(message="missing ')'", pos=nx.pos))
            let close: FToken = close_opt
            if close.kind != "rparen":
                return Err(ParseError(message=f"expected ')', got '{close.text}'", pos=close.pos))
            return Ok(inner)
        return self.parse_predicate()

    def parse_predicate(self) -> Result[FilterExpr, ParseError]:
        let ident_opt: FToken? = self.advance()
        if ident_opt is None:
            return Err(ParseError(message="expected identifier", pos=0))
        let ident: FToken = ident_opt
        if ident.kind != "ident":
            return Err(ParseError(
                message=f"expected field name, got '{ident.text}'", pos=ident.pos
            ))
        let field: str = ident.text

        let op_opt: FToken? = self.advance()
        if op_opt is None:
            return Err(ParseError(
                message=f"expected operator after '{field}'", pos=ident.pos
            ))
        let op: FToken = op_opt

        if op.kind == "in":
            return self._parse_in_list(field, op)
        if op.kind != "op":
            return Err(ParseError(
                message=f"expected operator after '{field}', got '{op.text}'",
                pos=op.pos,
            ))

        let val_res: Result[FilterValue, ParseError] = self._parse_value()
        let val: FilterValue = val_res?
        if op.text == "=":
            return Ok(FEq(field, val))
        if op.text == "!=":
            return Ok(FNe(field, val))
        if op.text == ">":
            return Ok(FGt(field, val))
        if op.text == "<":
            return Ok(FLt(field, val))
        if op.text == ">=":
            return Ok(FGe(field, val))
        if op.text == "<=":
            return Ok(FLe(field, val))
        return Err(ParseError(message=f"unknown operator '{op.text}'", pos=op.pos))

    def _parse_in_list(self, field: str, in_tok: FToken) -> Result[FilterExpr, ParseError]:
        let lbr_opt: FToken? = self.advance()
        if lbr_opt is None:
            return Err(ParseError(message="expected '[' after IN", pos=in_tok.pos))
        let lbr: FToken = lbr_opt
        if lbr.kind != "lbracket":
            return Err(ParseError(
                message=f"expected '[' after IN, got '{lbr.text}'", pos=lbr.pos
            ))
        mut vals: list[FilterValue] = []
        while True:
            let nxt: FToken? = self.peek()
            if nxt is None:
                return Err(ParseError(message="unterminated IN list", pos=in_tok.pos))
            let nx: FToken = nxt
            if nx.kind == "rbracket":
                self.pos = self.pos + 1
                break
            let val: FilterValue = self._parse_value()?
            vals.append(val)
            let after_opt: FToken? = self.peek()
            if after_opt is None:
                return Err(ParseError(message="unterminated IN list", pos=in_tok.pos))
            let after: FToken = after_opt
            if after.kind == "comma":
                self.pos = self.pos + 1
                continue
            if after.kind == "rbracket":
                self.pos = self.pos + 1
                break
            return Err(ParseError(
                message=f"expected ',' or ']' in IN list, got '{after.text}'",
                pos=after.pos,
            ))
        return Ok(FIn(field, vals))

    def _parse_value(self) -> Result[FilterValue, ParseError]:
        let nxt: FToken? = self.advance()
        if nxt is None:
            return Err(ParseError(message="expected value", pos=0))
        let nx: FToken = nxt
        if nx.kind == "string":
            return Ok(fv_str(nx.text))
        if nx.kind == "int":
            return Ok(fv_int(int(nx.text)))
        if nx.kind == "float":
            return Ok(fv_float(float(nx.text)))
        if nx.kind == "bool":
            return Ok(fv_bool(nx.text == "true"))
        return Err(ParseError(
            message=f"expected value, got '{nx.text}'", pos=nx.pos
        ))


pub def parse_filter(raw: str) -> Result[FilterExpr, ParseError]:
    let tokens: list[FToken] = _lex(raw)?
    if len(tokens) == 0:
        return Err(ParseError(message="empty filter", pos=0))
    let parser: FParser = FParser(tokens=tokens, pos=0)
    let root: FilterExpr = parser.parse_or()?
    let trailing: FToken? = parser.peek()
    if trailing is not None:
        let t: FToken = trailing
        return Err(ParseError(
            message=f"unexpected trailing token '{t.text}'", pos=t.pos
        ))
    return Ok(root)
