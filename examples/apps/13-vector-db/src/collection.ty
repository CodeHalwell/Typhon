from config import HnswParams
from filter_ast import FilterExpr, evaluate_filter
from hnsw import Candidate, Hnsw, new_hnsw
from ids import CollectionId, Dim, VectorId
from metric import Metric, metric_name


pub class IndexError:
    op: str
    message: str


pub class StoredVector frozen:
    id: int
    vector: list[float]
    metadata: dict[str, object]


pub class SearchResult frozen:
    id: int
    distance: float
    metadata: dict[str, object]


# Generic per-dimension wrapper. The parameter `D` is a phantom type that
# documents the dimensionality; the actual length check is dynamic since
# `Dim` is a `newtype int` and we cannot encode it as a const generic.
pub class Collection[D]:
    id: CollectionId
    name: str
    dim: Dim
    metric: Metric
    index: Hnsw
    storage: dict[int, StoredVector]


pub def new_collection[D](
    id: CollectionId,
    name: str,
    dim: Dim,
    metric: Metric,
    params: HnswParams,
) -> Collection[D]:
    return Collection[D](
        id=id,
        name=name,
        dim=dim,
        metric=metric,
        index=new_hnsw(params, metric),
        storage={},
    )


impl[D] Collection[D]:
    def size(self) -> int:
        return len(self.storage)

    def metric_label(self) -> str:
        return metric_name(self.metric)

    def get(self, vid: VectorId) -> StoredVector?:
        return self.storage.get(int(vid))

    def insert(
        self,
        vid: VectorId,
        vector: list[float],
        metadata: dict[str, object],
    ) -> Result[bool, IndexError]:
        if len(vector) != int(self.dim):
            return Err(IndexError(
                op="insert",
                message=f"expected dim {int(self.dim)}, got {len(vector)}",
            ))
        let key: int = int(vid)
        let was_new: bool = key not in self.storage
        self.storage[key] = StoredVector(id=key, vector=vector, metadata=metadata)
        self.index.insert(vid, vector)
        return Ok(was_new)

    def upsert(
        self,
        vid: VectorId,
        vector: list[float],
        metadata: dict[str, object],
    ) -> Result[bool, IndexError]:
        return self.insert(vid, vector, metadata)

    def delete(self, vid: VectorId) -> Result[bool, IndexError]:
        let key: int = int(vid)
        if key not in self.storage:
            return Ok(False)
        del self.storage[key]
        let _ignored: bool = self.index.delete(vid)
        return Ok(True)

    def search(
        self,
        query: list[float],
        k: int,
        ef_search: int,
        filter: FilterExpr?,
    ) -> Result[list[SearchResult], IndexError]:
        if len(query) != int(self.dim):
            return Err(IndexError(
                op="search",
                message=f"query dim {len(query)} != collection dim {int(self.dim)}",
            ))
        if k <= 0:
            return Ok([])
        # Over-fetch when there's a filter so post-filtering still yields k hits.
        let fetch_k: int = k * 4 if filter is not None else k
        let raw: list[Candidate] = self.index.search(query, fetch_k, ef_search)
        mut out: list[SearchResult] = []
        for c in raw:
            let sv_opt: StoredVector? = self.storage.get(c.id)
            if sv_opt is None:
                continue
            let sv: StoredVector = sv_opt
            if filter is not None:
                let f: FilterExpr = filter
                if not evaluate_filter(f, sv.metadata):
                    continue
            out.append(SearchResult(
                id=c.id, distance=c.distance, metadata=sv.metadata,
            ))
            if len(out) >= k:
                break
        return Ok(out)

    def all_ids(self) -> list[int]:
        mut out: list[int] = []
        for (k, _v) in self.storage.items():
            out.append(k)
        return out
