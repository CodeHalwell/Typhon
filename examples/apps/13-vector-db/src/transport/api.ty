import asyncio
from pathlib import Path

from fastapi import FastAPI, HTTPException

lazy import np = numpy

from indexes import Collection, new_collection
from runtime import ServerConfig, load_config
from domain import (
    CreateCollectionRequest,
    CreateCollectionResponse,
    DeleteResponse,
    GetResponse,
    SearchHit,
    SearchRequest,
    SearchResponse,
    SnapshotResponse,
    UpsertRequest,
    UpsertResponse,
)
from filters import FilterExpr
from filters import parse_filter
from domain import CollectionId, Dim, SnapshotSeq, VectorId
from vector import metric_from_name
from indexes import (
    SnapshotError,
    SnapshotInfo,
    hydrate_collection,
    load_snapshot,
    write_snapshot,
)


pub class AppState:
    config: ServerConfig
    collections: dict[str, Collection[int]]
    lock: asyncio.Lock
    next_cid: int
    snapshot_seq: int


pub def build_state() -> AppState:
    let cfg: ServerConfig = load_config()
    return AppState(
        config=cfg,
        collections={},
        lock=asyncio.Lock(),
        next_cid=1,
        snapshot_seq=0,
    )


pub let STATE: AppState = build_state()
pub let app: FastAPI = FastAPI(title="Typhon Vector DB")


def _err_response(code: int, op: str, message: str) -> HTTPException:
    return HTTPException(status_code=code, detail=f"{op}: {message}")


def _resolve_filter(raw: str?) -> FilterExpr?:
    if raw is None:
        return None
    let s: str = raw
    if len(s) == 0:
        return None
    match parse_filter(s):
        case Ok(expr):
            return expr
        case Err(e):
            raise _err_response(400, "filter_parse", f"{e.message} at pos {e.pos}")
    raise RuntimeError("unreachable")


@app.post("/collections", response_model=CreateCollectionResponse)
async def create_collection(req: CreateCollectionRequest) -> CreateCollectionResponse:
    async with STATE.lock:
        if req.name in STATE.collections:
            raise _err_response(409, "create_collection", f"'{req.name}' exists")
        let m_opt = metric_from_name(req.metric)
        if m_opt is None:
            raise _err_response(400, "create_collection", f"unknown metric '{req.metric}'")
        let m = m_opt
        let cid: CollectionId = CollectionId(STATE.next_cid)
        STATE.next_cid = STATE.next_cid + 1
        let col: Collection[int] = new_collection[int](
            cid, req.name, Dim(req.dim), m, STATE.config.hnsw,
        )
        STATE.collections[req.name] = col
        return CreateCollectionResponse(
            name=req.name, dim=req.dim, metric=col.metric_label(),
        )


def _require_collection(name: str) -> Collection[int]:
    let opt: Collection[int]? = STATE.collections.get(name)
    if opt is None:
        raise _err_response(404, "collection", f"'{name}' not found")
    return opt


@app.post("/collections/{name}/vectors", response_model=UpsertResponse)
async def upsert_vector(name: str, req: UpsertRequest) -> UpsertResponse:
    async with STATE.lock:
        let col: Collection[int] = _require_collection(name)
        match col.upsert(VectorId(req.id), req.vector, req.metadata):
            case Ok(inserted):
                return UpsertResponse(id=req.id, inserted=inserted)
            case Err(e):
                raise _err_response(400, e.op, e.message)
    raise RuntimeError("unreachable")


@app.get("/collections/{name}/vectors/{vid}", response_model=GetResponse)
async def get_vector(name: str, vid: int) -> GetResponse:
    async with STATE.lock:
        let col: Collection[int] = _require_collection(name)
        let sv_opt = col.get(VectorId(vid))
        if sv_opt is None:
            raise _err_response(404, "get", f"vector {vid} not found")
        let sv = sv_opt
        return GetResponse(id=sv.id, vector=sv.vector, metadata=sv.metadata)


@app.delete("/collections/{name}/vectors/{vid}", response_model=DeleteResponse)
async def delete_vector(name: str, vid: int) -> DeleteResponse:
    async with STATE.lock:
        let col: Collection[int] = _require_collection(name)
        match col.delete(VectorId(vid)):
            case Ok(deleted):
                return DeleteResponse(id=vid, deleted=deleted)
            case Err(e):
                raise _err_response(400, e.op, e.message)
    raise RuntimeError("unreachable")


@app.post("/collections/{name}/search", response_model=SearchResponse)
async def search(name: str, req: SearchRequest) -> SearchResponse:
    let parsed: FilterExpr? = _resolve_filter(req.filter)
    async with STATE.lock:
        let col: Collection[int] = _require_collection(name)
        match col.search(
            req.vector, req.k, STATE.config.hnsw.ef_search, parsed,
        ):
            case Ok(results):
                let hits: list[SearchHit] = [
                    SearchHit(id=r.id, distance=r.distance, metadata=r.metadata)
                    for r in results
                ]
                return SearchResponse(hits=hits)
            case Err(e):
                raise _err_response(400, e.op, e.message)
    raise RuntimeError("unreachable")


# Batch-search endpoint demonstrating the lazy numpy import.
@app.post("/collections/{name}/batch-search", response_model=list[SearchResponse])
async def batch_search(
    name: str, queries: list[SearchRequest],
) -> list[SearchResponse]:
    if len(queries) == 0:
        return []
    # Touch numpy once so the lazy proxy resolves. We use it to validate the
    # batch shape and to L2-normalise (if metric is cosine, callers usually
    # benefit). The actual nearest-neighbour search still runs through HNSW.
    let dims_set: dict[int, bool] = {len(q.vector): True for q in queries}
    if len(dims_set) != 1:
        raise _err_response(400, "batch_search", "queries have mixed dims")
    let _stacked = np.array([q.vector for q in queries], dtype=np.float64)
    mut out: list[SearchResponse] = []
    async with STATE.lock:
        let col: Collection[int] = _require_collection(name)
        for q in queries:
            let parsed: FilterExpr? = _resolve_filter(q.filter)
            match col.search(q.vector, q.k, STATE.config.hnsw.ef_search, parsed):
                case Ok(results):
                    let hits: list[SearchHit] = [
                        SearchHit(id=r.id, distance=r.distance, metadata=r.metadata)
                        for r in results
                    ]
                    out.append(SearchResponse(hits=hits))
                case Err(e):
                    raise _err_response(400, e.op, e.message)
    return out


# The snapshot pipeline — exercises the `with`-chain `?` form.
def _do_snapshot(col: Collection[int], dir: str, seq: SnapshotSeq) -> Result[SnapshotInfo, SnapshotError]:
    with info = write_snapshot[int](col, dir, seq)?:
        return Ok(info)


@app.post("/collections/{name}/snapshot", response_model=SnapshotResponse)
async def snapshot(name: str) -> SnapshotResponse:
    async with STATE.lock:
        let col: Collection[int] = _require_collection(name)
        STATE.snapshot_seq = STATE.snapshot_seq + 1
        let seq: SnapshotSeq = SnapshotSeq(STATE.snapshot_seq)
        match _do_snapshot(col, STATE.config.snapshot_dir, seq):
            case Ok(info):
                return SnapshotResponse(
                    seq=info.seq, path=info.path, vector_count=info.vector_count,
                )
            case Err(e):
                raise _err_response(500, e.op, e.message)
    raise RuntimeError("unreachable")


@app.post("/collections/{name}/restore", response_model=CreateCollectionResponse)
async def restore(name: str) -> CreateCollectionResponse:
    async with STATE.lock:
        match load_snapshot(STATE.config.snapshot_dir, name):
            case Ok(loaded):
                let cid: CollectionId = CollectionId(STATE.next_cid)
                STATE.next_cid = STATE.next_cid + 1
                match hydrate_collection[int](loaded, cid, STATE.config.hnsw):
                    case Ok(col):
                        STATE.collections[name] = col
                        return CreateCollectionResponse(
                            name=name,
                            dim=loaded.dim,
                            metric=loaded.metric_label,
                        )
                    case Err(e):
                        raise _err_response(500, e.op, e.message)
            case Err(e):
                raise _err_response(404, e.op, e.message)
    raise RuntimeError("unreachable")


@app.get("/health")
def health() -> dict[str, object]:
    return {
        "ok": True,
        "collections": len(STATE.collections),
        "snapshot_dir": str(Path(STATE.config.snapshot_dir)),
        "port": STATE.config.http_port,
    }


@app.get("/collections")
async def list_collections() -> list[dict[str, object]]:
    async with STATE.lock:
        mut out: list[dict[str, object]] = []
        for (cname, col) in STATE.collections.items():
            out.append({
                "name": cname,
                "dim": int(col.dim),
                "metric": col.metric_label(),
                "size": col.size(),
            })
        return out
