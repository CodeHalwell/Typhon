from datetime import datetime

from .ids import OrderId, Symbol, TraderId
from .money import Price, Qty


pub type Side = Buy | Sell


pub class Buy:
    pass


pub class Sell:
    pass


pub def opposite(side: Side) -> Side:
    match side:
        case Buy():  return Sell()
        case Sell(): return Buy()


pub def side_label(side: Side) -> str:
    match side:
        case Buy():  return "BUY"
        case Sell(): return "SELL"


pub type TimeInForce = GoodTillCancel | ImmediateOrCancel | FillOrKill


pub class GoodTillCancel:
    pass


pub class ImmediateOrCancel:
    pass


pub class FillOrKill:
    pass


pub type OrderType = Limit | Market


pub class Limit:
    price: Price


pub class Market:
    pass


pub class Order frozen:
    id: OrderId
    trader: TraderId
    symbol: Symbol
    side: Side
    kind: OrderType
    qty: Qty
    submitted_at: datetime


pub def limit_price(order: Order) -> Price?:
    match order.kind:
        case Limit(p): return p
        case Market(): return None
