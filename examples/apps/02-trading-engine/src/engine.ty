from datetime import datetime, timezone

from book import OrderBook, crosses, new_book
from ids import FillId, OrderId, Symbol
from money import Price, Qty, min_qty, sub_qty
from orders import (
    Buy,
    FillOrKill,
    GoodTillCancel,
    ImmediateOrCancel,
    Limit,
    Market,
    Order,
    Side,
    TimeInForce,
    limit_price,
    opposite,
    side_label,
)
from risk import RiskGate


pub class Fill frozen:
    id: FillId
    taker: OrderId
    maker: OrderId
    symbol: Symbol
    price: Price
    qty: Qty
    at: datetime


pub type MarketEvent = OrderAccepted | OrderRejected | OrderFilled | OrderResting | OrderCancelled


pub class OrderAccepted:
    order_id: OrderId


pub class OrderRejected:
    order_id: OrderId
    reason: str
    detail: str


pub class OrderFilled:
    fill: Fill


pub class OrderResting:
    order_id: OrderId
    price: Price
    qty: Qty


pub class OrderCancelled:
    order_id: OrderId
    reason: str


pub interface EventSink:
    def on_event(self, event: MarketEvent) -> None


pub class Engine:
    books: dict[str, OrderBook]
    risk: RiskGate
    next_fill_id: int
    sinks: list[EventSink]


def _emit(sinks: list[EventSink], event: MarketEvent) -> None:
    for sink in sinks:
        sink.on_event(event)


impl Engine:
    def book_for(self, symbol: Symbol) -> OrderBook:
        let key: str = str(symbol)
        let existing: OrderBook? = self.books.get(key)
        if existing is not None:
            return existing
        let fresh: OrderBook = new_book(symbol)
        self.books[key] = fresh
        return fresh

    def submit(self, order: Order, tif: TimeInForce) -> list[Fill]:
        match self.risk.check(order):
            case Err(e):
                _emit(self.sinks, OrderRejected(
                    order_id=order.id,
                    reason=e.reason,
                    detail=e.detail,
                ))
                return []
            case Ok(_):
                pass

        _emit(self.sinks, OrderAccepted(order_id=order.id))
        return self._match(order, tif)

    def _match(self, order: Order, tif: TimeInForce) -> list[Fill]:
        let book: OrderBook = self.book_for(order.symbol)
        let resting_side: Side = opposite(order.side)
        let resting_levels = book.asks if isinstance(order.side, Buy) else book.bids
        mut remaining: Qty = order.qty
        mut fills: list[Fill] = []
        let taker_price: Price? = limit_price(order)

        # FOK gate — verify enough liquidity exists before any fills
        if isinstance(tif, FillOrKill):
            if not self._has_enough_liquidity(book, order, taker_price):
                _emit(self.sinks, OrderCancelled(
                    order_id=order.id, reason="fok_insufficient_liquidity"
                ))
                return []

        while int(remaining) > 0 and len(resting_levels) > 0:
            let top = resting_levels[0]
            if taker_price is not None:
                if not crosses(order.side, taker_price, top.price):
                    break
            if len(top.orders) == 0:
                resting_levels.pop(0)
                continue
            let maker_id: OrderId = top.orders[0]
            let trade_qty: Qty = min_qty(remaining, top.qty)
            let fill: Fill = Fill(
                id=FillId(self.next_fill_id),
                taker=order.id,
                maker=maker_id,
                symbol=order.symbol,
                price=top.price,
                qty=trade_qty,
                at=datetime.now(timezone.utc),
            )
            self.next_fill_id = self.next_fill_id + 1
            fills.append(fill)
            _emit(self.sinks, OrderFilled(fill=fill))

            self.risk.apply_fill(
                order.trader,
                order.symbol,
                isinstance(order.side, Buy),
                trade_qty,
                top.price,
            )

            book.drain_top(resting_side, trade_qty)
            remaining = sub_qty(remaining, trade_qty)

        if int(remaining) > 0:
            match tif:
                case GoodTillCancel():
                    match order.kind:
                        case Limit(price):
                            book.add_resting(order, price, remaining)
                            _emit(self.sinks, OrderResting(
                                order_id=order.id, price=price, qty=remaining,
                            ))
                        case Market():
                            _emit(self.sinks, OrderCancelled(
                                order_id=order.id, reason="market_no_resting",
                            ))
                case ImmediateOrCancel():
                    _emit(self.sinks, OrderCancelled(
                        order_id=order.id, reason="ioc_remaining_cancelled",
                    ))
                case FillOrKill():
                    # Shouldn't reach here — FOK guarded above — but be defensive
                    _emit(self.sinks, OrderCancelled(
                        order_id=order.id, reason="fok_partial_post_check",
                    ))

        return fills

    def _has_enough_liquidity(self, book: OrderBook, order: Order, taker_price: Price?) -> bool:
        let levels = book.asks if isinstance(order.side, Buy) else book.bids
        mut available: int = 0
        for lvl in levels:
            if taker_price is not None:
                if not crosses(order.side, taker_price, lvl.price):
                    break
            available = available + int(lvl.qty)
            if available >= int(order.qty):
                return True
        return False


pub def new_engine(risk: RiskGate) -> Engine:
    return Engine(books={}, risk=risk, next_fill_id=1, sinks=[])


pub def label_side(side: Side) -> str:
    return side_label(side)
