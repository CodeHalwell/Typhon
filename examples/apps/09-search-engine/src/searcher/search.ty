from domain import DocId
from indexer import InvertedIndex, Posting
from .query import QAnd, QNot, QOr, QPhrase, QTerm, Query
from .scoring import BM25Params, ScoredHit, bm25_score


pub def flatten_terms(q: Query) -> list[str]:
    mut out: list[str] = []
    _collect_terms(q, out)
    return _dedupe_strs(out)


def _collect_terms(q: Query, out: list[str]) -> None:
    match q:
        case QTerm(term):
            out.append(term)
        case QPhrase(phrase_terms):
            for pt in phrase_terms:
                out.append(pt)
        case QAnd(and_parts):
            for ap in and_parts:
                _collect_terms(ap, out)
        case QOr(or_parts):
            for op in or_parts:
                _collect_terms(op, out)
        case QNot(_):
            # NOT contributes no positive terms to scoring.
            pass


def _dedupe_strs(xs: list[str]) -> list[str]:
    mut seen: dict[str, bool] = {}
    mut out: list[str] = []
    for x in xs:
        if seen.get(x) is True:
            continue
        seen[x] = True
        out.append(x)
    return out


def _docids_from_postings(postings: list[Posting]) -> list[DocId]:
    mut out: list[DocId] = []
    for p in postings:
        out.append(p.doc_id)
    return out


def _intersect(a: list[DocId], b: list[DocId]) -> list[DocId]:
    mut bset: dict[int, bool] = {}
    for d in b:
        bset[int(d)] = True
    mut out: list[DocId] = []
    for d in a:
        if bset.get(int(d)) is True:
            out.append(d)
    return out


def _union(a: list[DocId], b: list[DocId]) -> list[DocId]:
    mut seen: dict[int, bool] = {}
    mut out: list[DocId] = []
    for d in a:
        let k: int = int(d)
        if seen.get(k) is True:
            continue
        seen[k] = True
        out.append(d)
    for d in b:
        let k2: int = int(d)
        if seen.get(k2) is True:
            continue
        seen[k2] = True
        out.append(d)
    return out


def _difference(universe: list[DocId], excluded: list[DocId]) -> list[DocId]:
    mut exc: dict[int, bool] = {}
    for d in excluded:
        exc[int(d)] = True
    mut out: list[DocId] = []
    for d in universe:
        if exc.get(int(d)) is True:
            continue
        out.append(d)
    return out


def _phrase_match_docs(idx: InvertedIndex, terms: list[str]) -> list[DocId]:
    if len(terms) == 0:
        return []
    if len(terms) == 1:
        return _docids_from_postings(idx.postings_for(terms[0]))
    # Candidate docs = intersection of postings for every term.
    mut candidates: list[DocId] = _docids_from_postings(idx.postings_for(terms[0]))
    mut i: int = 1
    while i < len(terms):
        let next_docs: list[DocId] = _docids_from_postings(idx.postings_for(terms[i]))
        candidates = _intersect(candidates, next_docs)
        i = i + 1
    # For each candidate, verify positions form a consecutive run.
    mut out: list[DocId] = []
    for doc_id in candidates:
        if _phrase_in_doc(idx, terms, doc_id):
            out.append(doc_id)
    return out


def _positions_in_doc(postings: list[Posting], doc_id: DocId) -> list[int]:
    let want: int = int(doc_id)
    for p in postings:
        if int(p.doc_id) == want:
            mut out: list[int] = []
            for pos in p.positions:
                out.append(pos)
            return out
    return []


def _phrase_in_doc(idx: InvertedIndex, terms: list[str], doc_id: DocId) -> bool:
    let first_positions: list[int] = _positions_in_doc(idx.postings_for(terms[0]), doc_id)
    for start in first_positions:
        mut all_match: bool = True
        mut offset: int = 1
        while offset < len(terms):
            let term_positions: list[int] = _positions_in_doc(
                idx.postings_for(terms[offset]), doc_id
            )
            let want_pos: int = start + offset
            mut found: bool = False
            for p in term_positions:
                if p == want_pos:
                    found = True
                    break
            if not found:
                all_match = False
                break
            offset = offset + 1
        if all_match:
            return True
    return False


def _eval_docs(idx: InvertedIndex, q: Query) -> list[DocId]:
    match q:
        case QTerm(term):
            return _docids_from_postings(idx.postings_for(term))
        case QPhrase(phrase_terms):
            return _phrase_match_docs(idx, phrase_terms)
        case QAnd(and_parts):
            if len(and_parts) == 0:
                return []
            mut and_acc: list[DocId] = _eval_docs(idx, and_parts[0])
            mut and_i: int = 1
            while and_i < len(and_parts):
                and_acc = _intersect(and_acc, _eval_docs(idx, and_parts[and_i]))
                and_i = and_i + 1
            return and_acc
        case QOr(or_parts):
            mut or_acc: list[DocId] = []
            for op in or_parts:
                or_acc = _union(or_acc, _eval_docs(idx, op))
            return or_acc
        case QNot(inner):
            let excluded: list[DocId] = _eval_docs(idx, inner)
            return _difference(idx.all_doc_ids(), excluded)
    raise RuntimeError("unreachable")


def _matched_terms_for_doc(
    idx: InvertedIndex, terms: list[str], doc_id: DocId
) -> list[str]:
    mut out: list[str] = []
    let want: int = int(doc_id)
    for t in terms:
        for p in idx.postings_for(t):
            if int(p.doc_id) == want:
                out.append(t)
                break
    return out


pub def search(
    idx: InvertedIndex,
    query: Query,
    params: BM25Params,
    top_k: int,
) -> list[ScoredHit]:
    let candidate_docs: list[DocId] = _eval_docs(idx, query)
    let terms: list[str] = flatten_terms(query)
    mut hits: list[ScoredHit] = []
    for doc_id in candidate_docs:
        let score: float = bm25_score(idx, terms, doc_id, params)
        let matched: list[str] = _matched_terms_for_doc(idx, terms, doc_id)
        hits.append(ScoredHit(doc_id=doc_id, score=score, matched_terms=matched))
    # Sort by score descending. list.sort with key.
    hits.sort(key=_hit_sort_key, reverse=True)
    if top_k <= 0 or top_k >= len(hits):
        return hits
    return hits[:top_k]


def _hit_sort_key(h: ScoredHit) -> float:
    return h.score
