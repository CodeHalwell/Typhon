from components import Collider, Damage, Health, Position, Sprite, Tag, Velocity
from events import GameEvent, EvDespawned, EvSpawned
from ids import EntityId
from vec2 import Vec2


pub class World:
    next_id: int
    alive: dict[int, bool]
    positions: dict[int, Position]
    velocities: dict[int, Velocity]
    healths: dict[int, Health]
    damages: dict[int, list[Damage]]
    sprites: dict[int, Sprite]
    colliders: dict[int, Collider]
    tags: dict[int, list[Tag]]
    event_queue: list[GameEvent]
    tick: int


impl World:
    def spawn(self, at: Vec2) -> EntityId:
        self.next_id = self.next_id + 1
        let raw: int = self.next_id
        let eid: EntityId = EntityId(raw)
        self.alive[raw] = True
        self.positions[raw] = Position(pos=at)
        self.event_queue.append(EvSpawned(eid, at))
        return eid

    def despawn(self, eid: EntityId, reason: str) -> None:
        let raw: int = int(eid)
        if raw not in self.alive:
            return
        self.alive.pop(raw, None)
        self.positions.pop(raw, None)
        self.velocities.pop(raw, None)
        self.healths.pop(raw, None)
        self.damages.pop(raw, None)
        self.sprites.pop(raw, None)
        self.colliders.pop(raw, None)
        self.tags.pop(raw, None)
        self.event_queue.append(EvDespawned(eid, reason))

    def is_alive(self, eid: EntityId) -> bool:
        let raw: int = int(eid)
        let v: bool? = self.alive.get(raw)
        if v is None:
            return False
        return v

    def set_velocity(self, eid: EntityId, v: Velocity) -> None:
        let raw: int = int(eid)
        if raw in self.alive:
            self.velocities[raw] = v

    def set_position(self, eid: EntityId, p: Position) -> None:
        let raw: int = int(eid)
        if raw in self.alive:
            self.positions[raw] = p

    def set_health(self, eid: EntityId, h: Health) -> None:
        let raw: int = int(eid)
        if raw in self.alive:
            self.healths[raw] = h

    def get_position(self, eid: EntityId) -> Position?:
        let raw: int = int(eid)
        return self.positions.get(raw)

    def get_velocity(self, eid: EntityId) -> Velocity?:
        let raw: int = int(eid)
        return self.velocities.get(raw)

    def get_health(self, eid: EntityId) -> Health?:
        let raw: int = int(eid)
        return self.healths.get(raw)

    def set_collider(self, eid: EntityId, c: Collider) -> None:
        let raw: int = int(eid)
        if raw in self.alive:
            self.colliders[raw] = c

    def get_collider(self, eid: EntityId) -> Collider?:
        let raw: int = int(eid)
        return self.colliders.get(raw)

    def add_damage(self, eid: EntityId, d: Damage) -> None:
        let raw: int = int(eid)
        if raw not in self.alive:
            return
        let existing: list[Damage]? = self.damages.get(raw)
        if existing is None:
            self.damages[raw] = [d]
        else:
            existing.append(d)

    def take_damages(self, eid: EntityId) -> list[Damage]:
        let raw: int = int(eid)
        let existing: list[Damage]? = self.damages.get(raw)
        if existing is None:
            return []
        self.damages.pop(raw, None)
        return existing

    def query_movables(self) -> list[tuple[EntityId, Position, Velocity]]:
        mut out: list[tuple[EntityId, Position, Velocity]] = []
        for (raw, pos) in self.positions.items():
            let vel: Velocity? = self.velocities.get(raw)
            if vel is None:
                continue
            out.append((EntityId(raw), pos, vel))
        return out

    def query_collidables(self) -> list[tuple[EntityId, Position, Collider]]:
        mut out: list[tuple[EntityId, Position, Collider]] = []
        for (raw, pos) in self.positions.items():
            let col: Collider? = self.colliders.get(raw)
            if col is None:
                continue
            out.append((EntityId(raw), pos, col))
        return out

    def emit(self, ev: GameEvent) -> None:
        self.event_queue.append(ev)

    def drain_events(self) -> list[GameEvent]:
        let out: list[GameEvent] = self.event_queue
        self.event_queue = []
        return out

    def alive_count(self) -> int:
        return len(self.alive)


pub def new_world() -> World:
    return World(
        next_id=0,
        alive={},
        positions={},
        velocities={},
        healths={},
        damages={},
        sprites={},
        colliders={},
        tags={},
        event_queue=[],
        tick=0,
    )
