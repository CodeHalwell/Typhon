from components import Collider, Damage, Health, Position, Velocity
from events import EvCollision, EvDamageDealt, EvHealthChanged, EvTickEnded
from ids import EntityId
from vec2 import Vec2, vec_add, vec_distance, vec_scale
from world import World


pub def system_movement(world: World, dt: float) -> None:
    let movers: list[tuple[EntityId, Position, Velocity]] = world.query_movables()
    for (eid, pos, vel) in movers:
        let delta: Vec2 = vec_scale(vel.vel, dt)
        let new_pos: Vec2 = vec_add(pos.pos, delta)
        world.set_position(eid, Position(pos=new_pos))


pub def system_collision(world: World, dt: float) -> None:
    let collidables: list[tuple[EntityId, Position, Collider]] = world.query_collidables()
    let n: int = len(collidables)
    mut i: int = 0
    while i < n:
        mut j: int = i + 1
        while j < n:
            let (eid_a, pos_a, col_a) = collidables[i]
            let (eid_b, pos_b, col_b) = collidables[j]
            let dist: float = vec_distance(pos_a.pos, pos_b.pos)
            let touch: float = col_a.radius + col_b.radius
            if dist <= touch:
                let mid_x: float = (pos_a.pos.x + pos_b.pos.x) / 2.0
                let mid_y: float = (pos_a.pos.y + pos_b.pos.y) / 2.0
                let mid: Vec2 = Vec2(x=mid_x, y=mid_y)
                world.emit(EvCollision(eid_a, eid_b, mid))
                world.add_damage(eid_a, Damage(amount=1, source=eid_b))
                world.add_damage(eid_b, Damage(amount=1, source=eid_a))
            j = j + 1
        i = i + 1


pub def system_damage(world: World, dt: float) -> None:
    let snapshot: list[int] = list(world.healths.keys())
    for raw in snapshot:
        let eid: EntityId = EntityId(raw)
        let pending: list[Damage] = world.take_damages(eid)
        if len(pending) == 0:
            continue
        let cur: Health? = world.get_health(eid)
        if cur is None:
            continue
        mut hp: int = cur.hp
        let old_hp: int = hp
        for dmg in pending:
            hp = hp - dmg.amount
            world.emit(EvDamageDealt(eid, dmg.source, dmg.amount))
        if hp != old_hp:
            world.set_health(eid, Health(hp=hp, max_hp=cur.max_hp))
            world.emit(EvHealthChanged(eid, old_hp, hp))


pub def system_despawn_dead(world: World, dt: float) -> None:
    mut dead: list[EntityId] = []
    for (raw, h) in world.healths.items():
        if h.hp <= 0:
            dead.append(EntityId(raw))
    for eid in dead:
        world.despawn(eid, "hp<=0")


pub def system_tick_end(world: World, dt: float) -> None:
    world.emit(EvTickEnded(world.tick, world.alive_count()))
    world.tick = world.tick + 1
