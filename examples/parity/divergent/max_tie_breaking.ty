# DIVERGENT: `max()` returns a different element under `tyc run` than under
# `tyc build` + CPython when two elements compare equal.
#
#   CPython: max-tie: p   (the FIRST maximal element)
#   VM:      max-tie: q   (the LAST)
#
# CPython's `max` keeps the first element that is not strictly less than the
# running best — `max` never replaces on a tie. `min` is the mirror image and
# the VM gets that one right; only `max` differs.
#
# This is silent wrong output: nothing errors, the program just picks a
# different record. It bites hardest on "highest score wins" logic over records
# with a user `__lt__`, which is exactly where ties are common.
#
# v0.12.0 fixed `sorted()` / `min()` / `max()` to dispatch a user `__lt__` at
# all (they previously routed through the dunder-blind `Value::py_cmp`); the
# tie-breaking order was not covered by that fix.


class Rec:
    name: str
    score: int


impl Rec:
    def __lt__(self, other: Rec) -> bool:
        return self.score < other.score

    def __repr__(self) -> str:
        return self.name


def main() -> None:
    let mixed: list[Rec] = [Rec(name="c", score=2), Rec(name="a", score=1), Rec(name="b", score=2)]
    print("max:", max(mixed), "min:", min(mixed))

    let tied: list[Rec] = [Rec(name="p", score=1), Rec(name="q", score=1)]
    print("max-tie:", max(tied), "min-tie:", min(tied))


main()
