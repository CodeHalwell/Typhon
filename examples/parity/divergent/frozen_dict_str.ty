# DIVERGENT: printing a nested `freeze let` mapping shows the repr form under
# the VM and the str form under CPython.
#
#   CPython: {'k': (1, 2)}
#   VM:      mappingproxy({'k': (1, 2)})
#
# `freeze let` lowers to `deep_freeze`, which turns every nested `dict` into a
# `types.MappingProxyType`. CPython gives that type two different renderings —
# `__repr__` is `mappingproxy({...})` but `__str__` delegates to the underlying
# dict — and `print` uses `__str__`. The VM uses the repr form for both.
#
# The immutability itself is correct on both paths (mutating a nested entry
# raises `TypeError` under each), and `type(x).__name__` also differs
# (`mappingproxy` vs `dict`) — but the printed output is the part that silently
# changes program behaviour between `tyc run` and the shipped build.


freeze let CONFIG = {"port": 8080, "hosts": ["a", "b"], "nested": {"k": [1, 2]}}


def main() -> None:
    print(CONFIG["port"])
    print(CONFIG["hosts"])
    print(CONFIG["nested"])
    print(repr(CONFIG["nested"]))


main()
