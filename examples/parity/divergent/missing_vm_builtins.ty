# DIVERGENT: three stdlib members exist under CPython and are absent from the
# VM's native shims, so this program runs compiled and raises under `tyc run`.
#
#   str.isascii()          AttributeError: 'str' object has no attribute 'isascii'
#   str.isprintable()      AttributeError: 'str' object has no attribute 'isprintable'
#   bytes.count(...)       AttributeError: bytes has no method 'count'
#   datetime.timezone      AttributeError: module 'datetime' has no attribute 'timezone'
#
# Each is an isolated omission next to a neighbour that *is* implemented —
# `str.isdigit` / `isalpha` / `isalnum` / `isspace` are all present, `bytes.find`
# / `startswith` / `split` / `replace` are all present, and the `datetime` shim
# handles `datetime.now()`. `timezone.utc` is the one every UTC-aware timestamp
# needs.


from datetime import datetime, timezone


def main() -> None:
    print("abc".isascii(), "abc".isprintable())
    print(b"aabb".count(b"a"), b"aabb".find(b"b"))
    print(datetime.now(timezone.utc).year > 2000)


main()
