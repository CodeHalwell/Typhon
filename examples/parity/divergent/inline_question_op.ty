# DIVERGENT: `tyc check` and `tyc build` accept an inline `?`; `tyc run` does
# not parse it at all.
#
#   tyc check          ✅ clean
#   tyc build + python ✅ prints Ok(value=3)
#   tyc run            ❌ parse error: Got unexpected token ?
#
# The VM's `?` expansion only handles the **statement-tail** form — the `?` as
# the last thing on a logical line. Everything else in the documented surface
# fails to parse:
#
#   let x: int = p(a)?          ✅ VM ok   (tail)
#   return p(a)?                ✅ VM ok   (tail)
#   with x = p(a)?, y = p(b)?:  ✅ VM ok   (with-chain has its own lowering)
#   return Ok(p(a)?)            ❌ VM parse error   (nested in a call)
#   let x: int = p(a)? + 1      ❌ VM parse error   (mid-expression)
#   if p(a)? > 0:               ❌ VM parse error   (condition)
#
# Inline `?` is a documented, shipped feature — the skill's §9 gives
# `Ok(add(parse(s)?, parse(t)?))` as a worked example of it, and the compiled
# path handles every shape above correctly. Only the VM is behind.
#
# Workaround under `tyc run`: bind each `?` to its own `let` on its own line.


def parse_int(raw: str) -> Result[int, str]:
    if not raw.isdigit():
        return Err(f"bad {raw}")
    return Ok(int(raw))


def add_both(a: str, b: str) -> Result[int, str]:
    return Ok(parse_int(a)? + parse_int(b)?)


def main() -> None:
    print(add_both("1", "2"))


main()
