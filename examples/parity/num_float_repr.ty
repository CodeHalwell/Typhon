def main() -> None:
    let xs: list[float] = [0.1, 0.1 + 0.2, 1e16, 1e-5, 1e-4, 1.0, -0.0, 1e300 * 1e10]
    for x in xs:
        print(repr(x), str(x))
    print(1 / 3)
    print(float("inf"), float("-inf"))
    print(0.1 + 0.2 == 0.3)
    print(-7.0 // 2.0, -7.0 % 2.0, 7.0 % -2.0)
    print(round(2.675, 2))
    print(f"{3.14159:.3f} {2.5:.0f} {1234.5678:,.2f} {0.000012345:.3e}")
main()
