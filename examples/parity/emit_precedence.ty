def inc(x: int) -> int:
    return x + 1


def dbl(x: int) -> int:
    return x * 2


def half(x: float) -> float:
    return x / 2.0


def main() -> None:
    let a: int = 3
    print(a + 1 |> dbl())
    print((a |> dbl()) + 1)
    print(a |> inc() |> dbl())
    print(1 + 2 * 3 ** 2 - 4 // 2 % 3)
    print(not True or False and True)
    print(1 < 2 < 3, 3 > 2 > 1, 1 == 1 != 2)
    print((a if a > 0 else -a) * 2)
    print([x for x in range(5) if x % 2 == 0][::-1])
    print(-2 ** 2, (-2) ** 2)
    print(True + True, True * 3, int(True))
    print("a" * 3 + "b" * 2)
    print((1, 2) < (1, 3), [1, 2] < [1, 3], "ab" < "b")
    let s: str = "x" if a else "y"
    print(s, f"{a=}", f"{a:>5}", f"{a!r}")
main()
