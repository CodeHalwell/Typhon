def main() -> None:
    let pairs: list[tuple[int, int]] = [(7, 3), (-7, 3), (7, -3), (-7, -3)]
    for p in pairs:
        let a: int = p[0]
        let b: int = p[1]
        print(a, b, a // b, a % b, divmod(a, b))
    print(2 ** 100)
    print((-2) ** 63)
    print(10 ** 20 // 7, 10 ** 20 % 7)
    print(-1 >> 1, -8 >> 2, -1 << 3)
    print(~5, ~-5)
    print(abs(-2 ** 70))
    print(int(-7 / 2), round(-7 / 2), round(-2.5), round(2.5), round(0.5))
main()
