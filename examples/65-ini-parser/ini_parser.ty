class ParseError:
    line: int
    msg: str


type Ini = dict[str, dict[str, str]]


def parse_ini(text: str) -> Result[Ini, ParseError]:
    mut sections: Ini = {}
    mut current: str = ""
    sections[current] = {}

    mut lineno: int = 0
    for raw in text.splitlines():
        lineno = lineno + 1
        let line: str = raw.strip()
        if line == "" or line.startswith("#") or line.startswith(";"):
            continue
        if line.startswith("[") and line.endswith("]"):
            current = line[1:-1].strip()
            if current == "":
                return Err(ParseError(line=lineno, msg="empty section name"))
            if current not in sections:
                sections[current] = {}
            continue
        let eq: int = line.find("=")
        if eq == -1:
            return Err(ParseError(line=lineno, msg=f"missing '=' in: {line}"))
        let key: str = line[:eq].strip()
        let value: str = line[eq + 1:].strip()
        if key == "":
            return Err(ParseError(line=lineno, msg="empty key"))
        sections[current][key] = value
    return Ok(sections)


def render(ini: Ini) -> str:
    mut parts: list[str] = []
    for section, kv in ini.items():
        if section != "":
            parts.append(f"[{section}]")
        for k, v in kv.items():
            parts.append(f"{k} = {v}")
        parts.append("")
    return "\n".join(parts).rstrip()


def main() -> None:
    let source: str = (
        "# global settings\n"
        "name = my-app\n"
        "\n"
        "[server]\n"
        "host = 0.0.0.0\n"
        "port = 8080\n"
        "\n"
        "; database config\n"
        "[database]\n"
        "url = postgres://localhost/db\n"
        "pool_size = 10\n"
    )
    match parse_ini(source):
        case Ok(ini):
            print("parsed sections:", list(ini.keys()))
            print()
            print(render(ini))
        case Err(e):
            print(f"line {e.line}: {e.msg}")


if __name__ == "__main__":
    main()
