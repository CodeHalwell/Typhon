extend str:
    def slug(self) -> str:
        return self.lower().strip().replace(" ", "-")

    def truncate(self, n: int, ellipsis: str = "...") -> str:
        if len(self) <= n:
            return self
        return self[:n - len(ellipsis)] + ellipsis


def word_count(text: str) -> dict[str, int]:
    mut counts: dict[str, int] = {}
    for w in text.lower().split():
        let cleaned: str = w.strip(".,!?;:()[]\"'")
        if len(cleaned) == 0:
            continue
        counts[cleaned] = counts.get(cleaned, 0) + 1
    return counts


def is_palindrome(s: str) -> bool:
    let cleaned: str = "".join(c for c in s.lower() if c.isalnum())
    return cleaned == cleaned[::-1]


def kv_parse(line: str) -> dict[str, str]:
    mut result: dict[str, str] = {}
    for part in line.split(","):
        let chunk: str = part.strip()
        if "=" not in chunk:
            continue
        let pair: list[str] = chunk.split("=", 1)
        result[pair[0].strip()] = pair[1].strip()
    return result


def render_table(headers: list[str], rows: list[list[str]]) -> str:
    let widths: list[int] = [
        max(len(headers[i]), max(len(r[i]) for r in rows))
        for i in range(len(headers))
    ]
    let header: str = " | ".join(headers[i].ljust(widths[i]) for i in range(len(headers)))
    let sep: str = "-+-".join("-" * w for w in widths)
    let body: list[str] = [
        " | ".join(row[i].ljust(widths[i]) for i in range(len(row)))
        for row in rows
    ]
    return "\n".join([header, sep] + body)


def main() -> None:
    let title: str = "  Hello, Beautiful World  "
    print(title.slug())
    print(title.truncate(15))

    print(word_count("the cat sat on the mat, and the cat purred."))
    print(is_palindrome("A man, a plan, a canal: Panama"))
    print(kv_parse("name=Ada, role=engineer, team=core"))

    print(render_table(
        ["name", "score"],
        [["Ada", "92"], ["Grace", "88"], ["Linus", "75"]],
    ))


if __name__ == "__main__":
    main()
