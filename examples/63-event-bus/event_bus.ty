from typing import Callable


type Event = UserSignedUp | OrderPlaced | OrderShipped


class UserSignedUp:
    user_id: int
    email: str


class OrderPlaced:
    order_id: int
    user_id: int
    total: float


class OrderShipped:
    order_id: int
    tracking: str


class Bus:
    listeners: list[Callable[[Event], None]] = []


impl Bus:
    def subscribe(self, fn: Callable[[Event], None]) -> None:
        self.listeners.append(fn)

    def publish(self, e: Event) -> None:
        for fn in self.listeners:
            fn(e)


def log_event(e: Event) -> None:
    match e:
        case UserSignedUp(user_id, email):
            print(f"[log] new user {user_id} <{email}>")
        case OrderPlaced(order_id, user_id, total):
            print(f"[log] order {order_id} from #{user_id}: ${total:.2f}")
        case OrderShipped(order_id, tracking):
            print(f"[log] order {order_id} shipped, tracking={tracking}")


def revenue_tracker(state: dict[str, float]) -> Callable[[Event], None]:
    def handle(e: Event) -> None:
        match e:
            case OrderPlaced(_, _, total):
                state["total"] = state.get("total", 0.0) + total
            case _:
                pass
    return handle


def main() -> None:
    let bus: Bus = Bus()
    let revenue: dict[str, float] = {}
    bus.subscribe(log_event)
    bus.subscribe(revenue_tracker(revenue))

    let events: list[Event] = [
        UserSignedUp(user_id=1, email="ada@example.com"),
        OrderPlaced(order_id=100, user_id=1, total=29.99),
        OrderPlaced(order_id=101, user_id=1, total=10.00),
        OrderShipped(order_id=100, tracking="ABCD1234"),
    ]
    for e in events:
        bus.publish(e)
    print(f"total revenue: ${revenue.get('total', 0.0):.2f}")


if __name__ == "__main__":
    main()
