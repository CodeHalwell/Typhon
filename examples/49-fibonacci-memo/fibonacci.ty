@memo
def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)


@memo
def lucas(n: int) -> int:
    if n == 0:
        return 2
    if n == 1:
        return 1
    return lucas(n - 1) + lucas(n - 2)


@pure
def golden_ratio_approx(n: int) -> float:
    if n < 2:
        return 1.0
    return float(fib(n + 1)) / float(fib(n))


def main() -> None:
    print("fib(0..10):", [fib(i) for i in range(11)])
    print("lucas(0..10):", [lucas(i) for i in range(11)])
    print(f"phi ~= {golden_ratio_approx(30):.10f}")
    print(f"fib(50) = {fib(50)}")


if __name__ == "__main__":
    main()
